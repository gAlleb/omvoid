do_install() {
	# Only the Kvantum part. The rest of this repository is Plasma decorations,
	# colour schemes and latte-dock layouts -- none of which omvoid runs, and
	# upstream's installer would scatter them across a KDE that is not there.
	vmkdir usr/share/Kvantum
	vcopy "Kvantum/WhiteSur" usr/share/Kvantum
	vcopy "Kvantum/WhiteSur-opaque" usr/share/Kvantum
	vlicense LICENSE
}

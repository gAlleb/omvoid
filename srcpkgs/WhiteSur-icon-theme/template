wrksrc="WhiteSur-icon-theme-${_tag#v}"

do_install() {
	vmkdir usr/share/icons
	# The colour variants omvoid's themes name in their icons.theme files.
	local t
	for t in default grey purple red orange; do
		TERM=linux ./install.sh -d "${DESTDIR}/usr/share/icons" -t "$t"
	done
	vlicense COPYING
}

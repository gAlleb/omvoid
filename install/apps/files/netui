]


def state_label(state):
    return STATE_LABELS.get(state, state or "unknown")


class App:
    def __init__(self, stdscr):
        self.stdscr = stdscr
        self.worker = Worker()
        self.snap = None
        self.loading = True
        self.tab = T_WIFI
        self.sel = [0] * len(TABS)
        self.scroll = [0] * len(TABS)
        self.log = []
        self.status = ""
        self.status_attr = 0
        self.pending = set()
        self.detail_cache = {}
        self.last_refresh = 0.0
        self.frame = 0

        curses.curs_set(0)
        init_colors()
        stdscr.keypad(True)
        stdscr.timeout(120)
        # Without this, Esc takes about a second to register: curses waits
        # to see whether more bytes follow (the start of an escape sequence).
        try:
            curses.set_escdelay(25)
        except (AttributeError, curses.error):
            pass

        self.request_refresh(rescan=True, note="Querying NetworkManager…")

    # -- log / status ---------------------------------------------------

    def notify(self, text, level=C_ACCENT):
        self.status = text
        self.status_attr = cp(level)
        self.log.append((time.strftime("%H:%M:%S"), text))
        self.log = self.log[-200:]

    # -- data -------------------------------------------------------------

    def request_refresh(self, rescan=False, note=""):
        if "snap" in self.pending:
            return
        self.pending.add("snap")
        if note:
            self.notify(note)
        self.last_refresh = time.time()
        self.worker.submit("snap", snapshot, rescan)

    def do_action(self, tag, fn, *args, note="", success="Done", **kwargs):
        if note:
            self.notify(note)
        self.pending.add(tag)
        self.worker.submit(("action", tag, success), fn, *args, **kwargs)

    def handle_results(self):
        for tag, value, error in self.worker.poll():
            if tag == "snap":
                self.pending.discard("snap")
                self.loading = False
                if error:
                    self.notify(f"Refresh failed: {error}", C_ERR)
                else:
                    self.snap = value
                    self.clamp()
                    if self.status.endswith("…"):
                        self.status = ""
            elif isinstance(tag, tuple) and tag[0] == "action":
                _, name, success = tag
                self.pending.discard(name)
                if error:
                    self.notify(f"Failed: {error}", C_ERR)
                else:
                    rc, out, err = value
                    if rc == 0:
                        self.notify(success, C_OK)
                    else:
                        self.notify(err_line(rc, err, out), C_ERR)
                self.request_refresh()
            elif isinstance(tag, tuple) and tag[0] == "detail":
                key = tag[1]
                self.pending.discard(f"detail:{key}")
                if not error:
                    self.detail_cache[key] = value

    # -- tab contents ---------------------------------------------------

    def items(self, tab=None):
        tab = self.tab if tab is None else tab
        s = self.snap
        if not s:
            return []
        if tab == T_WIFI:
            return s["wifi"]
        if tab == T_ETH:
            return [d for d in s["devices"] if d["type"] == "ethernet"]
        if tab == T_VPN:
            saved = [c for c in s["saved"] if c["type"] in VPN_TYPES]
            return sorted(saved, key=lambda c: (not c["active"], c["name"].lower()))
        if tab == T_MOB:
            rows = list(s["modems"])
            rows += [c for c in s["saved"] if c["type"] in MOBILE_TYPES]
            return rows
        if tab == T_ADAPT:
            return [d for d in s["devices"] if d["type"] not in SKIP_DEVICE_TYPES]
        if tab == T_PROF:
            return sorted(s["saved"], key=lambda c: (not c["active"], c["type"], c["name"].lower()))
        return []

    def current(self):
        lst = self.items()
        if not lst:
            return None
        i = min(self.sel[self.tab], len(lst) - 1)
        return lst[i]

    def clamp(self):
        for t in range(len(TABS)):
            n = len(self.items(t))
            self.sel[t] = max(0, min(self.sel[t], max(0, n - 1)))

    def saved_wifi_profile(self, ssid, in_use=False):
        """Find the saved profile for a network.

        Usually the profile is named after the SSID, but the user may have
        renamed it. For the currently active network, fall back to the
        connection name reported by the device itself — otherwise a renamed
        active profile would incorrectly show up as "not saved"."""
        if not self.snap:
            return None
        exact = next((c for c in self.snap["saved"]
                      if c["name"] == ssid and c["type"] in WIFI_TYPES), None)
        if exact:
            return exact
        if in_use and self.snap["wifi_dev"]:
            active = next((d["connection"] for d in self.snap["devices"]
                           if d["device"] == self.snap["wifi_dev"]), "")
            if active:
                return next((c for c in self.snap["saved"]
                             if c["name"] == active and c["type"] in WIFI_TYPES), None)
        return None

    # -- drawing ------------------------------------------------------------

    def draw(self):
        stdscr = self.stdscr
        stdscr.erase()
        h, w = stdscr.getmaxyx()
        if h < 12 or w < 54:
            put(stdscr, 0, 0, "Enlarge the terminal window (min 54x12)", cp(C_WARN))
            stdscr.refresh()
            return

        self.draw_header(w)
        list_w = max(30, int(w * 0.52))
        body_h = h - 4
        left = stdscr.derwin(body_h, list_w, 2, 0)
        right = stdscr.derwin(body_h, w - list_w, 2, list_w)
        self.draw_list(left, body_h, list_w)
        self.draw_details(right, body_h, w - list_w)
        self.draw_footer(h, w)
        stdscr.refresh()

    def draw_header(self, w):
        x = 0
        for i, name in enumerate(TABS):
            label = f" {i + 1} {name} "
            attr = cp(C_SEL) | curses.A_BOLD if i == self.tab else cp(C_ACCENT)
            put(self.stdscr, 0, x, label, attr)
            x += len(label)
        s = self.snap
        right = []
        if s:
            if s["wifi_dev"] and s["radio"]["wifi"] is not None:
                right.append(f"Wi-Fi {'on' if s['radio']['wifi'] else 'off'}")
            # Only show WWAN status if there is actual WWAN/mobile hardware:
            # nmcli reports a software WWAN radio state even on machines
            # with no modem at all, which reads as "there's a modem" when
            # there isn't one.
            if s["has_wwan_hw"] and s["radio"]["wwan"] is not None:
                right.append(f"WWAN {'on' if s['radio']['wwan'] else 'off'}")
            act = [c["name"] for c in s["saved"] if c["active"]]
            if act:
                right.append(f"active: {len(act)}")
        tail = "  ".join(right)
        if self.worker.is_busy:
            tail = SPINNER[self.frame % len(SPINNER)] + " " + tail
        put(self.stdscr, 0, max(x + 1, w - len(tail) - 1), elide(tail, w - x - 2), cp(C_DIM))
        put(self.stdscr, 1, 0, "─" * w, cp(C_DIM))

    def draw_list(self, win, h, w):
        title = TABS[self.tab]
        draw_frame(win, title, cp(C_ACCENT))
        inner_h = h - 2
        lst = self.items()

        if self.loading:
            put(win, 1, 2, SPINNER[self.frame % len(SPINNER)] + " Loading…", cp(C_DIM))
            return
        if not lst:
            for i, line in enumerate(wrap(self.empty_text(), w - 4)):
                put(win, 1 + i, 2, line, cp(C_DIM))
            return

        sel = min(self.sel[self.tab], len(lst) - 1)
        top = self.scroll[self.tab]
        if sel < top:
            top = sel
        elif sel >= top + inner_h:
            top = sel - inner_h + 1
        top = max(0, min(top, max(0, len(lst) - inner_h)))
        self.scroll[self.tab] = top

        for row in range(min(inner_h, len(lst) - top)):
            idx = top + row
            item = lst[idx]
            focused = idx == sel
            self.draw_row(win, 1 + row, w - 2, item, focused)

        if len(lst) > inner_h:
            put(win, h - 1, w - 12, f" {sel + 1}/{len(lst)} ", cp(C_DIM))

    def draw_row(self, win, y, w, item, focused):
        base = cp(C_SEL) if focused else 0
        marker = "›" if focused else " "
        if self.tab == T_WIFI:
            bars = signal_bars(item["signal"])
            sig = f"{item['signal']:>3}%" if item["signal"] >= 0 else "  --"
            saved = "★" if self.saved_wifi_profile(item["ssid"], item["in_use"]) else " "
            lock = "🔒" if item["security"] != "open" else "  "
            active = "●" if item["in_use"] else " "
            name = elide(item["ssid"], max(6, w - 26))
            text = f"{marker}{active}{saved} {bars} {sig} {lock} {name}"
            put(win, y, 1, text.ljust(w), base if focused else 0)
            if not focused:
                put(win, y, 5, bars, sig_attr(item["signal"]))
                if item["in_use"]:
                    put(win, y, 2, "●", cp(C_OK))
            return
        if self.tab in (T_ETH, T_ADAPT):
            up = item["state"] == "connected"
            state = state_label(item["state"])
            if self.tab == T_ADAPT:
                text = (f"{marker}{'●' if up else '○'} {item['device']:<10} "
                        f"{item['type']:<9} {state:<13} "
                        f"{elide(item['connection'] or '-', max(4, w - 40))}")
            else:
                text = (f"{marker}{'●' if up else '○'} {item['device']:<10} {state:<14} "
                        f"{elide(item['connection'] or '-', max(4, w - 32))}")
            put(win, y, 1, text.ljust(w), base if focused else 0)
            if not focused and up:
                put(win, y, 2, "●", cp(C_OK))
            return
        if self.tab == T_VPN:
            on = item["active"]
            kind = "wireguard" if item["type"] == "wireguard" else "vpn"
            text = f"{marker}{'●' if on else '○'} {elide(item['name'], max(6, w - 26)):<{max(6, w - 26)}} {kind:<10}"
            put(win, y, 1, text.ljust(w), base if focused else 0)
            if not focused and on:
                put(win, y, 2, "●", cp(C_OK))
            return
        if self.tab == T_MOB:
            if "device" in item and "uuid" not in item:
                sig = item.get("signal", "")
                op = item.get("operator", "")
                extra = f"{op} {sig + '%' if sig else ''}".strip()
                text = f"{marker}▣ {item['device']:<12} {item.get('state', ''):<14} {elide(extra, max(4, w - 34))}"
            else:
                on = item.get("active")
                text = f"{marker}{'●' if on else '○'} {elide(item['name'], max(6, w - 24)):<{max(6, w - 24)}} {item['type']:<8}"
            put(win, y, 1, text.ljust(w), base if focused else 0)
            return
        # profiles
        on = item["active"]
        auto = "A" if item["autoconnect"] else " "
        text = f"{marker}{'●' if on else '○'}{auto} {elide(item['name'], max(6, w - 26)):<{max(6, w - 26)}} {elide(item['type'], 12)}"
        put(win, y, 1, text.ljust(w), base if focused else 0)
        if not focused and on:
            put(win, y, 2, "●", cp(C_OK))

    def empty_text(self):
        s = self.snap
        if self.tab == T_WIFI:
            if not s or not s["wifi_dev"]:
                return "No Wi-Fi adapter detected. Check the Adapters tab, or the driver."
            if s["radio"]["wifi"] is False:
                return "Wi-Fi radio is off. Press w to turn it on."
            return "No networks found. Press s to rescan."
        if self.tab == T_ETH:
            return "No wired interfaces found. Check the Adapters tab."
        if self.tab == T_VPN:
            return "No VPN configured. Press a to add PPTP, L2TP, OpenVPN, WireGuard, and more."
        if self.tab == T_MOB:
            return ("No modem found. Press a to create a mobile data profile "
                    "or a PPPoE connection over Ethernet.")
        if self.tab == T_ADAPT:
            return "No network devices found."
        return "No saved profiles. Press a to create one."

    def draw_details(self, win, h, w):
        draw_frame(win, "Details", cp(C_ACCENT))
        item = self.current()
        if self.loading:
            put(win, 1, 2, "…", cp(C_DIM))
            return
        if item is None:
            put(win, 1, 2, "Select an item on the left", cp(C_DIM))
            return
        rows = self.detail_rows(item)
        maxw = w - 4
        y = 1
        for label, value, attr in rows:
            if y >= h - 1:
                break
            if label is None:
                put(win, y, 2, elide(str(value), maxw), attr)
                y += 1
                continue
            put(win, y, 2, f"{label}:", cp(C_DIM))
            put(win, y, 2 + 14, elide(str(value), max(0, maxw - 14)), attr)
            y += 1

    def detail_rows(self, item):
        s = self.snap
        rows = []
        if self.tab == T_WIFI:
            saved = self.saved_wifi_profile(item["ssid"], item["in_use"])
            rows += [
                ("Network", item["ssid"], curses.A_BOLD),
                ("State", "connected" if item["in_use"] else "not connected",
                 cp(C_OK) if item["in_use"] else 0),
                ("Signal", f"{item['signal']}%  {signal_bars(item['signal'])}"
                 if item["signal"] >= 0 else "unknown", sig_attr(item["signal"])),
                ("Security", item["security"], 0),
                ("BSSID", item["bssid"] or "-", 0),
                ("Channel", f"{item['chan']}  ({item['freq']})", 0),
                ("Rate", item["rate"] or "-", 0),
                ("Mode", item["mode"] or "-", 0),
                ("Profile", saved["name"] if saved else "not saved",
                 cp(C_OK) if saved else cp(C_DIM)),
            ]
            if item["in_use"] and s["wifi_dev"]:
                rows.append((None, "", 0))
                rows += self.ip_rows(s["dev_details"].get(s["wifi_dev"], {}))
            return rows

        if self.tab in (T_ETH, T_ADAPT):
            rows += [
                ("Device", item["device"], curses.A_BOLD),
                ("Type", item["type"], 0),
                ("State", state_label(item["state"]),
                 cp(C_OK) if item["state"] == "connected" else cp(C_DIM)),
                ("Profile", item["connection"] or "-", 0),
            ]
            det = self.want_dev_detail(item["device"])
            if det is None:
                rows.append((None, "loading device info…", cp(C_DIM)))
                return rows
            if det.get("GENERAL.DRIVER"):
                rows.append(("Driver", det["GENERAL.DRIVER"], 0))
            if det.get("GENERAL.HWADDR"):
                rows.append(("MAC", det["GENERAL.HWADDR"], 0))
            if det.get("GENERAL.MTU"):
                rows.append(("MTU", det["GENERAL.MTU"], 0))
            if det.get("CAPABILITIES.SPEED") not in (None, "", "--", "unknown"):
                rows.append(("Speed", det["CAPABILITIES.SPEED"], 0))
            if item["state"] == "connected":
                rows.append((None, "", 0))
                rows += self.ip_rows(det)
            return rows

        if self.tab in (T_VPN, T_PROF) or (self.tab == T_MOB and "uuid" in item):
            rows += [
                ("Profile", item["name"], curses.A_BOLD),
                ("Type", item["type"], 0),
                ("State", "active" if item["active"] else "inactive",
                 cp(C_OK) if item["active"] else cp(C_DIM)),
                ("Autoconnect", "yes" if item["autoconnect"] else "no", 0),
                ("Device", item["device"] or "-", 0),
                ("UUID", item["uuid"], cp(C_DIM)),
            ]
            det = self.want_con_detail(item["uuid"])
            if det is None:
                rows.append((None, "loading properties…", cp(C_DIM)))
                return rows
            rows.append((None, "", 0))
            for key, label in (("vpn.data", "VPN data"), ("connection.interface-name", "Interface"),
                               ("ipv4.method", "IPv4"), ("ipv4.addresses", "IPv4 address"),
                               ("ipv4.gateway", "IPv4 gateway"), ("ipv4.dns", "DNS"),
                               ("ipv6.method", "IPv6"), ("gsm.apn", "APN"),
                               ("gsm.username", "Username"), ("pppoe.username", "PPPoE user")):
                val = det.get(key)
                if val and val not in ("--", ""):
                    rows.append((label, val, 0))
            if item["active"] and item["device"]:
                live = s["dev_details"].get(item["device"], {})
                if live:
                    rows.append((None, "", 0))
                    rows += self.ip_rows(live)
            rows.append((None, "", 0))
            rows.append((None, "Press A for advanced settings (MTU, routes, metered, ...)", cp(C_DIM)))
            return rows

        # physical modem row (no saved profile)
        rows += [
            ("Device", item.get("device", "-"), curses.A_BOLD),
            ("Type", item.get("type", "-"), 0),
            ("State", item.get("state", "-"), 0),
            ("Profile", item.get("connection") or "-", 0),
        ]
        if item.get("operator"):
            rows.append(("Operator", item["operator"], 0))
        if item.get("signal"):
            rows.append(("Signal", item["signal"] + "%", 0))
        if not MMCLI:
            rows.append((None, "ModemManager (mmcli) not found — info limited", cp(C_DIM)))
        return rows

    def ip_rows(self, det):
        rows = []
        v4 = [v for k, v in sorted(det.items()) if k.startswith("IP4.ADDRESS")]
        v6 = [v for k, v in sorted(det.items()) if k.startswith("IP6.ADDRESS")]
        dns = [v for k, v in sorted(det.items()) if k.startswith("IP4.DNS")]
        if v4:
            rows.append(("IPv4", ", ".join(v4), 0))
        if det.get("IP4.GATEWAY", "--") not in ("--", ""):
            rows.append(("Gateway", det["IP4.GATEWAY"], 0))
        if dns:
            rows.append(("DNS", ", ".join(dns), 0))
        if v6:
            rows.append(("IPv6", v6[0], 0))
        return rows

    def want_con_detail(self, uuid):
        key = f"con:{uuid}"
        if key in self.detail_cache:
            return self.detail_cache[key]
        if key not in self.pending:
            self.pending.add(key)
            self.worker.submit(("detail", key), q_con_details, uuid)
        return None

    def want_dev_detail(self, dev):
        key = f"dev:{dev}"
        if key in self.detail_cache:
            return self.detail_cache[key]
        if key not in self.pending:
            self.pending.add(key)
            self.worker.submit(("detail", key), q_dev_details, dev)
        return None


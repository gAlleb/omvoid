# ---------------------------------------------------------------------------
# nmcli: execution and terse-output parsing
# ---------------------------------------------------------------------------

def run(args, timeout=15, input_text=None):
    """Run a command, return (returncode, stdout, stderr). Never raises."""
    try:
        p = subprocess.run(args, capture_output=True, text=True,
                           timeout=timeout, input=input_text)
        return p.returncode, p.stdout, p.stderr
    except subprocess.TimeoutExpired:
        return 124, "", "nmcli timed out"
    except FileNotFoundError:
        return 127, "", "command not found"
    except Exception as e:  # pragma: no cover - defensive
        return 1, "", str(e)


def nm(*args, timeout=15):
    return run([NMCLI, *args], timeout=timeout)


def nmt(*args, timeout=15):
    return run([NMCLI, "-t", *args], timeout=timeout)


def split_terse(line, maxsplit=-1):
    """Split one line of `nmcli -t` output on *unescaped* ':' and unescape
    '\\:' and '\\\\'. nmcli escapes literal colons inside field values (SSIDs,
    BSSIDs, connection names, IPv6 addresses), so a naive line.split(':')
    corrupts any value containing a colon."""
    fields, cur = [], []
    i, n = 0, len(line)
    while i < n:
        c = line[i]
        if c == "\\" and i + 1 < n and line[i + 1] in (":", "\\"):
            cur.append(line[i + 1])
            i += 2
            continue
        if c == ":" and (maxsplit < 0 or len(fields) < maxsplit):
            fields.append("".join(cur))
            cur = []
            i += 1
            continue
        cur.append(c)
        i += 1
    fields.append("".join(cur))
    return fields


def parse_terse(output):
    return [split_terse(l) for l in output.splitlines() if l != ""]


def pad(fields, n):
    f = list(fields)
    return f + [""] * (n - len(f)) if len(f) < n else f


def esc_value(v):
    """Escape a value for key=value pairs inside vpn.data / vpn.secrets."""
    return str(v).replace(",", r"\,").replace("=", r"\=")


# ---------------------------------------------------------------------------
# State queries
# ---------------------------------------------------------------------------

def q_devices():
    rc, out, _ = nmt("-f", "DEVICE,TYPE,STATE,CONNECTION", "device", "status")
    if rc != 0:
        return []
    res = []
    for f in parse_terse(out):
        d, t, s, c = pad(f, 4)[:4]
        res.append({"device": d, "type": t, "state": s, "connection": c})
    return res


def q_wifi_device():
    for d in q_devices():
        if d["type"] == "wifi":
            return d["device"]
    return None


def q_radio():
    rc, out, _ = nmt("-f", "WIFI,WWAN", "radio")
    if rc != 0 or not out.strip():
        return {"wifi": None, "wwan": None}
    f = pad(split_terse(out.strip().splitlines()[0]), 2)
    return {"wifi": f[0] == "enabled", "wwan": f[1] == "enabled"}


def q_wifi(dev, rescan=False):
    if not dev:
        return []
    args = ["-f", "IN-USE,SSID,BSSID,MODE,CHAN,FREQ,RATE,SIGNAL,SECURITY",
            "device", "wifi", "list", "ifname", dev,
            "--rescan", "yes" if rescan else "no"]
    rc, out, _ = nmt(*args, timeout=25 if rescan else 10)
    if rc != 0:
        return []
    nets = {}
    for f in parse_terse(out):
        in_use, ssid, bssid, mode, chan, freq, rate, sig, sec = pad(f, 9)[:9]
        if not ssid:
            continue
        item = {
            "in_use": in_use.strip() == "*",
            "ssid": ssid, "bssid": bssid, "mode": mode, "chan": chan,
            "freq": freq, "rate": rate,
            "signal": int(sig) if sig.isdigit() else -1,
            "security": (sec.strip() if sec.strip() not in ("", "--") else "open"),
        }
        prev = nets.get(ssid)
        if prev is None or item["in_use"] or item["signal"] > prev["signal"]:
            nets[ssid] = item
    return sorted(nets.values(), key=lambda x: (not x["in_use"], -x["signal"], x["ssid"].lower()))


def q_saved():
    rc, out, _ = nmt("-f", "NAME,UUID,TYPE,DEVICE,AUTOCONNECT,ACTIVE",
                     "connection", "show")
    if rc != 0:
        return []
    res = []
    for f in parse_terse(out):
        name, uuid, typ, dev, auto, active = pad(f, 6)[:6]
        res.append({"name": name, "uuid": uuid, "type": typ, "device": dev,
                    "autoconnect": auto == "yes", "active": active == "yes"})
    return res


def q_dev_details(dev):
    rc, out, _ = nmt("device", "show", dev, timeout=10)
    if rc != 0:
        return {}
    d = {}
    for line in out.splitlines():
        if not line:
            continue
        parts = split_terse(line, maxsplit=1)
        if len(parts) == 2:
            d[parts[0]] = parts[1]
    return d


def q_con_details(uuid):
    rc, out, _ = nmt("connection", "show", uuid, timeout=10)
    if rc != 0:
        return {}
    d = {}
    for line in out.splitlines():
        if not line:
            continue
        parts = split_terse(line, maxsplit=1)
        if len(parts) == 2:
            d[parts[0]] = parts[1]
    return d


def q_vpn_plugins():
    """Which VPN plugins are actually installed (via *.name files)."""
    found = set()
    pats = ["/usr/lib/NetworkManager/VPN/*.name",
            "/usr/lib64/NetworkManager/VPN/*.name",
            "/usr/lib/*/NetworkManager/VPN/*.name",
            "/etc/NetworkManager/VPN/*.name",
            "/run/current-system/sw/lib/NetworkManager/VPN/*.name"]
    for pat in pats:
        for path in glob.glob(pat):
            try:
                with open(path, "r", errors="replace") as fh:
                    text = fh.read()
            except OSError:
                continue
            m = re.search(r"^service\s*=\s*org\.freedesktop\.NetworkManager\.(\S+)",
                          text, re.M)
            if m:
                found.add(m.group(1).strip().lower())
            else:
                found.add(os.path.basename(path)[:-5].lower())
    return found


def q_modems():
    """Modems: from nmcli device, enriched with mmcli info if available."""
    modems = [d for d in q_devices() if d["type"] in ("gsm", "cdma", "modem")]
    if not MMCLI:
        return modems
    rc, out, _ = run([MMCLI, "-L"], timeout=6)
    if rc != 0:
        return modems
    paths = re.findall(r"(/org/freedesktop/ModemManager1/Modem/\d+)", out)
    info = []
    for p in paths:
        rc2, o2, _ = run([MMCLI, "-m", p], timeout=6)
        if rc2 != 0:
            continue
        op = re.search(r"operator name:\s*(.+)", o2)
        sq = re.search(r"signal quality:\s*(\d+)", o2)
        st = re.search(r"\bstate:\s*(\S+)", o2)
        info.append({"path": p,
                     "operator": op.group(1).strip() if op else "",
                     "signal": sq.group(1) if sq else "",
                     "mm_state": st.group(1) if st else ""})
    for i, m in enumerate(modems):
        if i < len(info):
            m.update(info[i])
    if not modems and info:
        for i in info:
            modems.append({"device": "(ModemManager)", "type": "gsm",
                           "state": i.get("mm_state", ""), "connection": "", **i})
    return modems


def snapshot(rescan=False):
    devs = q_devices()
    radio = q_radio()
    wdev = next((d["device"] for d in devs if d["type"] == "wifi"), None)
    nets = q_wifi(wdev, rescan=rescan) if (wdev and radio["wifi"]) else []
    saved = q_saved()
    details = {}
    for d in devs:
        if d["state"] == "connected":
            details[d["device"]] = q_dev_details(d["device"])
    has_wwan_hw = any(d["type"] in WWAN_DEVICE_TYPES for d in devs)
    return {
        "ts": time.time(), "devices": devs, "radio": radio, "wifi_dev": wdev,
        "wifi": nets, "saved": saved, "dev_details": details,
        "plugins": q_vpn_plugins(), "modems": q_modems(),
        "has_wwan_hw": has_wwan_hw,
    }



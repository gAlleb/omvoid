    def resolve_profile_item(self):
        """Return the current item as a saved profile (dict with 'uuid'), or
        None (after notifying the user) if none can be resolved.

        Wi-Fi/VPN/Profiles/saved-Mobile rows already carry a profile. For
        device-shaped rows (Ethernet, Adapters, a physical modem with no
        profile yet) we look for a saved connection bound to that device —
        preferring the one currently active on it — and, if several match,
        let the user pick which one to edit."""
        item = self.current()
        if item is None:
            return None
        if self.tab == T_WIFI:
            saved = self.saved_wifi_profile(item["ssid"], item["in_use"])
            if not saved:
                self.notify("Network is not saved — connect first", C_WARN)
                return None
            return saved
        if "uuid" in item:
            return item
        # Device-shaped item (Ethernet / Adapters / a physical modem row):
        # resolve to a saved profile bound to it.
        dev = item.get("device", "")
        dev_type = item.get("type", "")
        con_name = item.get("connection", "")
        if con_name:
            match = next((c for c in self.snap["saved"] if c["name"] == con_name), None)
            if match:
                return match
        # nmcli only fills in DEVICE for a connection that's currently
        # active, so an inactive profile for this device won't match on
        # device name alone — fall back to matching by connection type.
        type_map = {"ethernet": ETH_TYPES, "wifi": WIFI_TYPES,
                    "gsm": ("gsm",), "cdma": ("cdma",)}
        expected_types = type_map.get(dev_type, ())
        candidates = [c for c in self.snap["saved"]
                      if (dev and c["device"] == dev)
                      or (not c["device"] and c["type"] in expected_types)]
        if not candidates:
            self.notify(f"No saved profile for {dev or 'this device'} — create one with a", C_WARN)
            return None
        if len(candidates) == 1:
            return candidates[0]
        choice = select_box(self.stdscr, f"Choose a profile for {dev}",
                            [(c["uuid"], c["name"], True, c["type"]) for c in candidates])
        if not choice:
            return None
        return next(c for c in candidates if c["uuid"] == choice)


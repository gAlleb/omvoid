class DialSession:
    """Supervises one wvdial process. wvdial keeps running until it is told
    to hang up, so it can't go through the normal request/response worker."""

    def __init__(self):
        self.proc = None
        self.section = ""
        self.state = "idle"          # idle / dialing / connected / failed
        self.ip = ""
        self.lines = []
        self.lock = threading.Lock()

    def active(self):
        return self.proc is not None and self.proc.poll() is None

    def status(self):
        with self.lock:
            return self.state, self.section, self.ip

    def tail(self, count=200):
        with self.lock:
            return list(self.lines[-count:])

    def start(self, section, config=""):
        if self.active():
            return False, f"already dialing “{self.section}”"
        if not WVDIAL:
            return False, "wvdial is not installed"
        cmd = [WVDIAL]
        if config:
            cmd += ["--config", config]
        cmd.append(section)
        try:
            proc = subprocess.Popen(cmd, stdout=subprocess.PIPE,
                                    stderr=subprocess.STDOUT, text=True,
                                    bufsize=1, start_new_session=True)
        except OSError as e:
            return False, str(e)
        with self.lock:
            self.proc, self.section = proc, section
            self.state, self.ip, self.lines = "dialing", "", []
        threading.Thread(target=self._read, args=(proc,), daemon=True).start()
        return True, ""

    def _read(self, proc):
        try:
            for raw in proc.stdout:
                line = raw.rstrip()
                with self.lock:
                    self.lines.append(line)
                    self.lines = self.lines[-400:]
                    low = line.lower()
                    if "local  ip address" in low or "local ip address" in low:
                        self.state = "connected"
                        self.ip = line.split()[-1]
                    elif "connected" in low and self.state == "dialing":
                        self.state = "connected"
                    elif ("no carrier" in low or "no dialtone" in low
                          or "cannot open" in low or "failed" in low):
                        self.state = "failed"
        except Exception:
            pass
        finally:
            proc.wait()
            with self.lock:
                if self.state != "failed":
                    self.state = "idle"
                self.ip = ""

    def stop(self):
        proc = self.proc
        if proc is None or proc.poll() is not None:
            with self.lock:
                self.state = "idle"
            return True, ""
        try:
            os.killpg(os.getpgid(proc.pid), signal.SIGTERM)
        except OSError:
            try:
                proc.terminate()
            except OSError as e:
                return False, str(e)
        try:
            proc.wait(timeout=6)
        except subprocess.TimeoutExpired:
            try:
                os.killpg(os.getpgid(proc.pid), signal.SIGKILL)
            except OSError:
                pass
        with self.lock:
            self.state, self.ip = "idle", ""
        return True, ""



    # -- helpers -----------------------------------------------------------

    def con_detail(self, uuid, refresh=False):
        key = f"con:{uuid}"
        if refresh:
            self.detail_cache.pop(key, None)
        det = self.detail_cache.get(key) or q_con_details(uuid)
        self.detail_cache[key] = det
        return det

    def resolve_profile_item(self):
        """Return the selected row as a saved profile, or None after telling
        the user why not. Device rows resolve to a profile bound to them."""
        item = self.current()
        if item is None:
            return None
        if self.tab == T_WIFI:
            saved = self.saved_wifi_profile(item["ssid"], item["in_use"])
            if not saved:
                self.notify("Network is not saved — connect first", C_WARN)
                return None
            return saved
        if "uuid" in item:
            return item
        if item.get("kind") == "dialer":
            self.notify("Dial-up profiles live in wvdial, not NetworkManager", C_WARN)
            return None
        dev = item.get("device", "")
        dev_type = item.get("type", "")
        con_name = item.get("connection", "")
        if con_name:
            match = next((c for c in self.snap["saved"] if c["name"] == con_name), None)
            if match:
                return match
        # nmcli only fills DEVICE for an active connection, so an inactive
        # profile won't match on device name — fall back to type.
        type_map = {"ethernet": ETH_TYPES, "wifi": WIFI_TYPES,
                    "gsm": ("gsm",), "cdma": ("cdma",)}
        expected = type_map.get(dev_type, ())
        candidates = [c for c in self.snap["saved"]
                      if (dev and c["device"] == dev)
                      or (not c["device"] and c["type"] in expected)]
        if not candidates:
            self.notify(f"No profile for {dev or 'this device'} — press a", C_WARN)
            return None
        if len(candidates) == 1:
            return candidates[0]
        choice = select_box(self.stdscr, f"Profile for {dev}",
                            [(c["uuid"], c["name"], True, c["type"]) for c in candidates])
        return next((c for c in candidates if c["uuid"] == choice), None)

    def active_device_for(self, item):
        return item.get("device", "") if item.get("active") else ""

    # -- connect / disconnect ---------------------------------------------

    def act_enter(self):
        item = self.current()
        if item is None:
            return
        if self.tab == T_WIFI:
            self.wifi_connect(item)
        elif self.tab == T_DIAL:
            self.act_dial(item)
        elif self.tab in (T_ETH, T_ADAPT):
            if item["state"] == "connected":
                self.notify(f"{item['device']} is already connected")
            else:
                self.do_action("dev", a_dev_connect, item["device"],
                               note=f"Connecting {item['device']}…",
                               success=f"{item['device']} connected")
        elif self.tab == T_MOB and "uuid" not in item:
            if item.get("connection"):
                self.do_action("con", a_con_up, item["connection"],
                               note="Connecting…", success="Connected")
            else:
                self.notify("No profile for this modem — press a", C_WARN)
        else:
            if item.get("active"):
                self.do_action("con", a_con_down, item["name"],
                               note=f"Disconnecting {item['name']}…",
                               success=f"{item['name']} disconnected")
            else:
                self.do_action("con", a_con_up, item["name"],
                               note=f"Connecting {item['name']}…",
                               success=f"{item['name']} connected")

    def wifi_connect(self, net):
        if net["in_use"]:
            self.notify(f"{net['ssid']} is already connected")
            return
        saved = self.saved_wifi_profile(net["ssid"], net["in_use"])
        if saved:
            self.do_action("wifi", a_con_up, saved["name"],
                           note=f"Connecting to {net['ssid']}…",
                           success=f"Connected: {net['ssid']}")
            return
        if net["security"] == "open":
            self.do_action("wifi", a_wifi_connect, net["ssid"], None, False,
                           self.snap["wifi_dev"],
                           note=f"Connecting to {net['ssid']}…",
                           success=f"Connected: {net['ssid']}")
            return

        guess = guess_wifi_security(net["security"])
        options = [(key, label, True, "detected" if key == guess else "")
                   for key, label in WIFI_SEC_CHOICES]
        sectype = select_box(self.stdscr, f"Security · {elide(net['ssid'], 24)}",
                             options, note=f"Scan reports {net['security']}")
        if sectype is None:
            self.notify("Cancelled")
            return

        if sectype == "auto":
            form = FormBox(self.stdscr, f"Connect · {elide(net['ssid'], 28)}",
                           [_f("password", "Password", "secret", required=True,
                               hint="F9 shows what you typed")])
            res = form.run()
            if res is None:
                self.notify("Cancelled")
                return
            self.do_action("wifi", a_wifi_connect, net["ssid"], res["password"],
                           False, self.snap["wifi_dev"],
                           note=f"Connecting to {net['ssid']}…",
                           success=f"Connected: {net['ssid']}")
            return

        if sectype == "wpa-eap":
            form = FormBox(self.stdscr, f"802.1x · {elide(net['ssid'], 24)}",
                           eap_fields())
        else:
            label = "WEP key" if sectype == "wep" else "Password"
            form = FormBox(self.stdscr, f"{dict(WIFI_SEC_CHOICES)[sectype]} · "
                                        f"{elide(net['ssid'], 20)}",
                           [_f("password", label, "secret", required=True)])
        res = form.run()
        if res is None:
            self.notify("Cancelled")
            return
        self.do_action("wifi", create_wifi_manual, net["ssid"], net["ssid"],
                       self.snap["wifi_dev"], sectype, res,
                       note=f"Connecting to {net['ssid']}…",
                       success=f"Connected: {net['ssid']}")

    def act_disconnect(self):
        item = self.current()
        if item is None:
            return
        if self.tab == T_DIAL:
            self.act_dial(item, hangup_only=True)
            return
        if self.tab == T_WIFI:
            if not item["in_use"]:
                self.notify("This network is not active", C_WARN)
                return
            self.do_action("wifi", a_dev_disconnect, self.snap["wifi_dev"],
                           note="Disconnecting…", success="Wi-Fi disconnected")
        elif self.tab in (T_ETH, T_ADAPT):
            if item["state"] != "connected":
                self.notify("Device is not connected", C_WARN)
                return
            self.do_action("dev", a_dev_disconnect, item["device"],
                           note="Disconnecting…", success=f"{item['device']} disconnected")
        elif "uuid" in item:
            if not item["active"]:
                self.notify("Profile is not active", C_WARN)
                return
            self.do_action("con", a_con_down, item["name"],
                           note="Disconnecting…", success=f"{item['name']} disconnected")
        elif item.get("connection"):
            self.do_action("con", a_con_down, item["connection"],
                           note="Disconnecting…", success="Disconnected")

    def act_delete(self):
        item = self.current()
        if item is None:
            return
        if self.tab == T_DIAL:
            if item["is_defaults"]:
                self.notify("Defaults is shared by every dialer", C_WARN)
                return
            if not confirm_box(self.stdscr, "Delete dialer",
                               f"Remove “{item['name']}” from the wvdial config?",
                               danger=True):
                return
            rc, path, err = dial_delete(item["name"])
            self.notify(f"Removed from {path}" if rc == 0 else err,
                        C_OK if rc == 0 else C_ERR)
            self.request_refresh()
            return
        if self.tab == T_WIFI:
            saved = self.saved_wifi_profile(item["ssid"], item["in_use"])
            if not saved:
                self.notify("This network is not saved", C_WARN)
                return
            if not confirm_box(self.stdscr, "Forget network",
                               f"Delete the profile “{saved['name']}”?", danger=True):
                return
            self.do_action("del", a_con_delete, saved["name"],
                           note="Deleting…", success=f"Forgot {item['ssid']}")
            return
        if "uuid" not in item:
            self.notify("Select a profile, not a device", C_WARN)
            return
        if not confirm_box(self.stdscr, "Delete profile",
                           f"Delete “{item['name']}” ({item['type']})?", danger=True):
            return
        self.do_action("del", a_con_delete, item["uuid"],
                       note="Deleting…", success=f"“{item['name']}” deleted")

    def act_toggle_auto(self):
        item = self.current()
        if item is None or "uuid" not in item:
            self.notify("Autoconnect applies to a saved profile", C_WARN)
            return
        new = not item["autoconnect"]
        self.do_action("auto", a_autoconnect, item["uuid"], new,
                       note="Saving…",
                       success=f"Autoconnect {'on' if new else 'off'}: {item['name']}")

    def act_clone(self):
        item = self.resolve_profile_item()
        if item is None:
            return
        name = ask_line(self.stdscr, "Clone profile", "New name",
                        value=f"{item['name']} copy",
                        hint="A full copy, including passwords")
        if not name:
            return
        self.do_action("clone", a_con_clone, item["uuid"], name,
                       note="Cloning…", success=f"“{name}” created")

    def act_export(self):
        item = self.resolve_profile_item()
        if item is None:
            return
        if item["type"] not in VPN_TYPES:
            self.notify("Only VPN profiles can be exported", C_WARN)
            return
        path = ask_line(self.stdscr, "Export VPN", "File",
                        value=f"~/{item['name'].replace(' ', '_')}.conf",
                        hint="Secrets may be written in the clear")
        if not path:
            return
        self.do_action("export", a_con_export, item["uuid"], path,
                       note="Exporting…", success=f"Written to {path}")

    def act_reapply(self):
        item = self.current()
        if item is None:
            return
        dev = item.get("device") or (self.snap["wifi_dev"] if self.tab == T_WIFI else "")
        if not dev:
            self.notify("Select a connected device or an active profile", C_WARN)
            return
        self.do_action("reapply", a_reapply, dev,
                       note=f"Reapplying on {dev}…", success=f"{dev} reapplied")

    # -- radios, networking, diagnostics -----------------------------------

    def act_radio(self, kind):
        if not self.snap:
            return
        if kind == "wwan" and not self.snap["has_wwan_hw"]:
            self.notify("No mobile hardware detected", C_WARN)
            return
        cur = self.snap["radio"]["wifi" if kind == "wifi" else "wwan"]
        if cur is None:
            self.notify(f"{kind} radio is unavailable", C_WARN)
            return
        label = "Wi-Fi" if kind == "wifi" else "WWAN"
        self.do_action("radio", a_radio, kind, not cur,
                       note=f"Switching {label}…",
                       success=f"{label} {'off' if cur else 'on'}")

    def act_networking(self):
        cur = self.snap.get("networking") if self.snap else None
        if cur is None:
            self.notify("Cannot read the networking state", C_WARN)
            return
        if cur and not confirm_box(self.stdscr, "Networking off",
                                   "Disable all networking? Every connection drops.",
                                   danger=True):
            return
        self.do_action("net", a_networking, not cur,
                       note="Switching networking…",
                       success=f"Networking {'off' if cur else 'on'}")

    def act_connectivity(self):
        self.do_action("conncheck", a_connectivity_check,
                       note="Checking connectivity…", success="Connectivity rechecked")

    def act_diagnostics(self):
        self.request_report("Diagnostics", diagnostics, note="Running checks…")

    def act_hotspot(self):
        if not self.snap or not self.snap["wifi_dev"]:
            self.notify("No Wi-Fi adapter", C_WARN)
            return
        form = FormBox(self.stdscr, "Wi-Fi hotspot", [
            _f("ssid", "Name", required=True, value=os.uname().nodename[:24],
               hint="The SSID other devices will see"),
            _f("password", "Password", "secret",
               hint="At least 8 characters, blank means open"),
            _f("band", "Band", "choice", choices=["auto", "2.4 GHz", "5 GHz"],
               hint="5 GHz is faster but shorter range"),
        ], note="Shares the current connection. Stop it from the Profiles tab.")
        res = form.run()
        if not res:
            return
        if res["password"] and len(res["password"]) < 8:
            self.notify("Hotspot password must be at least 8 characters", C_ERR)
            return
        band = {"2.4 GHz": "bg", "5 GHz": "a"}.get(res["band"], "")
        self.do_action("hotspot", a_hotspot, self.snap["wifi_dev"], res["ssid"],
                       res["password"], band,
                       note="Starting hotspot…", success=f"Hotspot “{res['ssid']}” up")

    def act_wifi_key(self):
        if self.tab != T_WIFI:
            self.notify("Wi-Fi tab only", C_WARN)
            return
        item = self.current()
        saved = self.resolve_profile_item()
        if item is None or saved is None:
            return
        psk = q_wifi_psk(saved["uuid"])
        payload, qr = wifi_qr(item["ssid"], psk)
        lines = [f"Network   {item['ssid']}",
                 f"Key       {psk or 'not readable — run netui as root'}", ""]
        if qr:
            lines += qr
        else:
            lines += [payload, "",
                      "Install qrencode to render this as a scannable code."]
        pager(self.stdscr, "Wi-Fi key", lines)

    def act_info(self):
        item = self.current()
        if item is None:
            return
        if self.tab == T_DIAL:
            lines = [f"[{item['name']}]  ({item['source'] or dial_write_path()})"]
            lines += [f"{k} = {v}" for k, v in item["eff"].items()]
            tail = self.dial.tail(120)
            if tail:
                lines += ["", "── session ──"] + tail
            pager(self.stdscr, f"Dialer {item['name']}", lines)
            return
        if "uuid" in item:
            det = self.con_detail(item["uuid"])
            title = f"Properties · {item['name']}"
        elif self.tab == T_WIFI:
            det = {"SSID": item["ssid"], "BSSID": item["bssid"],
                   "Signal": str(item["signal"]), "Security": item["security"],
                   "Channel": item["chan"], "Frequency": item["freq"],
                   "Rate": item["rate"]}
            title = f"Network · {item['ssid']}"
        else:
            dev = item.get("device", "")
            det = q_dev_details(dev)
            title = f"Device · {dev}"
        lines = [f"{k} = {v}" for k, v in det.items() if v not in ("", "--")]
        pager(self.stdscr, title, lines or ["No data"])

    def act_log(self):
        if not self.log:
            message_box(self.stdscr, "Event log", ["Nothing has happened yet."])
            return
        pager(self.stdscr, "Event log", [f"{t}  {msg}" for t, msg in reversed(self.log)])

    def act_filter(self):
        cur = self.filter[self.tab]
        text = ask_line(self.stdscr, f"Filter · {TABS[self.tab]}", "Text",
                        value=cur, required=False,
                        hint="Blank clears the filter")
        if text is None:
            return
        self.filter[self.tab] = text.strip()
        self.sel[self.tab] = 0
        self.notify(f"Filter: {text.strip()}" if text.strip() else "Filter cleared")

    # -- creation ------------------------------------------------------------

    def act_add(self):
        if self.tab == T_WIFI:
            self.add_hidden_wifi()
        elif self.tab == T_ETH:
            self.add_ethernet()
        elif self.tab == T_VPN:
            self.add_vpn()
        elif self.tab == T_MOB:
            self.add_mobile()
        elif self.tab == T_DIAL:
            self.add_dialer()
        elif self.tab == T_ADAPT:
            self.notify("Devices are detected automatically", C_WARN)
        else:
            choice = select_box(self.stdscr, "New connection", [
                ("wifi", "Hidden Wi-Fi", True, ""),
                ("ethernet", "Wired", True, ""),
                ("vpn", "VPN", True, ""),
                ("mobile", "Mobile or PPPoE", True, ""),
                ("dial", "Dial-up", bool(WVDIAL), "" if WVDIAL else "needs wvdial"),
            ])
            {"wifi": self.add_hidden_wifi, "ethernet": self.add_ethernet,
             "vpn": self.add_vpn, "mobile": self.add_mobile,
             "dial": self.add_dialer}.get(choice, lambda: None)()

    def add_hidden_wifi(self):
        options = [(k, l, True, "") for k, l in WIFI_SEC_CHOICES if k != "auto"]
        sectype = select_box(self.stdscr, "Hidden network", options)
        if sectype is None:
            return
        ssid = _f("ssid", "Network name", required=True, hint="The exact SSID")
        if sectype == "wpa-eap":
            fields = [ssid] + eap_fields()
        else:
            label = "WEP key" if sectype == "wep" else "Password"
            fields = [ssid, _f("password", label, "secret", required=True)]
        res = FormBox(self.stdscr, "Hidden Wi-Fi", fields,
                      note="Added and connected right away.").run()
        if not res:
            return
        name = res.pop("ssid")
        self.do_action("wifi", create_wifi_manual, name, name,
                       self.snap["wifi_dev"] if self.snap else None, sectype, res,
                       note=f"Connecting to {name}…", success=f"Connected: {name}",
                       hidden=True)

    def eth_ifaces(self):
        devs = [d["device"] for d in (self.snap["devices"] if self.snap else [])
                if d["type"] == "ethernet"]
        return devs or ["eth0"]

    def add_ethernet(self):
        res = FormBox(self.stdscr, "Wired connection", [
            _f("name", "Profile name", required=True),
            _f("iface", "Interface", "choice", choices=self.eth_ifaces()),

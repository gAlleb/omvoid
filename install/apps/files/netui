class App:
    def __init__(self, stdscr, start_tab=T_WIFI):
        self.stdscr = stdscr
        self.worker = Worker()
        self.dial = DialSession()
        self.snap = None
        self.loading = True
        self.tab = start_tab
        self.sel = [0] * len(TABS)
        self.scroll = [0] * len(TABS)
        self.filter = [""] * len(TABS)
        self.log = []
        self.status = ""
        self.status_attr = 0
        self.pending = set()
        self.detail_cache = {}
        self.last_refresh = 0.0
        self.frame = 0

        curses.curs_set(0)
        init_colors()
        stdscr.keypad(True)
        stdscr.timeout(120)
        # Without this, Esc takes about a second to register: curses waits
        # to see whether more bytes follow (the start of an escape sequence).
        try:
            curses.set_escdelay(25)
        except (AttributeError, curses.error):
            pass

        self.request_refresh(rescan=CFG["scan_on_start"],
                             note="Querying NetworkManager…")

    # -- log / status ---------------------------------------------------

    def notify(self, text, level=C_ACCENT):
        self.status = text
        self.status_attr = cp(level)
        self.log.append((time.strftime("%H:%M:%S"), text))
        self.log = self.log[-300:]

    # -- data -------------------------------------------------------------

    def request_refresh(self, rescan=False, note=""):
        if "snap" in self.pending:
            return
        self.pending.add("snap")
        if note:
            self.notify(note)
        self.last_refresh = time.time()
        self.worker.submit("snap", snapshot, rescan)

    def do_action(self, tag, fn, *args, note="", success="Done", **kwargs):
        if note:
            self.notify(note)
        self.pending.add(tag)
        self.worker.submit(("action", tag, success), fn, *args, **kwargs)

    def request_report(self, title, fn, *args, note=""):
        if note:
            self.notify(note)
        self.pending.add("report")
        self.worker.submit(("report", title), fn, *args)

    def handle_results(self):
        for tag, value, error in self.worker.poll():
            if tag == "snap":
                self.pending.discard("snap")
                self.loading = False
                if error:
                    self.notify(f"Refresh failed: {error}", C_ERR)
                else:
                    self.snap = value
                    self.clamp()
                    if self.status.endswith("…"):
                        self.status = ""
            elif isinstance(tag, tuple) and tag[0] == "action":
                _, name, success = tag
                self.pending.discard(name)
                if error:
                    self.notify(f"Failed: {error}", C_ERR)
                else:
                    rc, out, err = value
                    if rc == 0:
                        self.notify(success, C_OK)
                        notify_waybar()
                    else:
                        self.notify(err_line(rc, err, out), C_ERR)
                self.request_refresh()
            elif isinstance(tag, tuple) and tag[0] == "report":
                self.pending.discard("report")
                self.status = ""
                if error:
                    self.notify(f"Failed: {error}", C_ERR)
                else:
                    pager(self.stdscr, tag[1], value or ["No data"])
            elif isinstance(tag, tuple) and tag[0] == "detail":
                key = tag[1]
                self.pending.discard(f"detail:{key}")
                if not error:
                    self.detail_cache[key] = value

    # -- tab contents ---------------------------------------------------

    def raw_items(self, tab):
        s = self.snap
        if not s:
            return []
        if tab == T_WIFI:
            return s["wifi"]
        if tab == T_ETH:
            return [d for d in s["devices"] if d["type"] == "ethernet"]
        if tab == T_VPN:
            saved = [c for c in s["saved"] if c["type"] in VPN_TYPES]
            return sorted(saved, key=lambda c: (not c["active"], c["name"].lower()))
        if tab == T_MOB:
            rows = list(s["modems"])
            rows += [c for c in s["saved"] if c["type"] in MOBILE_TYPES]
            return rows
        if tab == T_DIAL:
            return s["dialers"]
        if tab == T_ADAPT:
            return [d for d in s["devices"] if d["type"] not in SKIP_DEVICE_TYPES]
        if tab == T_PROF:
            return sorted(s["saved"],
                          key=lambda c: (not c["active"], c["type"], c["name"].lower()))
        return []

    @staticmethod
    def search_text(item):
        parts = [str(item.get(k, "")) for k in
                 ("ssid", "name", "device", "type", "connection", "phone",
                  "modem", "security", "operator")]
        return " ".join(parts).lower()

    def items(self, tab=None):
        tab = self.tab if tab is None else tab
        rows = self.raw_items(tab)
        needle = self.filter[tab].lower().strip()
        if needle:
            rows = [it for it in rows if needle in self.search_text(it)]
        return rows

    def current(self):
        lst = self.items()
        if not lst:
            return None
        return lst[min(self.sel[self.tab], len(lst) - 1)]

    def clamp(self):
        for t in range(len(TABS)):
            n = len(self.items(t))
            self.sel[t] = max(0, min(self.sel[t], max(0, n - 1)))

    def saved_wifi_profile(self, ssid, in_use=False):
        """Find the saved profile for a network.

        Usually the profile is named after the SSID, but the user may have
        renamed it. For the currently active network, fall back to the
        connection name reported by the device itself."""
        if not self.snap:
            return None
        exact = next((c for c in self.snap["saved"]
                      if c["name"] == ssid and c["type"] in WIFI_TYPES), None)
        if exact:
            return exact
        if in_use and self.snap["wifi_dev"]:
            active = next((d["connection"] for d in self.snap["devices"]
                           if d["device"] == self.snap["wifi_dev"]), "")
            if active:
                return next((c for c in self.snap["saved"]
                             if c["name"] == active and c["type"] in WIFI_TYPES), None)
        return None

    # -- drawing ------------------------------------------------------------

    def draw(self):
        stdscr = self.stdscr
        stdscr.erase()
        h, w = stdscr.getmaxyx()
        if h < 12 or w < 54:
            put(stdscr, 0, 0, "Terminal too small (need 54×12)", cp(C_WARN))
            stdscr.refresh()
            return

        self.draw_header(w)
        list_w = max(30, int(w * CFG["list_ratio"]))
        body_h = h - 4
        left = stdscr.derwin(body_h, list_w, 2, 0)
        right = stdscr.derwin(body_h, w - list_w, 2, list_w)
        self.draw_list(left, body_h, list_w)
        self.draw_details(right, body_h, w - list_w)
        self.draw_footer(h, w)
        stdscr.refresh()

    def status_chips(self):
        s = self.snap
        chips = []
        if not s:
            return chips
        if s.get("networking") is False:
            chips.append(("networking off", C_ERR))
        conn = s.get("general", {}).get("connectivity", "unknown")
        if conn == "portal":
            chips.append(("captive portal", C_WARN))
        elif conn in ("limited", "none"):
            chips.append((f"net {conn}", C_WARN))
        elif conn == "full":
            chips.append(("online", C_OK))
        if s["wifi_dev"] and s["radio"]["wifi"] is not None:
            chips.append((f"wifi {'on' if s['radio']['wifi'] else 'off'}",
                          C_DIM if s["radio"]["wifi"] else C_WARN))
        # nmcli reports a WWAN radio state even with no modem present, so
        # only mention it when there is actual hardware.
        if s["has_wwan_hw"] and s["radio"]["wwan"] is not None:
            chips.append((f"wwan {'on' if s['radio']['wwan'] else 'off'}", C_DIM))
        state, section, ip = self.dial.status()
        if state in ("dialing", "connected"):
            chips.append((f"dial {section} {state}",
                          C_OK if state == "connected" else C_WARN))
        return chips

    def draw_header(self, w):
        x = 0
        compact = w < 92
        for i, name in enumerate(TABS):
            label = f" {name} " if compact else f" {i + 1} {name} "
            attr = cp(C_SEL) | curses.A_BOLD if i == self.tab else cp(C_ACCENT)
            put(self.stdscr, 0, x, label, attr)
            x += len(label)

        chips = self.status_chips()
        text = "  ".join(c[0] for c in chips)
        if self.worker.is_busy:
            text = SPINNER[self.frame % len(SPINNER)] + " " + text
        start = max(x + 1, w - len(text) - 1)
        if start > x:
            pos = start
            if self.worker.is_busy:
                put(self.stdscr, 0, pos, SPINNER[self.frame % len(SPINNER)] + " ",
                    cp(C_DIM))
                pos += 2
            for label, kind in chips:
                if pos >= w - 1:
                    break
                put(self.stdscr, 0, pos, elide(label, w - pos - 1), cp(kind))
                pos += len(label) + 2
        put(self.stdscr, 1, 0, BOX["h"] * w, cp(C_DIM))

    def draw_list(self, win, h, w):
        title = TABS[self.tab]
        lst = self.items()
        badge = ""
        if self.filter[self.tab]:
            badge = f"/{elide(self.filter[self.tab], 10)}"
        draw_box(win, title, C_ACCENT, badge)
        inner_h = h - 2

        if self.loading:
            put(win, 1, 2, SPINNER[self.frame % len(SPINNER)] + " Loading…", cp(C_DIM))
            return
        if not lst:
            text = ("Nothing matches the filter — press / to change it"
                    if self.filter[self.tab] else self.empty_text())
            for i, line in enumerate(wrap(text, w - 4)):
                put(win, 1 + i, 2, line, cp(C_DIM))
            return

        sel = min(self.sel[self.tab], len(lst) - 1)
        top = self.scroll[self.tab]
        if sel < top:
            top = sel
        elif sel >= top + inner_h:
            top = sel - inner_h + 1
        top = max(0, min(top, max(0, len(lst) - inner_h)))
        self.scroll[self.tab] = top

        for row in range(min(inner_h, len(lst) - top)):
            idx = top + row
            self.draw_row(win, 1 + row, w - 2, lst[idx], idx == sel)

        if len(lst) > inner_h:
            put(win, h - 1, max(2, w - 12), f" {sel + 1}/{len(lst)} ", cp(C_DIM))

    def draw_row(self, win, y, w, item, focused):
        base = cp(C_SEL) if focused else 0
        marker = GLYPH_SEL if focused else " "

        if self.tab == T_WIFI:
            bars = signal_bars(item["signal"])
            sig = f"{item['signal']:>3}%" if item["signal"] >= 0 else "  --"
            saved = "★" if self.saved_wifi_profile(item["ssid"], item["in_use"]) else " "
            lock = "🔒" if item["security"] != "open" else "  "
            active = GLYPH_ON if item["in_use"] else " "
            name = elide(item["ssid"], max(6, w - 26))
            put(win, y, 1, dpad(f"{marker}{active}{saved} {bars} {sig} {lock} {name}", w),
                base if focused else 0)
            if not focused:
                put(win, y, 5, bars, sig_attr(item["signal"]))
                if item["in_use"]:
                    put(win, y, 2, GLYPH_ON, cp(C_OK))
            return

        if self.tab in (T_ETH, T_ADAPT):
            up = item["state"] == "connected"
            state = state_label(item["state"])
            dot = GLYPH_ON if up else GLYPH_OFF
            if self.tab == T_ADAPT:
                text = (f"{marker}{dot} {item['device']:<10} {item['type']:<9} "
                        f"{state:<13} {elide(item['connection'] or '-', max(4, w - 40))}")
            else:
                text = (f"{marker}{dot} {item['device']:<10} {state:<14} "
                        f"{elide(item['connection'] or '-', max(4, w - 32))}")
            put(win, y, 1, dpad(text, w), base if focused else 0)
            if not focused and up:
                put(win, y, 2, GLYPH_ON, cp(C_OK))
            return

        if self.tab == T_VPN:
            on = item["active"]
            kind = "wireguard" if item["type"] == "wireguard" else "vpn"
            nw = max(6, w - 26)
            text = (f"{marker}{GLYPH_ON if on else GLYPH_OFF} "
                    f"{dpad(elide(item['name'], nw), nw)} {kind:<10}")
            put(win, y, 1, dpad(text, w), base if focused else 0)
            if not focused and on:
                put(win, y, 2, GLYPH_ON, cp(C_OK))
            return

        if self.tab == T_DIAL:
            state, section, _ = self.dial.status()
            live = state in ("dialing", "connected") and section == item["name"]
            dot = GLYPH_ON if live else GLYPH_OFF
            nw = max(6, w - 30)
            tail = item["phone"] or ("shared defaults" if item["is_defaults"] else "no number")
            text = f"{marker}{dot} {dpad(elide(item['name'], nw), nw)} {elide(tail, 18)}"
            put(win, y, 1, dpad(text, w), base if focused else 0)
            if not focused and live:
                put(win, y, 2, GLYPH_ON, cp(C_OK) if state == "connected" else cp(C_WARN))
            return

        if self.tab == T_MOB:
            if "device" in item and "uuid" not in item:
                sig = item.get("signal", "")
                extra = f"{item.get('operator', '')} {sig + '%' if sig else ''}".strip()
                text = (f"{marker}▣ {item['device']:<12} {item.get('state', ''):<14} "
                        f"{elide(extra, max(4, w - 34))}")
            else:
                on = item.get("active")
                nw = max(6, w - 24)
                text = (f"{marker}{GLYPH_ON if on else GLYPH_OFF} "
                        f"{dpad(elide(item['name'], nw), nw)} {item['type']:<8}")
            put(win, y, 1, dpad(text, w), base if focused else 0)
            return

        on = item["active"]
        auto = "A" if item["autoconnect"] else " "
        nw = max(6, w - 26)
        text = (f"{marker}{GLYPH_ON if on else GLYPH_OFF}{auto} "
                f"{dpad(elide(item['name'], nw), nw)} {elide(item['type'], 12)}")
        put(win, y, 1, dpad(text, w), base if focused else 0)
        if not focused and on:
            put(win, y, 2, GLYPH_ON, cp(C_OK))

    def empty_text(self):
        s = self.snap
        if self.tab == T_WIFI:
            if not s or not s["wifi_dev"]:
                return "No Wi-Fi adapter. Check the Devices tab."
            if s["radio"]["wifi"] is False:
                return "Wi-Fi radio is off — press w."
            return "No networks. Press s to rescan."
        if self.tab == T_ETH:
            return "No wired interfaces."
        if self.tab == T_VPN:
            return "No VPN profiles. Press a to add one."
        if self.tab == T_MOB:
            return "No modem or mobile profile. Press a to add one."
        if self.tab == T_DIAL:
            if not WVDIAL:
                return "wvdial is not installed — dial-up needs wvdial and pppd."
            return "No dialers configured. Press a to add one."
        if self.tab == T_ADAPT:
            return "No network devices."
        return "No saved profiles. Press a to create one."

    def draw_details(self, win, h, w):
        draw_box(win, "Details", C_ACCENT)
        item = self.current()
        if self.loading:
            put(win, 1, 2, "…", cp(C_DIM))
            return
        if item is None:
            put(win, 1, 2, "Nothing selected", cp(C_DIM))
            return
        rows = self.detail_rows(item)
        maxw = w - 4
        y = 1
        for label, value, attr in rows:
            if y >= h - 1:
                break
            if label is None:
                put(win, y, 2, elide(str(value), maxw), attr)
            else:
                put(win, y, 2, f"{label}", cp(C_DIM))
                put(win, y, 2 + 14, elide(str(value), max(0, maxw - 14)), attr)
            y += 1

    def detail_rows(self, item):
        s = self.snap
        rows = []
        if self.tab == T_WIFI:
            saved = self.saved_wifi_profile(item["ssid"], item["in_use"])
            rows += [
                ("Network", item["ssid"], curses.A_BOLD),
                ("State", "connected" if item["in_use"] else "not connected",
                 cp(C_OK) if item["in_use"] else 0),
                ("Signal", f"{item['signal']}%  {signal_bars(item['signal'])}"
                 if item["signal"] >= 0 else "unknown", sig_attr(item["signal"])),
                ("Security", item["security"], 0),
                ("BSSID", item["bssid"] or "-", 0),
                ("Channel", f"{item['chan']}  ({item['freq']})", 0),
                ("Rate", item["rate"] or "-", 0),
                ("Mode", item["mode"] or "-", 0),
                ("Profile", saved["name"] if saved else "not saved",
                 cp(C_OK) if saved else cp(C_DIM)),
            ]
            if item["in_use"] and s["wifi_dev"]:
                rows.append((None, "", 0))
                rows += self.ip_rows(s["dev_details"].get(s["wifi_dev"], {}))
            return rows

        if self.tab == T_DIAL:
            state, section, ip = self.dial.status()
            live = section == item["name"] and state in ("dialing", "connected")
            rows += [
                ("Dialer", item["name"], curses.A_BOLD),
                ("State", state if live else "idle",
                 cp(C_OK) if live and state == "connected" else cp(C_DIM)),
                ("Phone", item["phone"] or "-", 0),
                ("Modem", item["modem"] or "-", 0),
                ("Baud", item["eff"].get("Baud", "-"), 0),
                ("Username", item["user"] or "-", 0),
                ("Config", item["source"] or dial_write_path(), cp(C_DIM)),
            ]
            if live and ip:
                rows.append(("Local IP", ip, cp(C_OK)))
            if not WVDIAL:
                rows.append((None, "wvdial not installed", cp(C_WARN)))
            elif not PPPD:
                rows.append((None, "pppd not installed", cp(C_WARN)))
            elif os.geteuid() != 0:
                rows.append((None, "dialing usually needs root or the dialout group",
                             cp(C_DIM)))
            tail = self.dial.tail(6) if live else []
            if tail:
                rows.append((None, "", 0))
                for line in tail:
                    rows.append((None, elide(line, 60), cp(C_DIM)))
            return rows

        if self.tab in (T_ETH, T_ADAPT):
            rows += [
                ("Device", item["device"], curses.A_BOLD),
                ("Type", item["type"], 0),
                ("State", state_label(item["state"]),
                 cp(C_OK) if item["state"] == "connected" else cp(C_DIM)),
                ("Profile", item["connection"] or "-", 0),
            ]
            det = self.want_dev_detail(item["device"])
            if det is None:
                rows.append((None, "loading…", cp(C_DIM)))
                return rows
            if det.get("GENERAL.DRIVER"):
                rows.append(("Driver", det["GENERAL.DRIVER"], 0))
            if det.get("GENERAL.HWADDR"):
                rows.append(("MAC", det["GENERAL.HWADDR"], 0))
            if det.get("GENERAL.MTU"):
                rows.append(("MTU", det["GENERAL.MTU"], 0))
            if det.get("CAPABILITIES.SPEED") not in (None, "", "--", "unknown"):
                rows.append(("Speed", det["CAPABILITIES.SPEED"], 0))
            if item["state"] == "connected":
                rows.append((None, "", 0))
                rows += self.ip_rows(det)
            return rows

        if self.tab in (T_VPN, T_PROF) or (self.tab == T_MOB and "uuid" in item):
            rows += [
                ("Profile", item["name"], curses.A_BOLD),
                ("Type", item["type"], 0),
                ("State", "active" if item["active"] else "inactive",
                 cp(C_OK) if item["active"] else cp(C_DIM)),
                ("Autoconnect", "yes" if item["autoconnect"] else "no", 0),
                ("Device", item["device"] or "-", 0),
                ("UUID", item["uuid"], cp(C_DIM)),
            ]
            det = self.want_con_detail(item["uuid"])
            if det is None:
                rows.append((None, "loading…", cp(C_DIM)))
                return rows
            rows.append((None, "", 0))
            for key, label in (("vpn.data", "VPN data"),
                               ("connection.interface-name", "Interface"),
                               ("ipv4.method", "IPv4"),
                               ("ipv4.addresses", "IPv4 address"),
                               ("ipv4.gateway", "IPv4 gateway"),
                               ("ipv4.dns", "IPv4 DNS"),
                               ("ipv6.method", "IPv6"),
                               ("ipv6.addresses", "IPv6 address"),
                               ("ipv6.dns", "IPv6 DNS"),
                               ("proxy.method", "Proxy"),
                               ("proxy.pac-url", "PAC URL"),
                               ("gsm.apn", "APN"),
                               ("gsm.username", "Username"),
                               ("pppoe.username", "PPPoE user")):
                val = det.get(key)
                if val and val not in ("--", "", "none"):
                    rows.append((label, val, 0))
            if item["active"] and item["device"]:
                live = s["dev_details"].get(item["device"], {})
                if live:
                    rows.append((None, "", 0))
                    rows += self.ip_rows(live)
            return rows

        rows += [
            ("Device", item.get("device", "-"), curses.A_BOLD),
            ("Type", item.get("type", "-"), 0),
            ("State", item.get("state", "-"), 0),
            ("Profile", item.get("connection") or "-", 0),
        ]
        if item.get("operator"):
            rows.append(("Operator", item["operator"], 0))
        if item.get("signal"):
            rows.append(("Signal", item["signal"] + "%", 0))
        if not MMCLI:
            rows.append((None, "install ModemManager for details", cp(C_DIM)))
        return rows

    def ip_rows(self, det):
        rows = []
        v4 = [v for k, v in sorted(det.items()) if k.startswith("IP4.ADDRESS")]
        v6 = [v for k, v in sorted(det.items()) if k.startswith("IP6.ADDRESS")]
        dns4 = [v for k, v in sorted(det.items()) if k.startswith("IP4.DNS")]
        dns6 = [v for k, v in sorted(det.items()) if k.startswith("IP6.DNS")]
        if v4:
            rows.append(("IPv4", ", ".join(v4), 0))
        if det.get("IP4.GATEWAY", "--") not in ("--", ""):
            rows.append(("Gateway", det["IP4.GATEWAY"], 0))
        if dns4:
            rows.append(("DNS", ", ".join(dns4), 0))
        if v6:
            rows.append(("IPv6", v6[0], 0))
        if dns6:
            rows.append(("DNS v6", dns6[0], 0))
        return rows

    def want_con_detail(self, uuid):
        key = f"con:{uuid}"
        if key in self.detail_cache:
            return self.detail_cache[key]
        if key not in self.pending:
            self.pending.add(key)
            self.worker.submit(("detail", key), q_con_details, uuid)
        return None

    def want_dev_detail(self, dev):
        key = f"dev:{dev}"
        if key in self.detail_cache:
            return self.detail_cache[key]
        if key not in self.pending:
            self.pending.add(key)
            self.worker.submit(("detail", key), q_dev_details, dev)
        return None

    def draw_footer(self, h, w):
        keys = {
            T_WIFI: keyhint(("↵", "connect"), ("d", "off"), ("x", "forget"),
                            ("s", "rescan"), ("K", "key"), ("H", "hotspot")),
            T_ETH: keyhint(("↵", "connect"), ("d", "off"), ("a", "new"),
                           ("e", "edit"), ("A", "advanced")),
            T_VPN: keyhint(("↵", "toggle"), ("a", "add"), ("e", "edit"),
                           ("A", "advanced"), ("E", "export"), ("x", "delete")),
            T_MOB: keyhint(("↵", "connect"), ("a", "add"), ("e", "edit"),
                           ("d", "off"), ("W", "radio")),
            T_DIAL: keyhint(("↵", "dial"), ("a", "new"), ("e", "edit"),
                            ("s", "probe"), ("i", "log"), ("x", "delete")),
            T_ADAPT: keyhint(("↵", "connect"), ("d", "off"), ("i", "info"),
                             ("R", "reapply"), ("r", "refresh")),
            T_PROF: keyhint(("↵", "activate"), ("e", "edit"), ("A", "advanced"),

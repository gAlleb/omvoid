        key = f"con:{item['uuid']}"
        det = self.detail_cache.get(key) or q_con_details(item["uuid"])
        self.detail_cache[key] = det
        con_type = det.get("connection.type", item.get("type", ""))
        alias = TYPE_ALIAS.get(con_type)

        def clean(v):
            return "" if v in (None, "--") else v

        fields = []
        if alias:

    # -- action handlers ----------------------------------------------------

    def act_enter(self):
        item = self.current()
        if item is None:
            return
        if self.tab == T_WIFI:
            self.wifi_connect(item)
        elif self.tab in (T_ETH, T_ADAPT):
            if item["state"] == "connected":
                self.notify(f"{item['device']} is already connected")
            else:
                self.do_action("dev", a_dev_connect, item["device"],
                               note=f"Connecting {item['device']}…",
                               success=f"{item['device']} connected")
        elif self.tab == T_MOB and "uuid" not in item:
            if item.get("connection"):
                self.do_action("con", a_con_up, item["connection"],
                               note="Connecting…", success="Connected")
            else:
                self.notify("This modem has no profile yet. Press a to create one.", C_WARN)
        else:
            if item.get("active"):
                self.do_action("con", a_con_down, item["name"],
                               note=f"Disconnecting {item['name']}…",
                               success=f"{item['name']} disconnected")
            else:
                self.do_action("con", a_con_up, item["name"],
                               note=f"Connecting {item['name']}…",
                               success=f"{item['name']} connected")

    def wifi_connect(self, net):
        if net["in_use"]:
            self.notify(f"{net['ssid']} is already connected")
            return
        saved = self.saved_wifi_profile(net["ssid"], net["in_use"])
        if saved:
            self.do_action("wifi", a_con_up, saved["name"],
                           note=f"Connecting to {net['ssid']}…",
                           success=f"Connected: {net['ssid']}")
            return
        if net["security"] == "open":
            self.do_action("wifi", a_wifi_connect, net["ssid"], None, False,
                           self.snap["wifi_dev"],
                           note=f"Connecting to {net['ssid']}…",
                           success=f"Connected: {net['ssid']}")
            return

        guess = guess_wifi_security(net["security"])
        options = [(key, label + ("  — detected" if key == guess and key != "auto" else ""),
                   True, "") for key, label in WIFI_SEC_CHOICES]
        sectype = select_box(self.stdscr, f"Security for {elide(net['ssid'], 30)}", options,
                             footer=f"Scan reports: {net['security']} · Enter select · Esc cancel")
        if sectype is None:
            self.notify("Cancelled")
            return

        if sectype == "auto":
            form = FormBox(self.stdscr, f"Connect to {elide(net['ssid'], 40)}",
                           [_f("password", "Password", "secret", required=True)],
                           note=f"Security: {net['security']}")
            res = form.run()
            if res is None:
                self.notify("Cancelled")
                return
            self.do_action("wifi", a_wifi_connect, net["ssid"], res["password"], False,
                           self.snap["wifi_dev"],
                           note=f"Connecting to {net['ssid']}…",
                           success=f"Connected: {net['ssid']}")
            return

        if sectype == "wpa-eap":
            form = FormBox(self.stdscr, f"Enterprise login: {elide(net['ssid'], 28)}",
                           eap_fields(),
                           note="Ask your network admin for the EAP method, identity, and CA certificate.")
        else:
            label = "WEP key" if sectype == "wep" else "Password"
            form = FormBox(self.stdscr, f"{dict(WIFI_SEC_CHOICES)[sectype]}: {elide(net['ssid'], 24)}",
                           [_f("password", label, "secret", required=True)])
        res = form.run()
        if res is None:
            self.notify("Cancelled")
            return
        self.do_action("wifi", create_wifi_manual, net["ssid"], net["ssid"],
                       self.snap["wifi_dev"], sectype, res,
                       note=f"Connecting to {net['ssid']}…",
                       success=f"Connected: {net['ssid']}")

    def act_disconnect(self):
        item = self.current()
        if item is None:
            return
        if self.tab == T_WIFI:
            if not item["in_use"]:
                self.notify("This network is not active", C_WARN)
                return
            self.do_action("wifi", a_dev_disconnect, self.snap["wifi_dev"],
                           note="Disconnecting…", success="Wi-Fi disconnected")
        elif self.tab in (T_ETH, T_ADAPT):
            if item["state"] != "connected":
                self.notify("Device is not connected", C_WARN)
                return
            self.do_action("dev", a_dev_disconnect, item["device"],
                           note="Disconnecting…", success=f"{item['device']} disconnected")
        elif "uuid" in item:
            if not item["active"]:
                self.notify("Profile is not active", C_WARN)
                return
            self.do_action("con", a_con_down, item["name"],
                           note="Disconnecting…", success=f"{item['name']} disconnected")
        elif item.get("connection"):
            self.do_action("con", a_con_down, item["connection"],
                           note="Disconnecting…", success="Disconnected")

    def act_delete(self):
        item = self.current()
        if item is None:
            return
        if self.tab == T_WIFI:
            saved = self.saved_wifi_profile(item["ssid"], item["in_use"])
            if not saved:
                self.notify("This network is not saved", C_WARN)
                return
            if not confirm_box(self.stdscr, "Forget network",
                               f"Delete the saved profile \u201c{saved['name']}\u201d?", danger=True):
                self.notify("Cancelled")
                return
            self.do_action("del", a_con_delete, saved["name"],
                           note="Deleting profile…", success=f"Forgot {item['ssid']}")
            return
        if "uuid" not in item:
            self.notify("Select a profile, not a device", C_WARN)
            return
        if not confirm_box(self.stdscr, "Delete profile",
                           f"Delete \u201c{item['name']}\u201d ({item['type']})?", danger=True):
            self.notify("Cancelled")
            return
        self.do_action("del", a_con_delete, item["uuid"],
                       note="Deleting…", success=f"\u201c{item['name']}\u201d deleted")

    def act_toggle_auto(self):
        item = self.current()
        if item is None or "uuid" not in item:
            self.notify("Autoconnect applies to a profile", C_WARN)
            return
        new = not item["autoconnect"]
        self.do_action("auto", a_autoconnect, item["uuid"], new,
                       note="Updating autoconnect…",
                       success=f"Autoconnect {'enabled' if new else 'disabled'}: {item['name']}")

    def act_info(self):
        item = self.current()
        if item is None:
            return
        if "uuid" in item:
            key = f"con:{item['uuid']}"
            det = self.detail_cache.get(key) or q_con_details(item["uuid"])
            self.detail_cache[key] = det
            title = f"Properties: {item['name']}"
        elif self.tab == T_WIFI:
            det = {"SSID": item["ssid"], "BSSID": item["bssid"],
                   "Signal": str(item["signal"]), "Security": item["security"],
                   "Channel": item["chan"], "Frequency": item["freq"], "Rate": item["rate"]}
            title = f"Network {item['ssid']}"
        else:
            dev = item.get("device", "")
            det = q_dev_details(dev)
            title = f"Device {dev}"
        lines = [f"{k} = {v}" for k, v in det.items() if v not in ("", "--")]
        if not lines:
            lines = ["No data"]
        self.pager(title, lines)

    def pager(self, title, lines):
        stdscr = self.stdscr
        sh, sw = stdscr.getmaxyx()
        m = Modal(stdscr, sh - 2, min(sw - 2, 100), title)
        top = 0
        inner = m.h - 3
        while True:
            m.win.erase()
            draw_frame(m.win, title, cp(C_ACCENT))
            for i in range(min(inner, len(lines) - top)):
                put(m.win, 1 + i, 2, elide(lines[top + i], m.w - 4))
            put(m.win, m.h - 2, 2,
                f"{top + 1}-{min(len(lines), top + inner)} of {len(lines)} · Up/Down scroll · q close",
                cp(C_DIM))
            m.win.refresh()
            ch = m.win.getch()
            if ch in (ord("q"), 27, 10, 13):
                break
            if ch in (curses.KEY_DOWN, ord("j")):
                top = min(max(0, len(lines) - inner), top + 1)
            elif ch in (curses.KEY_UP, ord("k")):
                top = max(0, top - 1)
            elif ch == curses.KEY_NPAGE:
                top = min(max(0, len(lines) - inner), top + inner)
            elif ch == curses.KEY_PPAGE:
                top = max(0, top - inner)
        m.close()

    def act_radio(self, kind):
        if not self.snap:
            return
        if kind == "wwan" and not self.snap["has_wwan_hw"]:
            self.notify("No mobile (WWAN) hardware detected", C_WARN)
            return
        cur = self.snap["radio"]["wifi" if kind == "wifi" else "wwan"]
        if cur is None:
            self.notify(f"{kind} radio is not available", C_WARN)
            return
        label = "Wi-Fi" if kind == "wifi" else "WWAN"
        self.do_action("radio", a_radio, kind, not cur,
                       note=f"Switching {label} radio…",
                       success=f"{label} {'disabled' if cur else 'enabled'}")


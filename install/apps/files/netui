# ---------------------------------------------------------------------------
# System-wide proxy (environment variables + optional GNOME keys)
#
# NetworkManager's own proxy setting only knows about PAC/WPAD — it has no
# field for a plain host:port. So a manual proxy has to be set the way the
# rest of the system reads it: the *_proxy environment variables.
# ---------------------------------------------------------------------------

PROXY_ENV_KEYS = ("http_proxy", "https_proxy", "ftp_proxy", "socks_proxy",
                  "no_proxy")
PROXY_MARK_BEGIN = "# >>> netui proxy >>>"
PROXY_MARK_END = "# <<< netui proxy <<<"
SYSTEM_ENV_FILE = "/etc/environment"
USER_ENV_FILE = os.path.expanduser("~/.config/environment.d/90-netui-proxy.conf")


def proxy_env_target():
    """Where a system proxy block can actually be written."""
    if os.access(SYSTEM_ENV_FILE, os.W_OK):
        return SYSTEM_ENV_FILE
    if not os.path.exists(SYSTEM_ENV_FILE) and os.access("/etc", os.W_OK):
        return SYSTEM_ENV_FILE
    return USER_ENV_FILE


def _read_env_file(path):
    values = {}
    try:
        with open(path, "r", errors="replace") as fh:
            for line in fh:
                line = line.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                key, _, val = line.partition("=")
                key = key.strip().lower()
                if key.startswith("export "):
                    key = key[7:].strip()
                if key in PROXY_ENV_KEYS:
                    values[key] = val.strip().strip('"').strip("'")
    except OSError:
        pass
    return values


def q_system_proxy():
    """Current proxy environment: files first, live environment as a
    fallback, so the screen shows what is actually in effect."""
    values = {}
    for path in (SYSTEM_ENV_FILE, USER_ENV_FILE):
        values.update(_read_env_file(path))
    for key in PROXY_ENV_KEYS:
        if not values.get(key):
            live = os.environ.get(key) or os.environ.get(key.upper())
            if live:
                values[key] = live
    values["_target"] = proxy_env_target()
    return values


def _strip_proxy_block(text):
    out, skip = [], False
    for line in text.splitlines():
        if line.strip() == PROXY_MARK_BEGIN:
            skip = True
            continue
        if line.strip() == PROXY_MARK_END:
            skip = False
            continue
        if not skip:
            out.append(line)
    return "\n".join(out).rstrip("\n")


def apply_system_proxy(values, gnome=False):
    """Rewrite the managed proxy block. Blank fields remove the variable;
    all blank removes the block entirely."""
    path = proxy_env_target()
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
    except OSError as e:
        return 1, "", str(e)
    try:
        with open(path, "r", errors="replace") as fh:
            body = _strip_proxy_block(fh.read())
    except FileNotFoundError:
        body = ""
    except OSError as e:
        return 1, "", f"cannot read {path}: {e}"

    lines = []
    for key in PROXY_ENV_KEYS:
        val = (values.get(key) or "").strip()
        if not val:
            continue
        lines.append(f"{key}={val}")
        lines.append(f"{key.upper()}={val}")
    if lines:
        block = [PROXY_MARK_BEGIN, *lines, PROXY_MARK_END]
        body = (body + "\n\n" if body else "") + "\n".join(block)
    try:
        with open(path, "w") as fh:
            fh.write(body.rstrip("\n") + "\n")
    except OSError as e:
        return 1, "", f"cannot write {path}: {e}"

    if gnome:
        rc, _, err = _apply_gnome_proxy(values)
        if rc != 0:
            return 0, path, f"env written, gsettings failed: {err}"
    return 0, path, ""


def _split_host_port(url, default_port=8080):
    m = re.match(r"^(?:\w+://)?\[?([^\]/]+?)\]?(?::(\d+))?/?$", url.strip())
    if not m:
        return "", default_port
    return m.group(1), int(m.group(2) or default_port)


def gnome_proxy_available():
    if not shutil.which("gsettings"):
        return False
    rc, out, _ = run(["gsettings", "list-schemas"], timeout=6)
    return rc == 0 and "org.gnome.system.proxy" in out


def _apply_gnome_proxy(values):
    gs = shutil.which("gsettings")
    if not gs:
        return 1, "", "gsettings not found"
    manual = any(values.get(k) for k in ("http_proxy", "https_proxy",
                                         "ftp_proxy", "socks_proxy"))
    cmds = [[gs, "set", "org.gnome.system.proxy", "mode",
             "manual" if manual else "none"]]
    for key, schema in (("http_proxy", "org.gnome.system.proxy.http"),
                        ("https_proxy", "org.gnome.system.proxy.https"),
                        ("ftp_proxy", "org.gnome.system.proxy.ftp"),
                        ("socks_proxy", "org.gnome.system.proxy.socks")):
        val = (values.get(key) or "").strip()
        if not val:
            continue
        host, port = _split_host_port(val)
        cmds.append([gs, "set", schema, "host", host])
        cmds.append([gs, "set", schema, "port", str(port)])
    ignore = [h.strip() for h in (values.get("no_proxy") or "").split(",") if h.strip()]
    if ignore:
        arr = "[" + ", ".join(f"'{h}'" for h in ignore) + "]"
        cmds.append([gs, "set", "org.gnome.system.proxy", "ignore-hosts", arr])
    for cmd in cmds:
        rc, out, err = run(cmd, timeout=8)
        if rc != 0:
            return rc, out, err_line(rc, err, out)
    return 0, "", ""


# ---------------------------------------------------------------------------
# Dial-up (wvdial)
#
# NetworkManager dropped support for analog AT-command modems, so classic
# dial-up is driven directly through wvdial/pppd. netui only edits the
# wvdial config and supervises the process.
# ---------------------------------------------------------------------------

WVDIAL_SYSTEM = "/etc/wvdial.conf"
WVDIAL_USER = os.path.expanduser("~/.wvdialrc")

DIAL_DEFAULTS = "Defaults"


def dial_files():
    if CFG["dial_config"]:
        return [CFG["dial_config"]]
    return [p for p in (WVDIAL_SYSTEM, WVDIAL_USER) if os.path.exists(p)]


def dial_write_path():
    """wvdial reads /etc/wvdial.conf and then ~/.wvdialrc, so writing the
    user file works even without root."""
    if CFG["dial_config"]:
        return CFG["dial_config"]
    if os.access(WVDIAL_SYSTEM, os.W_OK):
        return WVDIAL_SYSTEM
    if not os.path.exists(WVDIAL_SYSTEM) and os.access("/etc", os.W_OK):
        return WVDIAL_SYSTEM
    return WVDIAL_USER


def _dial_parser():
    p = configparser.ConfigParser(strict=False, interpolation=None)
    p.optionxform = str
    return p


def _read_dial_file(path):
    parser = _dial_parser()
    try:
        with open(path, "r", errors="replace") as fh:
            parser.read_string(fh.read())
    except (OSError, configparser.Error):
        return {}
    out = {}
    for section in parser.sections():
        if not section.lower().startswith("dialer"):
            continue
        name = section.split(None, 1)[1].strip() if " " in section else DIAL_DEFAULTS
        out[name] = dict(parser[section])
    return out


def q_dialers():
    """Merged dialer list. Later files win, matching wvdial's own order."""
    merged, source = {}, {}
    for path in dial_files():
        for name, opts in _read_dial_file(path).items():
            merged.setdefault(name, {}).update(opts)
            source[name] = path
    # wvdial applies [Dialer Defaults] to every dialer, so the effective
    # settings are what the user should see — while `opts` stays the
    # section's own keys.
    base = merged.get(DIAL_DEFAULTS, {})
    rows = []
    for name in sorted(merged, key=lambda n: (n == DIAL_DEFAULTS, n.lower())):
        opts = merged[name]
        eff = opts if name == DIAL_DEFAULTS else {**base, **opts}
        rows.append({
            "kind": "dialer", "name": name, "opts": opts, "eff": eff,
            "source": source.get(name, ""),
            "phone": eff.get("Phone", ""),
            "modem": eff.get("Modem", ""),
            "user": eff.get("Username", ""),
            "is_defaults": name == DIAL_DEFAULTS,
        })
    return rows


def dial_save(name, opts):
    """Insert or replace one dialer section in the writable config."""
    path = dial_write_path()
    parser = _dial_parser()
    try:
        if os.path.exists(path):
            with open(path, "r", errors="replace") as fh:
                parser.read_string(fh.read())
    except (OSError, configparser.Error) as e:
        return 1, "", f"cannot read {path}: {e}"
    section = "Dialer Defaults" if name == DIAL_DEFAULTS else f"Dialer {name}"
    if parser.has_section(section):
        parser.remove_section(section)
    parser.add_section(section)
    for key, val in opts.items():
        if str(val).strip() != "":
            parser.set(section, key, str(val))
    try:
        os.makedirs(os.path.dirname(path) or "/", exist_ok=True)
        with open(path, "w") as fh:
            fh.write(f"# managed in part by netui {VERSION}\n")
            parser.write(fh)
        if path == WVDIAL_USER:
            os.chmod(path, 0o600)          # it holds the ISP password
    except OSError as e:
        return 1, "", f"cannot write {path}: {e}"
    return 0, path, ""


def dial_delete(name):
    section = "Dialer Defaults" if name == DIAL_DEFAULTS else f"Dialer {name}"
    removed = []
    for path in dial_files():
        if not os.access(path, os.W_OK):
            continue
        parser = _dial_parser()
        try:
            with open(path, "r", errors="replace") as fh:
                parser.read_string(fh.read())
        except (OSError, configparser.Error):
            continue
        if not parser.has_section(section):
            continue
        parser.remove_section(section)
        try:
            with open(path, "w") as fh:
                parser.write(fh)
            removed.append(path)
        except OSError as e:
            return 1, "", str(e)
    if not removed:
        return 1, "", f"“{name}” is not in a writable config file"
    return 0, ", ".join(removed), ""


def q_serial_ports():
    ports = []
    for pattern in ("/dev/ttyUSB*", "/dev/ttyACM*", "/dev/ttyS[0-3]",
                    "/dev/modem", "/dev/rfcomm*"):
        ports.extend(glob.glob(pattern))
    return sorted(set(ports))


def snapshot(rescan=False):
    devs = q_devices()
    radio = q_radio()
    wdev = next((d["device"] for d in devs if d["type"] == "wifi"), None)
    nets = q_wifi(wdev, rescan=rescan) if (wdev and radio["wifi"]) else []
    saved = q_saved()
    details = {}
    for d in devs:
        if d["state"] == "connected":
            details[d["device"]] = q_dev_details(d["device"])
    has_wwan_hw = any(d["type"] in WWAN_DEVICE_TYPES for d in devs)
    return {
        "ts": time.time(), "devices": devs, "radio": radio, "wifi_dev": wdev,
        "wifi": nets, "saved": saved, "dev_details": details,
        "plugins": q_vpn_plugins(), "modems": q_modems(),

    # -- main loop -------------------------------------------------------

    def move(self, delta):
        n = len(self.items())
        if n:
            self.sel[self.tab] = max(0, min(n - 1, self.sel[self.tab] + delta))

    def quit_ok(self):
        state, section, _ = self.dial.status()
        if state not in ("dialing", "connected"):
            return True
        if confirm_box(self.stdscr, "Quit",
                       f"“{section}” is still dialing. Hang up and quit?"):
            self.dial.stop()
            return True
        return confirm_box(self.stdscr, "Quit",
                           "Leave the dial-up running and quit anyway?")

    def loop(self):
        while True:
            self.frame += 1
            self.handle_results()
            if (not self.loading and time.time() - self.last_refresh > CFG["refresh"]
                    and not self.worker.is_busy):
                self.request_refresh()
            self.draw()

            ch = self.stdscr.getch()
            if ch == -1:
                continue
            if ch in (ord("q"), ord("Q")):
                if self.quit_ok():
                    return
                continue
            if ch == curses.KEY_RESIZE:
                self.stdscr.erase()
                continue
            if ch in (curses.KEY_RIGHT, ord("l"), 9):
                self.tab = (self.tab + 1) % len(TABS)
                self.status = ""
            elif ch in (curses.KEY_LEFT, ord("h"), curses.KEY_BTAB, 353):
                self.tab = (self.tab - 1) % len(TABS)
                self.status = ""
            elif ord("1") <= ch <= ord("9") and ch - ord("1") < len(TABS):
                self.tab = ch - ord("1")
                self.status = ""
            elif ch in (curses.KEY_DOWN, ord("j")):
                self.move(1)
            elif ch in (curses.KEY_UP, ord("k")):
                self.move(-1)
            elif ch == curses.KEY_NPAGE:
                self.move(10)
            elif ch == curses.KEY_PPAGE:
                self.move(-10)
            elif ch == ord("g"):
                self.sel[self.tab] = 0
            elif ch == ord("G"):
                self.sel[self.tab] = max(0, len(self.items()) - 1)
            elif ch in (10, 13, curses.KEY_ENTER):
                self.act_enter()
            elif ch == ord("d"):
                self.act_disconnect()
            elif ch in (ord("x"), curses.KEY_DC):
                self.act_delete()
            elif ch == ord("a"):
                self.act_add()
            elif ch == ord("e"):
                self.act_edit()
            elif ch == ord("A"):
                self.act_advanced()
            elif ch == ord("p"):
                self.act_proxy()
            elif ch == ord("t"):
                self.act_toggle_auto()
            elif ch == ord("c"):
                self.act_clone()
            elif ch == ord("E"):
                self.act_export()
            elif ch == ord("i"):
                self.act_info()
            elif ch == ord("K"):
                self.act_wifi_key()
            elif ch == ord("H"):
                self.act_hotspot()
            elif ch == ord("R"):
                self.act_reapply()
            elif ch == ord("N"):
                self.act_networking()
            elif ch == ord("C"):
                self.act_connectivity()
            elif ch == ord("D"):
                self.act_diagnostics()
            elif ch == ord("w"):
                self.act_radio("wifi")
            elif ch == ord("W"):
                self.act_radio("wwan")
            elif ch == ord("/"):
                self.act_filter()
            elif ch == ord("s"):
                if self.tab == T_DIAL:
                    self.act_dial_probe()
                else:
                    self.request_refresh(rescan=True, note="Scanning Wi-Fi…")
            elif ch in (ord("r"), 18):
                self.detail_cache.clear()
                self.request_refresh(note="Refreshing…")
            elif ch == ord("L"):
                self.act_log()
            elif ch in (ord("?"), curses.KEY_F1):
                message_box(self.stdscr, "Keys", HELP_TEXT)


# ---------------------------------------------------------------------------
# Entry point
# ---------------------------------------------------------------------------

def main(stdscr, start_tab=T_WIFI):
    App(stdscr, start_tab).loop()


def disable_flow_control(fd):
    """Turn off XON/XOFF — otherwise Ctrl+S freezes terminal output.

    Returns the previous settings so they can be restored on exit.
    """
    try:
        old = termios.tcgetattr(fd)
    except (termios.error, ValueError, OSError):
        return None
    new = list(old)
    new[0] = new[0] & ~(termios.IXON | termios.IXOFF)      # iflag
    try:
        termios.tcsetattr(fd, termios.TCSANOW, new)
    except (termios.error, ValueError, OSError):
        return None
    return old


def preflight():
    if NMCLI is None:
        print("nmcli not found. Install NetworkManager and try again.",
              file=sys.stderr)
        return 1
    rc, out, err = run([NMCLI, "-t", "-f", "RUNNING", "general"], timeout=6)
    if rc != 0:
        print("NetworkManager is not responding:", err_line(rc, err, out),
              file=sys.stderr)
        return 1
    if out.strip() and out.strip() != "running":
        print("NetworkManager is not running: systemctl start NetworkManager",
              file=sys.stderr)
        return 1
    return 0


def parse_args(argv):
    ap = argparse.ArgumentParser(
        prog="netui", add_help=True,
        description="Curses front-end for NetworkManager, plus wvdial dial-up.")
    ap.add_argument("--tab", choices=sorted(TAB_NAMES), metavar="NAME",
                    help="start on this tab: " + ", ".join(sorted(TAB_NAMES)))
    ap.add_argument("--refresh", type=float, metavar="SEC",
                    help="seconds between background refreshes (default 6)")
    ap.add_argument("--no-color", action="store_true",
                    help="monochrome output")
    ap.add_argument("--no-scan", action="store_true",
                    help="do not trigger a Wi-Fi scan at startup")
    ap.add_argument("--config", metavar="FILE", default=CONFIG_PATH,
                    help=f"config file (default {CONFIG_PATH})")
    ap.add_argument("--dial-config", metavar="FILE",
                    help="wvdial config to read and write")
    ap.add_argument("--version", action="version", version=f"netui {VERSION}")
    return ap.parse_args(argv)


if __name__ == "__main__":
    args = parse_args(sys.argv[1:])
    load_config(args.config)
    if args.refresh is not None:
        CFG["refresh"] = min(120.0, max(2.0, args.refresh))
    if args.no_color:
        CFG["color"] = False
    if args.no_scan:
        CFG["scan_on_start"] = False
    if args.dial_config:
        CFG["dial_config"] = os.path.expanduser(args.dial_config)
    start_tab = TAB_NAMES.get(args.tab or CFG["start_tab"], T_WIFI)

    try:
        locale.setlocale(locale.LC_ALL, "")
    except locale.Error:
        pass
    code = preflight()
    if code:
        sys.exit(code)
    try:
        tty_fd = sys.stdin.fileno()
    except (AttributeError, ValueError):
        tty_fd = None
    saved_tty = disable_flow_control(tty_fd) if tty_fd is not None else None
    try:
        curses.wrapper(main, start_tab)
    except KeyboardInterrupt:
        pass
    finally:
        if saved_tty is not None:
            try:
                termios.tcsetattr(tty_fd, termios.TCSANOW, saved_tty)
            except (termios.error, ValueError, OSError):
                pass

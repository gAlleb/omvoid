TABS = ["Wi-Fi", "Ethernet", "VPN", "Mobile/DSL", "Adapters", "Profiles"]
T_WIFI, T_ETH, T_VPN, T_MOB, T_ADAPT, T_PROF = range(6)

STATE_LABELS = {
    "connected": "connected", "connecting": "connecting",
    "disconnected": "disconnected", "unavailable": "unavailable",
    "unmanaged": "unmanaged", "deactivating": "deactivating",

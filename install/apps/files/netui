    def act_add(self):
        if self.tab == T_WIFI:
            self.add_hidden_wifi()
        elif self.tab == T_ETH:
            self.add_ethernet()
        elif self.tab == T_VPN:
            self.add_vpn()
        elif self.tab == T_MOB:
            self.add_mobile()
        elif self.tab == T_ADAPT:
            self.notify("Adapters are detected automatically, nothing to add here", C_WARN)
        else:
            choice = select_box(self.stdscr, "New connection", [
                ("wifi", "Hidden Wi-Fi network", True, ""),
                ("ethernet", "Wired (Ethernet)", True, ""),
                ("vpn", "VPN", True, ""),
                ("mobile", "Mobile / PPPoE", True, ""),
            ])
            if choice == "wifi":
                self.add_hidden_wifi()
            elif choice == "ethernet":
                self.add_ethernet()
            elif choice == "vpn":
                self.add_vpn()
            elif choice == "mobile":
                self.add_mobile()

    def add_hidden_wifi(self):
        options = [(k, l, True, "") for k, l in WIFI_SEC_CHOICES if k != "auto"]
        sectype = select_box(self.stdscr, "Hidden network security", options,
                             footer="Enter select · Esc cancel")
        if sectype is None:
            return
        ssid_field = _f("ssid", "Network name (SSID)", required=True)
        if sectype == "open":
            fields = [ssid_field]
        elif sectype == "wpa-eap":

def create_wifi_manual(name, ssid, iface, security, values, hidden=False):
    """Build a Wi-Fi profile with an explicitly chosen security type and
    bring it up. Used whenever the user overrides auto-detection — covers
    WPA3-SAE, WEP, and 802.1x Enterprise, none of which
    `nmcli device wifi connect` can express on its own."""
    # A previous failed attempt (e.g. wrong password) can leave a same-named
    # broken profile behind; replace it instead of piling up duplicates.
    for c in q_saved():
        if c["name"] == name and c["type"] in WIFI_TYPES:
            a_con_delete(c["uuid"])
            break

    args = ["connection", "add", "type", "wifi", "con-name", name,
            "ifname", iface or "*", "ssid", ssid]
    if hidden:
        args += ["802-11-wireless.hidden", "yes"]

    if security == "wpa-psk":
        args += ["wifi-sec.key-mgmt", "wpa-psk"]
    elif security == "sae":
        args += ["wifi-sec.key-mgmt", "sae"]
    elif security == "wep":
        args += ["wifi-sec.key-mgmt", "none", "wifi-sec.wep-key-type", "1"]
    elif security == "wpa-eap":
        args += ["wifi-sec.key-mgmt", "wpa-eap",
                 "802-1x.eap", values.get("eap", "peap"),
                 "802-1x.identity", values.get("identity", "")]
        if values.get("anon_identity"):
            args += ["802-1x.anonymous-identity", values["anon_identity"]]
        if values.get("ca_cert"):
            args += ["802-1x.ca-cert", os.path.expanduser(values["ca_cert"])]
        phase2 = values.get("phase2", "default")
        if phase2 and phase2 != "default":
            args += ["802-1x.phase2-auth", phase2]
    # "open" needs no security properties at all.

    rc, out, err = nm(*args, timeout=25)
    if rc != 0:
        return rc, out, err

    secret_mods = []
    if security in ("wpa-psk", "sae"):
        secret_mods += ["wifi-sec.psk", values.get("password", ""), "wifi-sec.psk-flags", "0"]
    elif security == "wep":
        secret_mods += ["wifi-sec.wep-key0", values.get("password", ""), "wifi-sec.wep-key-flags", "0"]
    elif security == "wpa-eap":
        secret_mods += ["802-1x.password", values.get("password", ""), "802-1x.password-flags", "0"]
    if secret_mods:
        rc2, out2, err2 = nm("connection", "modify", name, *secret_mods, timeout=20)
        if rc2 != 0:
            return rc2, out2, err2

    return a_con_up(name)


def a_radio(kind, on):
    return nm("radio", kind, "on" if on else "off", timeout=10)


def a_autoconnect(ident, on):
    return nm("connection", "modify", ident,
              "connection.autoconnect", "yes" if on else "no", timeout=15)


def err_line(rc, err, out=""):
    text = (err or "").strip() or (out or "").strip()
    if not text:
        return f"nmcli exited with code {rc}"
    lines = [l.strip() for l in text.splitlines() if l.strip()]
    return lines[-1] if lines else f"code {rc}"



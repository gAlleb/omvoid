    def act_log(self):
        if not self.log:
            message_box(self.stdscr, "Log", ["No events yet."])
            return
        self.pager("Event log", [f"{t}  {msg}" for t, msg in reversed(self.log)])

    # -- main loop -------------------------------------------------------

    def move(self, delta):
        n = len(self.items())
        if n:
            self.sel[self.tab] = max(0, min(n - 1, self.sel[self.tab] + delta))

    def loop(self):
        while True:
            self.frame += 1
            self.handle_results()
            if (not self.loading and time.time() - self.last_refresh > REFRESH_INTERVAL
                    and not self.worker.is_busy):
                self.request_refresh()
            self.draw()

            ch = self.stdscr.getch()
            if ch == -1:
                continue
            if ch in (ord("q"), ord("Q")):
                return
            if ch == curses.KEY_RESIZE:
                self.stdscr.erase()
                continue
            if ch in (curses.KEY_RIGHT, ord("l"), 9):
                self.tab = (self.tab + 1) % len(TABS)
                self.status = ""
            elif ch in (curses.KEY_LEFT, ord("h"), curses.KEY_BTAB, 353):
                self.tab = (self.tab - 1) % len(TABS)
                self.status = ""
            elif ord("1") <= ch <= ord(str(len(TABS))):
                self.tab = ch - ord("1")
                self.status = ""
            elif ch in (curses.KEY_DOWN, ord("j")):
                self.move(1)
            elif ch in (curses.KEY_UP, ord("k")):
                self.move(-1)
            elif ch == curses.KEY_NPAGE:
                self.move(10)
            elif ch == curses.KEY_PPAGE:
                self.move(-10)
            elif ch == ord("g"):
                self.sel[self.tab] = 0
            elif ch == ord("G"):
                self.sel[self.tab] = max(0, len(self.items()) - 1)
            elif ch in (10, 13, curses.KEY_ENTER):
                self.act_enter()
            elif ch == ord("d"):
                self.act_disconnect()
            elif ch in (ord("x"), curses.KEY_DC):
                self.act_delete()
            elif ch == ord("a"):
                self.act_add()
            elif ch == ord("e"):
                self.act_edit()
            elif ch == ord("A"):
                self.act_advanced()
            elif ch == ord("t"):
                self.act_toggle_auto()
            elif ch == ord("i"):
                self.act_info()
            elif ch == ord("w"):
                self.act_radio("wifi")
            elif ch == ord("W"):
                self.act_radio("wwan")
            elif ch == ord("s"):
                self.request_refresh(rescan=True, note="Scanning Wi-Fi…")
            elif ch in (ord("r"), 18):
                self.detail_cache.clear()
                self.request_refresh(note="Refreshing…")
            elif ch == ord("L"):
                self.act_log()
            elif ch in (ord("?"), curses.KEY_F1):
                message_box(self.stdscr, "Keys", HELP_TEXT)


def main(stdscr):
    App(stdscr).loop()


def disable_flow_control(fd):
    """Turn off XON/XOFF — otherwise Ctrl+S freezes terminal output.

    Returns the previous settings so they can be restored on exit.
    """
    try:
        old = termios.tcgetattr(fd)
    except (termios.error, ValueError, OSError):
        return None
    new = list(old)
    new[0] = new[0] & ~(termios.IXON | termios.IXOFF)  # iflag
    try:
        termios.tcsetattr(fd, termios.TCSANOW, new)
    except (termios.error, ValueError, OSError):
        return None
    return old


def preflight():
    if NMCLI is None:
        print("nmcli not found. Install NetworkManager and try again.",
              file=sys.stderr)
        return 1
    rc, out, err = run([NMCLI, "-t", "-f", "RUNNING", "general"], timeout=6)
    if rc != 0:
        print("NetworkManager is not responding:", err_line(rc, err, out), file=sys.stderr)
        return 1
    if out.strip() and out.strip() != "running":
        print("The NetworkManager service is not running: systemctl start NetworkManager",
              file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    try:
        locale.setlocale(locale.LC_ALL, "")
    except locale.Error:
        pass
    code = preflight()
    if code:
        sys.exit(code)
    try:
        tty_fd = sys.stdin.fileno()
    except (AttributeError, ValueError):
        tty_fd = None
    saved_tty = disable_flow_control(tty_fd) if tty_fd is not None else None
    try:
        curses.wrapper(main)
    except KeyboardInterrupt:
        pass
    finally:
        if saved_tty is not None:
            try:
                termios.tcsetattr(tty_fd, termios.TCSANOW, saved_tty)
            except (termios.error, ValueError, OSError):
                pass

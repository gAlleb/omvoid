def edit_and_maybe_reapply(uuid, values, device=""):
    """Save profile edits and, for a live connection, push them onto the
    running device so the user does not have to reconnect by hand."""
    rc, out, err = edit_connection(uuid, values)
    if rc != 0 or not device:
        return rc, out, err
    return a_reapply(device)


def apply_and_maybe_reapply(fn, uuid, values, known=(), device="",
                            alias=None, use_alias=False):
    args = (uuid, alias, values, known) if use_alias else (uuid, values, known)
    rc, out, err = fn(*args)
    if rc != 0 or not device:
        return rc, out, err
    return a_reapply(device)



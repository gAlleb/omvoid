# Widgets
# ---------------------------------------------------------------------------

C_NORM, C_ACCENT, C_OK, C_WARN, C_ERR, C_DIM, C_SEL = range(1, 8)
_ATTRS = {}

# Box drawing is done by hand rather than with win.box() so that every panel
# in the app shares exactly one visual language.
BOX = {"tl": "┌", "tr": "┐", "bl": "└", "br": "┘", "h": "─", "v": "│",
       "lt": "├", "rt": "┤"}

GLYPH_ON = "●"
GLYPH_OFF = "○"
GLYPH_SEL = "▸"


def init_colors():
    """A mostly monochrome attribute table.

    Coloured text is unreadable on plenty of real terminal themes, so
    structure (headers, focus, dim text, selection) uses plain attributes
    that adapt to the user's palette, and colour is kept for state.
    """
    has_color = False
    if CFG["color"]:
        try:
            curses.start_color()
            curses.use_default_colors()
            has_color = curses.has_colors()
        except curses.error:
            has_color = False

    if has_color:
        try:
            curses.init_pair(1, curses.COLOR_GREEN, -1)
            curses.init_pair(2, curses.COLOR_YELLOW, -1)
            curses.init_pair(3, curses.COLOR_RED, -1)
        except curses.error:
            has_color = False

    global _ATTRS
    _ATTRS = {
        C_NORM: curses.A_NORMAL,
        C_ACCENT: curses.A_BOLD,
        C_OK: (curses.color_pair(1) | curses.A_BOLD) if has_color else curses.A_BOLD,
        C_WARN: (curses.color_pair(2) | curses.A_BOLD) if has_color
                else curses.A_BOLD | curses.A_UNDERLINE,
        C_ERR: (curses.color_pair(3) | curses.A_BOLD) if has_color
               else curses.A_BOLD | curses.A_REVERSE,
        C_DIM: curses.A_DIM,
        C_SEL: curses.A_REVERSE,
    }


def cp(pair):
    return _ATTRS.get(pair, curses.A_NORMAL)


def put(win, y, x, text, attr=0):
    """Safe output: clips to width, swallows curses.error."""
    try:
        h, w = win.getmaxyx()
    except curses.error:
        return
    if y < 0 or y >= h or x < 0 or x >= w:
        return
    avail = w - x
    if avail <= 0:
        return
    s = text[:avail]
    if y == h - 1 and x + len(s) >= w:
        # Writing the very last cell moves the cursor out of the window.
        try:
            win.insstr(y, x, s, attr)
        except curses.error:
            pass
        return
    try:
        win.addstr(y, x, s, attr)
    except curses.error:
        pass


def dwidth(text):
    """Display width in terminal cells. Emoji and CJK take two columns, so
    len() alone would overflow every row that contains one."""
    total = 0
    for ch in str(text):
        if unicodedata.combining(ch):
            continue
        total += 2 if unicodedata.east_asian_width(ch) in ("W", "F") else 1
    return total


def elide(text, width):
    text = str(text)
    if width <= 0:
        return ""
    if dwidth(text) <= width:
        return text
    out, used = [], 0
    for ch in text:
        cw = 0 if unicodedata.combining(ch) else (
            2 if unicodedata.east_asian_width(ch) in ("W", "F") else 1)
        if used + cw > width - 1:
            break
        out.append(ch)
        used += cw
    return "".join(out) + "…"


def dpad(text, width):
    """Pad to an exact number of cells, wide characters included."""
    return str(text) + " " * max(0, width - dwidth(text))


def wrap(text, width):
    words, lines, cur = str(text).split(), [], ""
    for word in words:
        if not cur:
            cur = word
        elif len(cur) + 1 + len(word) <= width:
            cur += " " + word
        else:
            lines.append(cur)
            cur = word
    if cur:
        lines.append(cur)
    return lines or [""]


def draw_box(win, title="", kind=C_ACCENT, badge=""):
    """Frame + optional title on the top edge and badge on the right edge."""
    h, w = win.getmaxyx()
    if h < 2 or w < 4:
        return
    put(win, 0, 0, BOX["tl"] + BOX["h"] * (w - 2) + BOX["tr"], cp(C_DIM))
    for y in range(1, h - 1):
        put(win, y, 0, BOX["v"], cp(C_DIM))
        put(win, y, w - 1, BOX["v"], cp(C_DIM))
    put(win, h - 1, 0, BOX["bl"] + BOX["h"] * (w - 2) + BOX["br"], cp(C_DIM))
    if title:
        put(win, 0, 2, " " + elide(title, w - 8) + " ", cp(kind))
    if badge:
        text = " " + elide(badge, 16) + " "
        put(win, 0, max(2, w - len(text) - 2), text, cp(C_DIM))


def draw_rule(win, y):
    h, w = win.getmaxyx()
    if 0 < y < h - 1:
        put(win, y, 0, BOX["lt"] + BOX["h"] * (w - 2) + BOX["rt"], cp(C_DIM))


def keyhint(*pairs):
    """Compact, uniform key legend: keyhint(("↵", "connect"), ("esc", "back"))"""
    return "   ".join(f"{k} {label}" for k, label in pairs)


BAR_LEVELS = [(75, "▂▄▆█"), (50, "▂▄▆·"), (25, "▂▄··"), (0, "▂···")]


def signal_bars(sig):
    if sig is None or sig < 0:
        return "····"
    for th, bars in BAR_LEVELS:
        if sig >= th:
            return bars
    return "····"


def sig_attr(sig):
    if sig is None or sig < 0:
        return cp(C_DIM)
    if sig >= 60:
        return cp(C_OK)
    if sig >= 35:
        return cp(C_WARN)
    return cp(C_ERR)


class Modal:
    """A centred window with the shared panel chrome."""

    def __init__(self, stdscr, height, width, title, kind=C_ACCENT):
        sh, sw = stdscr.getmaxyx()
        self.h = max(5, min(height, sh - 2 if sh > 6 else sh))
        self.w = max(24, min(width, sw - 2 if sw > 26 else sw))
        self.y = max(0, (sh - self.h) // 2)
        self.x = max(0, (sw - self.w) // 2)
        self.stdscr = stdscr
        self.title = title
        self.kind = kind
        self.win = curses.newwin(self.h, self.w, self.y, self.x)
        self.win.keypad(True)

    def frame(self, footer="", badge=""):
        self.win.erase()
        draw_box(self.win, self.title, self.kind, badge)
        if footer:
            draw_rule(self.win, self.h - 3)
            put(self.win, self.h - 2, 2, elide(footer, self.w - 4), cp(C_DIM))

    def close(self):
        del self.win
        self.stdscr.touchwin()
        self.stdscr.refresh()


def message_box(stdscr, title, lines, kind=C_ACCENT):
    body = []
    for line in lines:
        body.extend(wrap(line, 72) if len(str(line)) > 72 else [str(line)])
    if not body:
        body = [""]
    width = max(34, len(title) + 10, min(78, max(dwidth(l) for l in body) + 6))
    m = Modal(stdscr, len(body) + 5, width, title, kind)
    m.frame(keyhint(("esc", "close")))
    for i, line in enumerate(body[:m.h - 4]):
        put(m.win, 1 + i, 2, elide(line, m.w - 4))
    m.win.refresh()
    m.win.getch()
    m.close()


def confirm_box(stdscr, title, question, danger=False):
    lines = wrap(question, 62)
    width = max(38, min(70, max(dwidth(l) for l in lines) + 6))
    m = Modal(stdscr, len(lines) + 5, width, title, C_ERR if danger else C_WARN)
    m.frame(keyhint(("y", "confirm"), ("esc", "cancel")))
    for i, line in enumerate(lines):
        put(m.win, 1 + i, 2, line)
    m.win.refresh()
    ch = m.win.getch()
    m.close()
    return 0 <= ch < 256 and chr(ch).lower() == "y"


def select_box(stdscr, title, options, footer=None, note=""):
    """options: (value, label, enabled, hint). Returns the value or None.

    The hint is right-aligned and dimmed, so labels stay short and the
    screen stays quiet.
    """
    if not options:
        message_box(stdscr, title, ["Nothing to choose from."], C_WARN)
        return None
    footer = footer or keyhint(("↵", "select"), ("esc", "cancel"))
    label_w = max(len(o[1]) for o in options)
    hint_w = max((len(o[3]) for o in options), default=0)
    note_lines = wrap(note, 66) if note else []
    width = max(38, len(footer) + 6, min(78, label_w + hint_w + 12))
    sh, _ = stdscr.getmaxyx()
    view = max(3, min(len(options), sh - 8 - len(note_lines)))
    m = Modal(stdscr, view + len(note_lines) + 5 + (1 if note_lines else 0),
              width, title)
    sel = next((i for i, o in enumerate(options) if o[2]), 0)
    top = 0
    while True:
        top = max(0, min(top, max(0, len(options) - view)))
        if sel < top:
            top = sel
        elif sel >= top + view:
            top = sel - view + 1
        badge = f"{sel + 1}/{len(options)}" if len(options) > view else ""
        m.frame(footer, badge)
        for row in range(min(view, len(options) - top)):
            i = top + row
            value, label, enabled, hint = options[i]
            focused = i == sel
            attr = cp(C_SEL) if focused else (0 if enabled else cp(C_DIM))
            text = f" {GLYPH_SEL if focused else ' '} {label}"
            line = text.ljust(m.w - 2)
            tail = hint if enabled else (hint or "missing")
            if tail:
                tail = " " + elide(tail, max(0, m.w - len(text) - 6)) + " "
                line = line[:max(0, m.w - 2 - len(tail))] + tail
            put(m.win, 1 + row, 1, line[:m.w - 2], attr)
        if note_lines:
            draw_rule(m.win, view + 1)
            for j, line in enumerate(note_lines):
                put(m.win, view + 2 + j, 2, elide(line, m.w - 4), cp(C_DIM))
        m.win.refresh()
        ch = m.win.getch()
        if ch in (27, ord("q")):
            m.close()
            return None
        if ch in (curses.KEY_DOWN, ord("j")):
            sel = (sel + 1) % len(options)
        elif ch in (curses.KEY_UP, ord("k")):
            sel = (sel - 1) % len(options)
        elif ch == curses.KEY_NPAGE:
            sel = min(len(options) - 1, sel + view)
        elif ch == curses.KEY_PPAGE:
            sel = max(0, sel - view)
        elif ch in (curses.KEY_HOME, ord("g")):
            sel = 0
        elif ch in (curses.KEY_END, ord("G")):
            sel = len(options) - 1
        elif ch in (10, 13, curses.KEY_ENTER):
            value, label, enabled, hint = options[sel]
            if enabled:
                m.close()
                return value


class FormBox:
    """A scrolling form.

    Field kinds: text, secret, bool, choice, section (a heading), info (a
    read-only line). Every field may carry a short `hint`, shown on its own
    line while that field is focused — that is what keeps the labels
    themselves down to two or three words.
    """

    EDITABLE = ("text", "secret", "bool", "choice")

    def __init__(self, stdscr, title, fields, note=""):
        self.fields = []
        for f in fields:
            g = dict(f)
            g.setdefault("kind", "text")
            g.setdefault("hint", "")
            g.setdefault("required", False)
            if g["kind"] == "bool":
                g.setdefault("value", False)
            else:
                g.setdefault("value", "")
            if g["kind"] == "choice":
                g.setdefault("choices", [])
                if g["value"] not in g["choices"] and g["choices"]:
                    g["value"] = g["choices"][0]
            g["cursor"] = len(str(g["value"])) if g["kind"] in ("text", "secret") else 0
            g["reveal"] = False
            self.fields.append(g)
        self.order = [i for i, f in enumerate(self.fields)
                      if f["kind"] in self.EDITABLE]
        if not self.order:
            self.order = [0]
        self.title = title
        self.stdscr = stdscr
        self.error = ""
        self.note = note
        self.sel = self.order[0]
        self.top = 0

        labels = [f["label"] for f in self.fields if f["kind"] in self.EDITABLE]
        self.label_w = min(30, max([len(l) for l in labels] or [10]) + 2)
        note_lines = wrap(note, 68) if note else []
        self.note_lines = note_lines[:2]
        sh, sw = stdscr.getmaxyx()
        # top border + rows + rule + hint + notes + rule + footer + bottom
        chrome = 6 + len(self.note_lines)
        self.view = max(3, min(len(self.fields), sh - 2 - chrome))
        width = min(78, max(52, self.label_w + 34))
        self.modal = Modal(stdscr, self.view + chrome, width, title)

    # -- rendering -------------------------------------------------------

    def _shown(self, f, width):
        if f["kind"] == "bool":
            return "[✓] yes" if f["value"] else "[ ] no"
        if f["kind"] == "choice":
            return f"‹ {f['value']} ›"
        text = str(f["value"])
        if f["kind"] == "secret" and not f["reveal"]:
            text = "•" * len(text)
        if len(text) > width:
            text = "…" + text[-(width - 1):]
        return text

    def draw(self):
        w = self.modal.win
        h, mw = self.modal.h, self.modal.w
        self.top = max(0, min(self.top, max(0, len(self.fields) - self.view)))
        if self.sel < self.top:
            self.top = self.sel
        elif self.sel >= self.top + self.view:
            self.top = self.sel - self.view + 1

        badge = (f"{self.order.index(self.sel) + 1}/{len(self.order)}"
                 if len(self.fields) > self.view else "")
        secret = self.fields[self.sel]["kind"] == "secret"
        footer = keyhint(("tab", "move"), ("F10", "save"), ("esc", "cancel"))
        if secret:
            footer = keyhint(("tab", "move"), ("F9", "show"), ("F10", "save"),
                             ("esc", "cancel"))
        self.modal.frame(footer, badge)

        vw = mw - self.label_w - 5
        for row in range(min(self.view, len(self.fields) - self.top)):
            i = self.top + row
            f = self.fields[i]
            y = 1 + row
            if f["kind"] == "section":
                text = f"{f['label']} "
                put(w, y, 2, text + BOX["h"] * max(0, mw - 4 - len(text)),
                    cp(C_DIM) | curses.A_BOLD)
                continue
            if f["kind"] == "info":
                put(w, y, 2, elide(f["label"], mw - 4), cp(C_DIM))
                continue
            focused = i == self.sel
            lab = f["label"] + ("*" if f["required"] else "")
            put(w, y, 2, elide(lab, self.label_w).ljust(self.label_w),
                cp(C_ACCENT) if focused else 0)
            put(w, y, 2 + self.label_w, self._shown(f, vw).ljust(max(0, vw)),
                cp(C_SEL) if focused else 0)

        rule_y = min(1 + self.view, h - 4 - len(self.note_lines))
        draw_rule(w, rule_y)
        if self.error:
            put(w, rule_y + 1, 2, elide("⚠ " + self.error, mw - 4), cp(C_ERR))
        else:
            put(w, rule_y + 1, 2,
                elide(self.fields[self.sel].get("hint", ""), mw - 4), cp(C_DIM))
        for j, line in enumerate(self.note_lines):
            put(w, rule_y + 2 + j, 2, elide(line, mw - 4), cp(C_DIM))
        w.refresh()

    # -- behaviour -------------------------------------------------------

    def _step(self, delta):
        if self.sel not in self.order:
            self.sel = self.order[0]
            return
        idx = (self.order.index(self.sel) + delta) % len(self.order)
        self.sel = self.order[idx]

    def validate(self):
        for i in self.order:
            f = self.fields[i]
            if f["required"] and not str(f["value"]).strip():
                self.sel = i
                self.error = f"{f['label']} is required"
                return False
        self.error = ""
        return True

    def result(self):
        out = {}
        for f in self.fields:
            if f["kind"] not in self.EDITABLE:
                continue
            out[f["key"]] = f["value"] if f["kind"] == "bool" else str(f["value"]).strip()
        return out

    def run(self):
        curses.curs_set(1)
        try:
            while True:
                self.draw()
                f = self.fields[self.sel]
                ch = self.modal.win.getch()

                if ch == 27:
                    return None
                if ch in (curses.KEY_F10, curses.KEY_F2, 19):
                    if self.validate():
                        return self.result()
                    continue
                if ch == curses.KEY_F9:
                    f["reveal"] = not f.get("reveal")
                    continue
                if ch in (curses.KEY_DOWN, 9):
                    self._step(1)
                    continue
                if ch in (curses.KEY_UP, curses.KEY_BTAB, 353):
                    self._step(-1)
                    continue
                if ch in (10, 13, curses.KEY_ENTER):
                    if self.sel == self.order[-1]:
                        if self.validate():
                            return self.result()
                    else:
                        self._step(1)
                    continue
                if ch == curses.KEY_RESIZE:
                    continue

                if f["kind"] == "bool":
                    if ch in (ord(" "), ord("x"), curses.KEY_LEFT, curses.KEY_RIGHT):
                        f["value"] = not f["value"]
                    continue
                if f["kind"] == "choice":
                    if f["choices"]:
                        idx = (f["choices"].index(f["value"])
                               if f["value"] in f["choices"] else 0)
                        if ch in (curses.KEY_RIGHT, ord(" ")):
                            f["value"] = f["choices"][(idx + 1) % len(f["choices"])]
                        elif ch == curses.KEY_LEFT:
                            f["value"] = f["choices"][(idx - 1) % len(f["choices"])]
                    continue

                s = str(f["value"])
                cur = min(f["cursor"], len(s))
                if ch in (curses.KEY_BACKSPACE, 127, 8):
                    if cur > 0:
                        f["value"] = s[:cur - 1] + s[cur:]
                        f["cursor"] = cur - 1
                elif ch == curses.KEY_DC:
                    f["value"] = s[:cur] + s[cur + 1:]
                elif ch == curses.KEY_LEFT:
                    f["cursor"] = max(0, cur - 1)
                elif ch == curses.KEY_RIGHT:
                    f["cursor"] = min(len(s), cur + 1)
                elif ch == curses.KEY_HOME:
                    f["cursor"] = 0
                elif ch == curses.KEY_END:
                    f["cursor"] = len(s)
                elif ch == 21:                                  # Ctrl+U
                    f["value"], f["cursor"] = "", 0
                elif ch == 23:                                  # Ctrl+W
                    head = s[:cur].rstrip()
                    head = head[:head.rfind(" ") + 1] if " " in head else ""
                    f["value"], f["cursor"] = head + s[cur:], len(head)
                elif 32 <= ch <= 126 or ch > 255:
                    try:
                        c = chr(ch)
                    except ValueError:
                        continue
                    f["value"] = s[:cur] + c + s[cur:]
                    f["cursor"] = cur + 1
        finally:
            curses.curs_set(0)
            self.modal.close()


def ask_line(stdscr, title, label, value="", secret=False, hint="", required=True):
    """One-field prompt: filter text, a new profile name, a file path."""
    form = FormBox(stdscr, title, [
        _f("value", label, "secret" if secret else "text",
           value=value, required=required, hint=hint)])
    res = form.run()
    return None if res is None else res["value"]


def pager(stdscr, title, lines, footer=None):
    sh, sw = stdscr.getmaxyx()
    width = min(max(40, sw - 4), max([dwidth(l) for l in lines] or [40]) + 6)
    m = Modal(stdscr, sh - 2, width, title)
    footer = footer or keyhint(("↑↓", "scroll"), ("esc", "close"))
    view = m.h - 4
    top = 0
    while True:
        top = max(0, min(top, max(0, len(lines) - view)))
        m.frame(footer, f"{top + 1}-{min(len(lines), top + view)}/{len(lines)}")
        for i in range(min(view, len(lines) - top)):
            put(m.win, 1 + i, 2, elide(lines[top + i], m.w - 4))
        m.win.refresh()
        ch = m.win.getch()
        if ch in (ord("q"), 27, 10, 13):
            break
        if ch in (curses.KEY_DOWN, ord("j")):
            top += 1
        elif ch in (curses.KEY_UP, ord("k")):
            top -= 1
        elif ch == curses.KEY_NPAGE:
            top += view
        elif ch == curses.KEY_PPAGE:
            top -= view
        elif ch in (ord("g"), curses.KEY_HOME):
            top = 0
        elif ch in (ord("G"), curses.KEY_END):
            top = len(lines)
    m.close()



# Security types the user can pick explicitly instead of relying on
# `nmcli device wifi connect`'s built-in auto-negotiation, which only
# handles plain WPA/WPA2-PSK and can't do 802.1x Enterprise at all.
WIFI_SEC_CHOICES = [
    ("auto", "Auto-detect (recommended)"),
    ("wpa-psk", "WPA / WPA2 Personal"),
    ("sae", "WPA3 Personal (SAE)"),
    ("wpa-eap", "WPA / WPA2 Enterprise (802.1x)"),
    ("wep", "WEP (legacy)"),
]


def guess_wifi_security(security_str):
    """Best-effort guess of which explicit security type matches what the
    scan reported, so the picker can pre-highlight it. Always overridable
    by the user — this is only a starting point."""
    s = (security_str or "").lower()
    if "802.1x" in s or "eap" in s:
        return "wpa-eap"
    if "wep" in s:
        return "wep"
    if "wpa3" in s or "sae" in s:
        return "sae"
    if "wpa" in s:
        return "wpa-psk"
    return "wpa-psk"



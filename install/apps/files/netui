def _qr_escape(text):
    out = []
    for ch in str(text):
        if ch in "\\;,:\"":
            out.append("\\")
        out.append(ch)
    return "".join(out)


def wifi_qr(ssid, psk, hidden=False):
    """Return (payload, rendered_lines). Rendering needs qrencode; without
    it the payload alone is still useful — phones accept it as text."""
    kind = "WPA" if psk else "nopass"
    payload = (f"WIFI:S:{_qr_escape(ssid)};T:{kind};"
               f"P:{_qr_escape(psk)};{'H:true;' if hidden else ''};")
    if not QRENCODE:
        return payload, []
    rc, out, _ = run([QRENCODE, "-t", "UTF8", "-m", "1", "-o", "-", payload],
                     timeout=10)
    return payload, out.splitlines() if rc == 0 else []


def diagnostics():
    """A short connectivity report, safe to run on a worker thread."""
    lines = []
    g = q_general()
    lines.append(f"NetworkManager   state {g['state']}, connectivity {g['connectivity']}")
    net = q_networking()
    lines.append(f"Networking       {'enabled' if net else 'disabled' if net is False else 'unknown'}")
    lines.append("")

    gw = ""
    for dev in q_devices():
        if dev["state"] != "connected":
            continue
        det = q_dev_details(dev["device"])
        addr = det.get("IP4.ADDRESS[1]", "")
        route = det.get("IP4.GATEWAY", "")
        lines.append(f"{dev['device']:<16} {addr or '-'}"
                     + (f"  via {route}" if route not in ("", "--") else ""))
        if route not in ("", "--") and not gw:
            gw = route
    if not gw:
        lines.append("No default gateway found.")
    lines.append("")

    ping = shutil.which("ping")
    targets = [(gw, "gateway"), ("1.1.1.1", "internet")]
    for host, label in targets:
        if not host:
            continue
        if not ping:
            lines.append(f"ping {host:<16} ping(8) not installed")
            continue
        rc, out, _ = run([ping, "-n", "-c", "3", "-W", "2", host], timeout=20)
        m = re.search(r"=\s*([\d.]+)/([\d.]+)/([\d.]+)", out)
        loss = re.search(r"(\d+(?:\.\d+)?)%\s*packet loss", out)
        if rc == 0 and m:
            lines.append(f"ping {host:<16} {label}: avg {m.group(2)} ms, "
                         f"loss {loss.group(1) if loss else '0'}%")
        else:
            lines.append(f"ping {host:<16} {label}: no reply")
    lines.append("")

    servers = []
    try:
        with open("/etc/resolv.conf", "r", errors="replace") as fh:
            servers = [l.split()[1] for l in fh
                       if l.startswith("nameserver") and len(l.split()) > 1]
    except OSError:
        pass
    lines.append("DNS servers      " + (", ".join(servers) or "none in /etc/resolv.conf"))
    t0 = time.time()
    try:
        socket.setdefaulttimeout(4)
        socket.getaddrinfo("example.org", 80)
        lines.append(f"DNS lookup       example.org resolved in "
                     f"{int((time.time() - t0) * 1000)} ms")
    except Exception as e:
        lines.append(f"DNS lookup       failed: {e}")
    finally:
        socket.setdefaulttimeout(None)

    proxy = q_system_proxy()
    active = [f"{k}={v}" for k, v in proxy.items()
              if k in PROXY_ENV_KEYS and v]
    lines.append("System proxy     " + (", ".join(active) or "not set"))
    if g["connectivity"] == "portal":
        lines += ["", "A captive portal is intercepting traffic — open a browser to log in."]
    return lines



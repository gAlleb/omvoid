def apply_proxy(uuid, values, known=()):
    """NetworkManager's proxy setting is PAC-only: method none or auto, plus
    a PAC URL. There is no manual host:port here by design."""
    mods = ["proxy.method", values.get("method", "none"),
            "proxy.pac-url", values.get("pac_url", "").strip(),
            "proxy.browser-only", "yes" if values.get("browser_only") else "no"]
    return nm("connection", "modify", uuid, *mods, timeout=20)


def apply_secret_flags(uuid, con_type, flag):
    """0 stores the secret in the profile, 1 hands it to the agent, 2 asks
    every time, 4 never stores it."""
    props = {"802-11-wireless": ["802-11-wireless-security.psk-flags",
                                 "802-1x.password-flags"],
             "wifi": ["802-11-wireless-security.psk-flags"],
             "vpn": ["vpn.secrets"],
             "gsm": ["gsm.password-flags"],
             "cdma": ["cdma.password-flags"],
             "pppoe": ["pppoe.password-flags"]}.get(con_type, [])
    props = [p for p in props if p.endswith("-flags")]
    if not props:
        return 2, "", "this connection type has no password flags to change"
    mods = []
    for prop in props:
        mods += [prop, str(flag)]
    return nm("connection", "modify", uuid, *mods, timeout=20)



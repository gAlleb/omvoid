C_NORM, C_ACCENT, C_OK, C_WARN, C_ERR, C_DIM, C_SEL = range(1, 8)
_ATTRS = {}


def init_colors():
    """Build a mostly monochrome attribute table.

    Coloured text (blue/cyan especially) is unreadable on a lot of real
    terminal themes — light backgrounds, Solarized, etc. So structural
    elements (headers, focus, dim text, selection) use plain attributes
    (bold / dim / reverse) that always adapt to the user's palette, and
    colour is reserved for a handful of clearly semantic states.
    """
    has_color = False
    try:
        curses.start_color()
        curses.use_default_colors()
        has_color = curses.has_colors()
    except curses.error:
        has_color = False

    if has_color:
        try:
            curses.init_pair(1, curses.COLOR_GREEN, -1)
            curses.init_pair(2, curses.COLOR_YELLOW, -1)
            curses.init_pair(3, curses.COLOR_RED, -1)
        except curses.error:
            has_color = False

    global _ATTRS
    _ATTRS = {
        C_NORM: curses.A_NORMAL,
        C_ACCENT: curses.A_BOLD,
        C_OK: (curses.color_pair(1) | curses.A_BOLD) if has_color else curses.A_BOLD,
        C_WARN: (curses.color_pair(2) | curses.A_BOLD) if has_color
                else curses.A_BOLD | curses.A_UNDERLINE,
        C_ERR: (curses.color_pair(3) | curses.A_BOLD) if has_color
               else curses.A_BOLD | curses.A_REVERSE,
        C_DIM: curses.A_DIM,
        C_SEL: curses.A_REVERSE,
    }


def cp(pair):
    return _ATTRS.get(pair, curses.A_NORMAL)


def put(win, y, x, text, attr=0):
    """Safe output: clips to width, swallows curses.error."""
    try:
        h, w = win.getmaxyx()
    except curses.error:
        return
    if y < 0 or y >= h or x < 0 or x >= w:
        return
    avail = w - x
    if avail <= 0:
        return
    s = text[:avail]
    if y == h - 1 and x + len(s) >= w:
        s = s[:max(0, avail - 1)]
    try:
        win.addstr(y, x, s, attr)
    except curses.error:
        pass


def draw_frame(win, title="", attr=0, title_attr=None):
    try:
        win.box()
    except curses.error:
        pass
    if title:
        put(win, 0, 2, f" {title} ", title_attr if title_attr is not None else attr)


def elide(text, width):
    if width <= 0:
        return ""
    return text if len(text) <= width else text[:max(0, width - 1)] + "…"


BAR_LEVELS = [(75, "▂▄▆█"), (50, "▂▄▆·"), (25, "▂▄··"), (0, "▂···")]


def signal_bars(sig):
    if sig is None or sig < 0:
        return "····"
    for th, bars in BAR_LEVELS:
        if sig >= th:
            return bars
    return "····"


def sig_attr(sig):
    if sig is None or sig < 0:
        return cp(C_DIM)
    if sig >= 60:
        return cp(C_OK)
    if sig >= 35:
        return cp(C_WARN)
    return cp(C_ERR)


class Modal:
    """A centred window."""

    def __init__(self, stdscr, height, width, title):
        sh, sw = stdscr.getmaxyx()
        self.h = min(height, max(5, sh - 2))
        self.w = min(width, max(20, sw - 2))
        self.y = max(0, (sh - self.h) // 2)
        self.x = max(0, (sw - self.w) // 2)
        self.stdscr = stdscr
        self.title = title
        self.win = curses.newwin(self.h, self.w, self.y, self.x)
        self.win.keypad(True)

    def close(self):
        del self.win
        self.stdscr.touchwin()
        self.stdscr.refresh()


def message_box(stdscr, title, lines, kind=C_ACCENT):
    body = []
    for line in lines:
        body.extend(wrap(line, 70) or [""])
    if not body:
        body = [""]
    m = Modal(stdscr, len(body) + 4, max(30, min(76, max(len(l) for l in body) + 6)), title)
    m.win.erase()
    draw_frame(m.win, title, cp(kind))
    for i, line in enumerate(body):
        put(m.win, 1 + i, 2, line)
    put(m.win, m.h - 2, 2, "Press any key to close", cp(C_DIM))
    m.win.refresh()
    m.win.getch()
    m.close()


def confirm_box(stdscr, title, question, danger=False):
    lines = wrap(question, 60)
    m = Modal(stdscr, len(lines) + 5, max(36, min(70, max(len(l) for l in lines) + 6)), title)
    m.win.erase()
    draw_frame(m.win, title, cp(C_ERR if danger else C_WARN))
    for i, line in enumerate(lines):
        put(m.win, 1 + i, 2, line)
    put(m.win, m.h - 2, 2, "y — yes, any other key — cancel", cp(C_DIM))
    m.win.refresh()
    ch = m.win.getch()
    m.close()
    return 0 <= ch < 256 and chr(ch).lower() == "y"


def wrap(text, width):
    words, lines, cur = str(text).split(), [], ""
    for word in words:
        if not cur:
            cur = word
        elif len(cur) + 1 + len(word) <= width:
            cur += " " + word
        else:
            lines.append(cur)
            cur = word
    if cur:
        lines.append(cur)
    return lines or [""]


def select_box(stdscr, title, options, footer="Enter — select, Esc — cancel"):
    """options: list of (value, label, enabled, hint). Returns value or None."""
    labels = [f"{lab}" + (f"   {hint}" if hint else "") for _, lab, _, hint in options]
    width = max(40, min(76, max(len(l) for l in labels) + 8, max(len(title) + 8, len(footer) + 6)))
    m = Modal(stdscr, len(options) + 4, width, title)
    sel = next((i for i, o in enumerate(options) if o[2]), 0)
    while True:
        m.win.erase()
        draw_frame(m.win, title, cp(C_ACCENT))
        for i, (value, label, enabled, hint) in enumerate(options):
            attr = cp(C_SEL) if i == sel else (0 if enabled else cp(C_DIM))
            marker = "› " if i == sel else "  "
            text = marker + label
            if hint:
                text += "  " + hint
            if not enabled:
                text += "  (not installed)"
            put(m.win, 1 + i, 1, text.ljust(m.w - 2), attr)
        put(m.win, m.h - 2, 2, elide(footer, m.w - 4), cp(C_DIM))
        m.win.refresh()
        ch = m.win.getch()
        if ch in (27, ord("q")):
            m.close()
            return None
        if ch in (curses.KEY_DOWN, ord("j")):
            sel = (sel + 1) % len(options)
        elif ch in (curses.KEY_UP, ord("k")):
            sel = (sel - 1) % len(options)
        elif ch in (10, 13, curses.KEY_ENTER):
            value, label, enabled, hint = options[sel]
            if enabled:
                m.close()
                return value


class FormBox:
    """A form with text / secret / bool / choice fields."""

    def __init__(self, stdscr, title, fields, note=""):
        self.fields = []
        for f in fields:
            g = dict(f)
            g.setdefault("kind", "text")
            g.setdefault("value", True if g["kind"] == "bool" else "")
            if g["kind"] == "choice":
                g.setdefault("choices", [])
                if not g["value"] and g["choices"]:
                    g["value"] = g["choices"][0]
            g.setdefault("required", False)
            g["cursor"] = len(str(g["value"])) if g["kind"] in ("text", "secret") else 0
            self.fields.append(g)
        self.note = note
        self.title = title
        self.stdscr = stdscr
        self.error = ""
        self.label_w = max(len(f["label"]) for f in self.fields) + 2
        note_lines = wrap(note, 66) if note else []
        height = len(self.fields) + len(note_lines) + 6
        self.note_lines = note_lines
        self.modal = Modal(stdscr, height, 76, title)
        self.sel = 0

    def _render_value(self, f, width):
        if f["kind"] == "bool":
            return "[x] yes" if f["value"] else "[ ] no"
        if f["kind"] == "choice":
            return f"‹ {f['value']} ›"
        if f["kind"] == "secret":
            return "•" * len(str(f["value"]))
        return str(f["value"])

    def draw(self):
        w = self.modal.win
        w.erase()
        draw_frame(w, self.title, cp(C_ACCENT))
        vw = self.modal.w - self.label_w - 4
        for i, f in enumerate(self.fields):
            y = 1 + i
            focused = i == self.sel
            lab = f["label"] + ("*" if f["required"] else "") + ":"
            put(w, y, 2, lab.ljust(self.label_w),
                cp(C_ACCENT) if focused else 0)
            val = self._render_value(f, vw)
            shown = val[-vw:] if len(val) > vw else val
            put(w, y, 2 + self.label_w, shown.ljust(max(0, vw)),
                cp(C_SEL) if focused else 0)
        row = 1 + len(self.fields)
        for j, line in enumerate(self.note_lines):
            put(w, row + j, 2, line, cp(C_DIM))
        row += len(self.note_lines)
        if self.error:
            put(w, row, 2, elide("⚠ " + self.error, self.modal.w - 4), cp(C_ERR))
        hint = "Enter — next field · F10 — save · Space — toggle · Esc — cancel"
        put(w, self.modal.h - 2, 2, elide(hint, self.modal.w - 4), cp(C_DIM))
        w.refresh()

    def validate(self):
        for f in self.fields:
            if f["required"] and not str(f["value"]).strip():
                self.sel = self.fields.index(f)
                self.error = f"Fill in \u201c{f['label']}\u201d"
                return False
        self.error = ""
        return True

    def result(self):
        return {f["key"]: (f["value"] if f["kind"] == "bool" else str(f["value"]).strip())
                for f in self.fields}

    def run(self):
        curses.curs_set(1)
        try:
            while True:
                self.draw()
                f = self.fields[self.sel]
                ch = self.modal.win.getch()

                if ch == 27:                                   # Esc
                    return None
                # F10 is the primary save key. Ctrl+S is a secondary option:
                # many terminals treat it as XOFF flow control, so it can't
                # be relied on alone.
                if ch in (curses.KEY_F10, curses.KEY_F2, 19):
                    if self.validate():
                        return self.result()
                    continue
                if ch in (curses.KEY_DOWN, 9):                 # Down / Tab
                    self.sel = (self.sel + 1) % len(self.fields)
                    continue
                if ch in (curses.KEY_UP, curses.KEY_BTAB, 353):
                    self.sel = (self.sel - 1) % len(self.fields)
                    continue
                if ch in (10, 13, curses.KEY_ENTER):
                    if self.sel == len(self.fields) - 1:
                        if self.validate():
                            return self.result()
                    else:
                        self.sel += 1
                    continue
                if f["kind"] == "bool":
                    if ch in (ord(" "), ord("x"), curses.KEY_LEFT, curses.KEY_RIGHT):
                        f["value"] = not f["value"]
                    continue
                if f["kind"] == "choice":
                    if f["choices"]:
                        idx = f["choices"].index(f["value"]) if f["value"] in f["choices"] else 0
                        if ch in (curses.KEY_RIGHT, ord(" ")):
                            f["value"] = f["choices"][(idx + 1) % len(f["choices"])]
                        elif ch == curses.KEY_LEFT:
                            f["value"] = f["choices"][(idx - 1) % len(f["choices"])]
                    continue

                # text field
                s = str(f["value"])
                cur = min(f["cursor"], len(s))
                if ch in (curses.KEY_BACKSPACE, 127, 8):
                    if cur > 0:
                        f["value"] = s[:cur - 1] + s[cur:]
                        f["cursor"] = cur - 1
                elif ch == curses.KEY_DC:
                    f["value"] = s[:cur] + s[cur + 1:]
                elif ch == curses.KEY_LEFT:
                    f["cursor"] = max(0, cur - 1)
                elif ch == curses.KEY_RIGHT:
                    f["cursor"] = min(len(s), cur + 1)
                elif ch == curses.KEY_HOME:
                    f["cursor"] = 0
                elif ch == curses.KEY_END:
                    f["cursor"] = len(s)
                elif ch == 21:                                  # Ctrl+U
                    f["value"], f["cursor"] = "", 0
                elif 32 <= ch <= 126 or ch > 255:
                    try:
                        c = chr(ch)
                    except ValueError:
                        continue
                    f["value"] = s[:cur] + c + s[cur:]
                    f["cursor"] = cur + 1
        finally:
            curses.curs_set(0)
            self.modal.close()



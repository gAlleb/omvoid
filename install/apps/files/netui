def _keep(known, key):
    """Only push properties this NetworkManager build actually knows about."""
    return (not known) or key in known


def apply_general(uuid, alias, values, known=()):
    mods = []
    if alias:
        mods += [f"{alias}.mtu", (values.get("mtu") or "0").strip() or "0"]
        mods += [f"{alias}.cloned-mac-address", values.get("cloned_mac", "").strip()]
    metered = {"default": "unknown", "yes": "yes", "no": "no"}.get(
        values.get("metered", "default"), "unknown")
    mods += ["connection.metered", metered]
    mods += ["connection.autoconnect-priority",
             (values.get("priority") or "0").strip() or "0"]
    mods += ["connection.zone", values.get("zone", "").strip()]
    if _keep(known, "connection.mdns") and values.get("mdns"):
        mdns = {"default": "-1", "off": "0", "resolve": "1", "yes": "2"}.get(
            values["mdns"], "-1")
        mods += ["connection.mdns", mdns]
    return nm("connection", "modify", uuid, *mods, timeout=25)


def apply_ipv4(uuid, values, known=()):
    method = values.get("method", "auto")
    if method == "manual" and not values.get("addresses", "").strip():
        return 2, "", "manual IPv4 needs an address, for example 192.168.1.50/24"
    mods = ["ipv4.method", method]
    if method == "manual":
        mods += ["ipv4.addresses", values.get("addresses", "").strip(),
                 "ipv4.gateway", values.get("gateway", "").strip()]
    else:
        mods += ["ipv4.addresses", "", "ipv4.gateway", ""]
    mods += ["ipv4.dns", values.get("dns", "").strip(),
             "ipv4.dns-search", values.get("dns_search", "").strip(),
             "ipv4.routes", values.get("routes", "").strip(),
             "ipv4.ignore-auto-dns", "yes" if values.get("ignore_auto_dns") else "no",
             "ipv4.never-default", "yes" if values.get("never_default") else "no",
             "ipv4.may-fail", "no" if values.get("required") else "yes"]
    metric = (values.get("route_metric") or "").strip()
    if metric and _keep(known, "ipv4.route-metric"):
        mods += ["ipv4.route-metric", metric]
    return nm("connection", "modify", uuid, *mods, timeout=25)


IP6_PRIVACY = {"default": "-1", "disabled": "0",
               "prefer public": "1", "prefer temporary": "2"}


def apply_ipv6(uuid, values, known=()):
    method = values.get("method", "auto")
    if method == "manual" and not values.get("addresses", "").strip():
        return 2, "", "manual IPv6 needs an address, for example fd00::5/64"
    mods = ["ipv6.method", method]
    if method == "manual":
        mods += ["ipv6.addresses", values.get("addresses", "").strip(),
                 "ipv6.gateway", values.get("gateway", "").strip()]
    else:
        mods += ["ipv6.addresses", "", "ipv6.gateway", ""]
    mods += ["ipv6.dns", values.get("dns", "").strip(),
             "ipv6.routes", values.get("routes", "").strip(),
             "ipv6.ignore-auto-dns", "yes" if values.get("ignore_auto_dns") else "no",
             "ipv6.never-default", "yes" if values.get("never_default") else "no",
             "ipv6.may-fail", "no" if values.get("required") else "yes"]

    "scan_on_start": True,   # ask for a fresh Wi-Fi scan at startup
    "color": True,
    "list_ratio": 0.52,      # width of the list pane, 0.30 .. 0.70
    "waybar_signals": ["8", "9"],
    "dial_config": "",       # override the wvdial config file
    "start_tab": "",
}


def load_config(path=CONFIG_PATH):
    """Read the optional ini config. Unknown keys and bad values are ignored
    on purpose: a broken config should never keep the tool from starting.

        [ui]
        refresh = 6            ; seconds between refreshes, 2..120
        scan_on_start = yes
        color = yes
        list_ratio = 0.52      ; width of the list pane, 0.30..0.70
        start_tab = wifi

        [waybar]
        signals = 8, 9         ; SIGRTMIN+N to poke after every change

        [dialup]
        config = ~/.wvdialrc
    """
    parser = configparser.ConfigParser()
    try:
        if not parser.read(path):
            return
    except (configparser.Error, OSError):
        return
    ui = parser["ui"] if parser.has_section("ui") else {}
    for key, cast in (("refresh", float), ("list_ratio", float)):
        if key in ui:
            try:
                CFG[key] = cast(ui[key])
            except ValueError:
                pass
    for key in ("scan_on_start", "color"):
        if key in ui:
            CFG[key] = str(ui[key]).strip().lower() in ("1", "yes", "true", "on")
    if "start_tab" in ui:
        CFG["start_tab"] = str(ui["start_tab"]).strip()
    if parser.has_option("waybar", "signals"):
        sigs = [s.strip() for s in parser.get("waybar", "signals").split(",")]
        CFG["waybar_signals"] = [s for s in sigs if s.isdigit()]
    if parser.has_option("dialup", "config"):
        CFG["dial_config"] = os.path.expanduser(parser.get("dialup", "config"))
    CFG["refresh"] = min(120.0, max(2.0, CFG["refresh"]))
    CFG["list_ratio"] = min(0.70, max(0.30, CFG["list_ratio"]))


# ---------------------------------------------------------------------------
# nmcli: execution and terse-output parsing
# ---------------------------------------------------------------------------

def run(args, timeout=15, input_text=None):
    """Run a command, return (returncode, stdout, stderr). Never raises."""
    try:
        p = subprocess.run(args, capture_output=True, text=True,
                           timeout=timeout, input=input_text)
        return p.returncode, p.stdout, p.stderr
    except subprocess.TimeoutExpired:
        return 124, "", "nmcli timed out"
    except FileNotFoundError:
        return 127, "", "command not found"
    except Exception as e:  # pragma: no cover - defensive
        return 1, "", str(e)


def nm(*args, timeout=15):
    return run([NMCLI, *args], timeout=timeout)


def nmt(*args, timeout=15):
    return run([NMCLI, "-t", *args], timeout=timeout)


def split_terse(line, maxsplit=-1):
    """Split one line of `nmcli -t` output on *unescaped* ':' and unescape
    '\\:' and '\\\\'. nmcli escapes literal colons inside field values (SSIDs,
    BSSIDs, connection names, IPv6 addresses), so a naive line.split(':')
    corrupts any value containing a colon."""
    fields, cur = [], []
    i, n = 0, len(line)
    while i < n:
        c = line[i]
        if c == "\\" and i + 1 < n and line[i + 1] in (":", "\\"):
            cur.append(line[i + 1])
            i += 2
            continue
        if c == ":" and (maxsplit < 0 or len(fields) < maxsplit):
            fields.append("".join(cur))
            cur = []
            i += 1
            continue
        cur.append(c)
        i += 1
    fields.append("".join(cur))
    return fields


def parse_terse(output):
    return [split_terse(l) for l in output.splitlines() if l != ""]


def pad(fields, n):
    f = list(fields)
    return f + [""] * (n - len(f)) if len(f) < n else f


def esc_value(v):
    """Escape a value for key=value pairs inside vpn.data / vpn.secrets."""
    return str(v).replace(",", r"\,").replace("=", r"\=")


def notify_waybar():
    """Poke waybar so its custom/network modules redraw. Signal numbers come
    from the config ([waybar] signals = 8,9). Best-effort and silent."""
    for sig in CFG["waybar_signals"]:
        try:
            subprocess.run(["pkill", f"-RTMIN+{sig}", "waybar"],
                           capture_output=True)
        except Exception:
            pass



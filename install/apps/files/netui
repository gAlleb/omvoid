def apply_ip_settings(ident, values):
    mods = []
    m4 = values.get("ipv4_method", "auto")
    if m4 == "manual" and not values.get("ipv4_addr", "").strip():
        return 2, "", "IPv4 = manual requires an address, e.g. 192.168.1.50/24"
    mods += ["ipv4.method", m4]
    if m4 == "manual":
        mods += ["ipv4.addresses", values.get("ipv4_addr", "")]
        if values.get("ipv4_gw"):
            mods += ["ipv4.gateway", values["ipv4_gw"]]
    else:
        mods += ["ipv4.addresses", "", "ipv4.gateway", ""]
    mods += ["ipv4.dns", values.get("dns", "")]
    mods += ["ipv6.method", values.get("ipv6_method", "auto")]
    if "autoconnect" in values:
        mods += ["connection.autoconnect", "yes" if values["autoconnect"] else "no"]
    return nm("connection", "modify", ident, *mods, timeout=20)


def edit_connection(ident, values):
    mods = []
    if values.get("name"):
        mods += ["connection.id", values["name"]]
    if mods:
        rc, out, err = nm("connection", "modify", ident, *mods, timeout=15)
        if rc != 0:
            return rc, out, err
        ident = values["name"]
    return apply_ip_settings(ident, values)


# nmcli accepts these short aliases in place of the full setting name.
TYPE_ALIAS = {"802-3-ethernet": "ethernet", "802-11-wireless": "wifi"}


def apply_advanced(uuid, alias, values):
    """Apply the "Advanced" settings screen (MTU, cloned MAC, routes, DNS
    search, ignore-auto-dns, never-default, IPv4-required, metered,
    autoconnect priority, firewall zone) to an existing profile.

    These map directly to NetworkManager connection properties; blank/0
    generally means "use the default" for that property.
    """
    mods = []
    if alias:
        mtu = values.get("mtu", "0").strip() or "0"
        mods += [f"{alias}.mtu", mtu]
        mods += [f"{alias}.cloned-mac-address", values.get("cloned_mac", "").strip()]
    mods += ["ipv4.routes", values.get("routes", "").strip()]
    mods += ["ipv4.dns-search", values.get("dns_search", "").strip()]
    mods += ["ipv4.ignore-auto-dns", "yes" if values.get("ignore_auto_dns") else "no"]
    mods += ["ipv4.never-default", "yes" if values.get("never_default") else "no"]
    mods += ["ipv4.may-fail", "no" if values.get("ipv4_required") else "yes"]
    metered_val = {"default": "unknown", "yes": "yes", "no": "no"}.get(
        values.get("metered", "default"), "unknown")
    mods += ["connection.metered", metered_val]
    priority = values.get("priority", "0").strip() or "0"
    mods += ["connection.autoconnect-priority", priority]
    mods += ["connection.zone", values.get("zone", "").strip()]
    return nm("connection", "modify", uuid, *mods, timeout=20)


# ---------------------------------------------------------------------------
# Background worker: curses lives on the main thread only
# ---------------------------------------------------------------------------

class Worker:
    def __init__(self):
        self.jobs = queue.Queue()
        self.results = queue.Queue()
        self.busy = 0
        self._lock = threading.Lock()
        self.thread = threading.Thread(target=self._loop, daemon=True)
        self.thread.start()

    def submit(self, tag, fn, *args, **kwargs):
        with self._lock:
            self.busy += 1
        self.jobs.put((tag, fn, args, kwargs))

    def _loop(self):
        while True:
            tag, fn, args, kwargs = self.jobs.get()
            try:
                value, error = fn(*args, **kwargs), None
            except Exception as e:  # pragma: no cover
                value, error = None, e
            with self._lock:
                self.busy -= 1
            self.results.put((tag, value, error))

    def poll(self):
        out = []
        while True:
            try:
                out.append(self.results.get_nowait())
            except queue.Empty:
                return out

    @property
    def is_busy(self):
        with self._lock:
            return self.busy > 0



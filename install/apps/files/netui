def create_vpn(vpn_type, name, values):
    spec = VPN_SPECS[vpn_type]

    if spec.get("import"):
        path = os.path.expanduser(values["file"].strip())
        if not os.path.isfile(path):
            return 1, "", f"file not found: {path}"
        rc, out, err = nm("connection", "import", "type", spec["import"],
                          "file", path, timeout=30)
        if rc != 0:
            return rc, out, err
        if name:
            # nmcli names the profile after the file — rename if requested
            base = os.path.splitext(os.path.basename(path))[0]
            if name != base:
                nm("connection", "modify", base, "connection.id", name, timeout=10)
        return 0, out, err

    data = spec["data"](values)
    data_str = ", ".join(f"{k}={esc_value(v)}" for k, v in data.items() if v != "")
    rc, out, err = nm("connection", "add", "type", "vpn", "vpn-type", vpn_type,
                      "con-name", name, "ifname", "*",
                      "vpn.data", data_str, timeout=25)
    if rc != 0:
        return rc, out, err

    secrets = spec["secrets"](values)
    if secrets:
        sec_str = ", ".join(f"{k}={esc_value(v)}" for k, v in secrets.items())
        rc2, out2, err2 = nm("connection", "modify", name,
                             "vpn.secrets", sec_str, timeout=20)
        if rc2 != 0:
            return rc2, out2, err2
    return 0, out, err



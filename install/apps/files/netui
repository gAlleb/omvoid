    def dial_form(self, item=None):
        opts = item["eff"] if item else {}
        ports = self.snap["ports"] if self.snap else []
        modem = opts.get("Modem") or (ports[0] if ports else "/dev/ttyUSB0")
        bauds = ["115200", "57600", "38400", "19200", "9600", "230400", "460800"]
        baud = opts.get("Baud", "115200")
        if baud not in bauds:
            bauds.insert(0, baud)
        dial_cmd = opts.get("Dial Command", "ATDT")
        fields = [
            _f("name", "Dialer name", required=True, value=item["name"] if item else "",
               hint="Used as the wvdial section, e.g. “isp”"),
            _f("modem", "Modem device", value=modem, required=True,
               hint="Detected: " + (", ".join(ports[:3]) if ports else "none")),
            _f("baud", "Baud rate", "choice", choices=bauds, value=baud),
            _f("phone", "Phone number", required=True, value=opts.get("Phone", "")),
            _f("user", "Username", value=opts.get("Username", "")),
            _f("password", "Password", "secret", value=opts.get("Password", "")),
            _f("mode", "Dial mode", "choice", choices=["tone", "pulse"],
               value="pulse" if dial_cmd.upper().startswith("ATDP") else "tone"),
            _f("", "Advanced", "section"),
            _f("init2", "Init string", value=opts.get("Init2", "ATQ0 V1 E1 S0=0 &C1 &D2"),
               hint="Modem AT init; the default suits most modems"),
            _f("stupid", "Stupid mode", "bool", value=opts.get("Stupid Mode", "0") in ("1", "yes", "on"),
               hint="Start PPP at once, for servers with no login prompt"),
            _f("autodns", "Use ISP DNS", "bool",
               value=opts.get("Auto DNS", "1") in ("1", "yes", "on")),
        ]
        return FormBox(self.stdscr, "Dial-up" if not item else f"Edit · {item['name']}",
                       fields, note=f"Saved to {dial_write_path()}").run()

    def add_dialer(self, item=None):
        if not WVDIAL:
            message_box(self.stdscr, "Dial-up",
                        ["wvdial is not installed.",
                         "Install wvdial and pppd to use dial-up."], C_WARN)
            return
        res = self.dial_form(item)
        if not res:
            return
        opts = {
            "Modem": res["modem"], "Baud": res["baud"],
            "Modem Type": "Analog Modem", "ISDN": "0",
            "Init1": "ATZ", "Init2": res["init2"],
            "Phone": res["phone"], "Username": res["user"] or "user",
            "Password": res["password"] or "pass",
            "Dial Command": "ATDP" if res["mode"] == "pulse" else "ATDT",
            "Stupid Mode": "1" if res["stupid"] else "0",
            "Auto DNS": "1" if res["autodns"] else "0",
            "New PPPD": "yes",
        }
        old = item["name"] if item else None
        rc, path, err = dial_save(res["name"], opts)
        if rc != 0:
            self.notify(err, C_ERR)
            return
        if old and old != res["name"]:
            dial_delete(old)
        self.notify(f"“{res['name']}” saved to {path}", C_OK)
        self.request_refresh()

    def act_dial(self, item, hangup_only=False):
        state, section, _ = self.dial.status()
        live = state in ("dialing", "connected")
        if live and section == item["name"]:
            if not confirm_box(self.stdscr, "Hang up", f"Disconnect “{item['name']}”?"):
                return
            ok, err = self.dial.stop()
            self.notify(f"“{item['name']}” hung up" if ok else err,
                        C_OK if ok else C_ERR)
            return
        if hangup_only:
            self.notify("This dialer is not connected", C_WARN)
            return
        if live:
            self.notify(f"“{section}” is still connected — hang up first", C_WARN)
            return
        if item["is_defaults"]:
            self.notify("Defaults holds shared settings, not a number", C_WARN)
            return
        if not item["phone"]:
            self.notify("This dialer has no phone number — press e", C_WARN)
            return
        ok, err = self.dial.start(item["name"], CFG["dial_config"])
        self.notify(f"Dialing {item['phone']}…" if ok else err,
                    C_ACCENT if ok else C_ERR)

    def act_dial_probe(self):
        if not WVDIALCONF:
            self.notify("wvdialconf is not installed", C_WARN)
            return
        path = dial_write_path()
        if not confirm_box(self.stdscr, "Probe modem",
                           f"Scan the serial ports and write findings to {path}?"):
            return
        self.do_action("probe", a_wvdialconf, path,
                       note="Probing serial ports…", success=f"Modem settings written to {path}")


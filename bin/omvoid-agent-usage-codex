#!/usr/bin/env python3
"""Собирает одну JSON-запись о расходе Codex. Контракт тот же, что у
omvoid-agent-usage-claude.

Два источника:

  * файлы сессий ~/.codex/sessions и ~/.codex/archived_sessions -- отсюда токены
    по дням и по моделям;
  * RPC к app-server самого Codex -- отсюда официальные проценты до лимита и
    название тарифа.

Если Codex на машине не используется, печатает пустоту и выходит с нулём:
диспетчер понимает это как "агента нет" и убирает его из бара.
"""

import datetime as dt
import json
import os
import select
import shutil
import subprocess
import sys
import time
from pathlib import Path

RECENT_DAYS = 7
LIMITS_REUSE_SECONDS = 300
SESSION_MAX_AGE_DAYS = 30


def codex_home() -> Path:
    return Path(os.environ.get("CODEX_HOME") or (Path.home() / ".codex"))


def cache_dir() -> Path:
    root = Path(os.environ.get("XDG_CACHE_HOME") or (Path.home() / ".cache"))
    return root / "omvoid" / "agent-usage"


def local_day(value) -> str:
    if isinstance(value, (int, float)):
        return dt.datetime.fromtimestamp(value).date().isoformat()
    raw = str(value or "").strip()
    if not raw:
        return ""
    try:
        parsed = dt.datetime.fromisoformat(raw.replace("Z", "+00:00"))
    except Exception:
        return ""
    if parsed.tzinfo is None:
        parsed = parsed.replace(tzinfo=dt.timezone.utc)
    return parsed.astimezone().date().isoformat()


def number(value) -> int:
    return int(value) if isinstance(value, (int, float)) else 0


def read_json(path: Path):
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except Exception:
        return None


def write_json(path: Path, payload) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(path.suffix + ".tmp")
    tmp.write_text(json.dumps(payload), encoding="utf-8")
    tmp.replace(path)


# ------------------------------------------------------------ файлы сессий

def scan_file(path: Path) -> dict:
    """{дата: {модель: [in, out, cache_read, cache_write, ходов]}} для файла."""
    days: dict = {}
    model = "codex"
    with path.open("r", encoding="utf-8", errors="replace") as handle:
        for line in handle:
            try:
                entry = json.loads(line)
            except Exception:
                continue

            if entry.get("type") == "turn_context":
                payload = entry.get("payload") or {}
                model = str(payload.get("model") or payload.get("model_slug") or model)
                continue

            payload = entry.get("payload") or entry
            if entry.get("type") == "response_item" and isinstance(payload, dict):
                payload = payload.get("payload") or payload
            if not isinstance(payload, dict) or payload.get("type") != "token_count":
                continue

            # total_token_usage в этих записях -- накопительный итог сессии.
            # Складывать снимки нельзя, расход рос бы квадратично; берём расход
            # последнего хода.
            usage = (payload.get("info") or {}).get("last_token_usage") or {}
            cache_read = number(usage.get("cached_input_tokens"))
            cache_write = number(usage.get("cache_write_input_tokens"))
            # Кэш уже посчитан внутри input_tokens -- вычитаем, чтобы не
            # задвоить; reasoning точно так же сидит внутри output_tokens.
            input_tokens = max(0, number(usage.get("input_tokens")) - cache_read - cache_write)
            output_tokens = number(usage.get("output_tokens"))
            counts = [input_tokens, output_tokens, cache_read, cache_write]
            if sum(counts) <= 0:
                continue

            day = local_day(entry.get("timestamp"))
            if not day:
                continue

            bucket = days.setdefault(day, {}).setdefault(model, [0, 0, 0, 0, 0])
            for i in range(4):
                bucket[i] += counts[i]
            bucket[4] += 1
    return days


def scan_sessions() -> dict:
    """Разбирает файлы сессий, переиспользуя кэш по размеру и mtime."""
    cache_path = cache_dir() / "codex-scan.json"
    cached = read_json(cache_path) or {}
    old_files = cached.get("files") if isinstance(cached.get("files"), dict) else {}

    cutoff = time.time() - SESSION_MAX_AGE_DAYS * 86400
    new_files: dict = {}
    for root in (codex_home() / "sessions", codex_home() / "archived_sessions"):
        if not root.is_dir():
            continue
        for path in root.rglob("*.jsonl"):
            try:
                stat = path.stat()
            except OSError:
                continue
            if stat.st_mtime < cutoff:
                continue
            key = str(path)
            previous = old_files.get(key)
            if (
                isinstance(previous, dict)
                and previous.get("size") == stat.st_size
                and previous.get("mtime") == int(stat.st_mtime)
                and isinstance(previous.get("days"), dict)
            ):
                new_files[key] = previous
                continue
            try:
                days = scan_file(path)
            except Exception as exc:
                print(f"пропускаю нечитаемый файл {path}: {exc}", file=sys.stderr)
                continue
            new_files[key] = {"size": stat.st_size, "mtime": int(stat.st_mtime), "days": days}

    try:
        write_json(cache_path, {"version": 1, "files": new_files})
    except Exception:
        pass

    merged: dict = {}
    for record in new_files.values():
        for day, models in record.get("days", {}).items():
            target = merged.setdefault(day, {})
            for model, counts in models.items():
                bucket = target.setdefault(model, [0, 0, 0, 0, 0])
                for i in range(5):
                    bucket[i] += counts[i]
    return merged


# ----------------------------------------------------------------- лимиты

def rpc(proc, request_id: int, method: str, params=None, timeout: float = 8.0):
    proc.stdin.write(json.dumps({"id": request_id, "method": method, "params": params or {}}) + "\n")
    proc.stdin.flush()
    deadline = time.time() + timeout
    while time.time() < deadline:
        ready, _, _ = select.select([proc.stdout], [], [], 0.25)
        if not ready:
            continue
        line = proc.stdout.readline()
        if not line:
            break
        try:
            message = json.loads(line)
        except Exception:
            continue
        if message.get("id") == request_id:
            return message
    raise TimeoutError(method)


def limit_window(window) -> dict:
    if not isinstance(window, dict):
        return {}
    used = window.get("usedPercent")
    if used is None:
        return {}
    minutes = number(window.get("windowDurationMins"))
    if minutes == 10080:
        label = "Неделя (7 дн)"
    elif minutes and minutes % 60 == 0:
        label = f"Окно {minutes // 60} ч"
    elif minutes:
        label = f"Окно {minutes} мин"
    else:
        label = "Лимит"
    resets = window.get("resetsAt")
    return {
        "label": label,
        "percent": min(1.0, float(used) / 100.0),
        "resetsAt": dt.datetime.fromtimestamp(number(resets), dt.timezone.utc).isoformat() if resets else "",
    }


def fetch_limits(force: bool) -> dict:
    cache_path = cache_dir() / "codex-limits.json"
    cached = read_json(cache_path) or {}
    fallback = cached.get("limits") if isinstance(cached.get("limits"), list) else []
    plan = str(cached.get("plan") or "")

    fetched = float(cached.get("fetchedAt") or 0)
    if fallback and not force and time.time() - fetched < LIMITS_REUSE_SECONDS:
        return {"plan": plan, "limits": fallback, "status": ""}

    codex = shutil.which("codex")
    if not codex:
        return {"plan": plan, "limits": fallback, "status": "codex не найден"}

    try:
        proc = subprocess.Popen(
            [codex, "-s", "read-only", "-a", "on-request", "app-server"],
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
        )
    except Exception:
        return {"plan": plan, "limits": fallback, "status": "codex не запускается"}

    try:
        rpc(proc, 1, "initialize", {"clientInfo": {"name": "omvoid-agent-usage", "version": "1"}})
        proc.stdin.write(json.dumps({"method": "initialized", "params": {}}) + "\n")
        proc.stdin.flush()
        account = rpc(proc, 2, "account/read", timeout=4)
        limits_msg = rpc(proc, 3, "account/rateLimits/read", timeout=4)

        account_data = (account.get("result") or {}).get("account") or {}
        limits_data = (limits_msg.get("result") or {}).get("rateLimits") or {}
        plan = str(
            limits_data.get("planType")
            or account_data.get("planType")
            or account_data.get("type")
            or plan
        )

        limits = []
        for window in (limits_data.get("primary"), limits_data.get("secondary")):
            entry = limit_window(window)
            if entry:
                limits.append(entry)
    except Exception:
        return {"plan": plan, "limits": fallback, "status": "лимиты недоступны"}
    finally:
        try:
            proc.terminate()
            proc.wait(timeout=1)
        except Exception:
            try:
                proc.kill()
            except Exception:
                pass

    if not limits:
        return {"plan": plan, "limits": fallback, "status": "лимиты не вернулись"}

    try:
        write_json(cache_path, {"fetchedAt": time.time(), "limits": limits, "plan": plan})
    except Exception:
        pass
    return {"plan": plan, "limits": limits, "status": ""}


# ------------------------------------------------------------------ вывод

def main() -> int:
    force = "--force" in sys.argv

    # Гейт на существование ~/.codex, и он важнее, чем кажется. Команда `codex`
    # лежит в PATH ленивой обёрткой с первой загрузки системы, и запуск её
    # что-нибудь скачает -- то есть фоновое обновление бара молча утянуло бы
    # десятки мегабайт для агента, которым не пользуются. Каталог появляется
    # только после реального входа, поэтому им и гейтим. У omarchy такой
    # проверки нет: у них коллектор зовёт codex сразу.
    if not codex_home().is_dir():
        return 0

    days = scan_sessions()
    today = dt.date.today()
    recent_dates = [(today - dt.timedelta(days=i)).isoformat() for i in range(RECENT_DAYS - 1, -1, -1)]

    def totals(models: dict) -> list:
        out = [0, 0, 0, 0, 0]
        for counts in models.values():
            for i in range(5):
                out[i] += counts[i]
        return out

    recent = [
        {
            "date": date,
            "tokens": sum(totals(days.get(date, {}))[:4]),
            "messages": totals(days.get(date, {}))[4],
        }
        for date in recent_dates
    ]

    today_counts = totals(days.get(today.isoformat(), {}))
    by_model: dict = {}
    for date in recent_dates:
        for model, counts in days.get(date, {}).items():
            by_model[model] = by_model.get(model, 0) + sum(counts[:4])

    limits = fetch_limits(force)

    # Каталог ~/.codex появляется от первого же запуска, задолго до того, как в
    # нём заведётся хоть какой-то расход. Агент без единого токена за неделю и
    # без лимитов -- это агент, которым не пользуются: он занимал бы место в
    # баре строкой "codex 0". Молчим, как будто его нет.
    if not limits["limits"] and not any(day["tokens"] for day in recent):
        return 0

    record = {
        "id": "codex",
        "name": "Codex",
        "plan": limits["plan"],
        "limits": limits["limits"],
        "limitsStatus": limits["status"],
        "today": {
            "tokens": sum(today_counts[:4]),
            "input": today_counts[0],
            "output": today_counts[1],
            "cacheRead": today_counts[2],
            "cacheWrite": today_counts[3],
            "messages": today_counts[4],
        },
        "weekTokens": sum(day["tokens"] for day in recent),
        "recentDays": recent,
        "byModel": [
            {"model": model, "tokens": tokens}
            for model, tokens in sorted(by_model.items(), key=lambda kv: -kv[1])
        ],
    }
    print(json.dumps(record, ensure_ascii=False))
    return 0


if __name__ == "__main__":
    sys.exit(main())

#!/bin/bash

# Кладёт файл из репозитория туда, куда его разворачивает установка, сохранив
# резервную копию и показав, что именно затирается. Нужен потому, что установка
# копирует, а не связывает: после git pull живой файл сам не обновится, и
# повторный install.sh его не тронет -- у шага стоит маркер.
#
#   omvoid-refresh-config waybar/config-mango
#   omvoid-refresh-config applications/imv.desktop default/.bashrc
#
# С --capture -- наоборот, из системы в репозиторий. Правки делаются и там и
# там: живой файл правится по ходу дела и уходит вперёд, и без обратного хода
# эта правка теряется при первом же обновлении.
#
#   omvoid-refresh-config --capture mango/conf/windowrules.conf
#
# Путь можно давать репозиторный (config/..., default/..., applications/...)
# или, по старой привычке, относительно ~/.config -- тогда config/ добавится сам.

set -euo pipefail

OMVOID_PATH="${OMVOID_PATH:-$HOME/.local/share/omvoid}"

# Куда установка разворачивает файл репозитория. Пусто -- значит этот файл
# никуда не копируется: themes/ и default/agents/ разворачиваются симлинками и
# потому живые сами по себе, default/xcompose подключается по пути,
# default/repokeyes уезжает в системный каталог под root.
deployed_target() {
  case "$1" in
  config/*) echo "$HOME/.config/${1#config/}" ;;
  applications/icons/*) echo "$HOME/.local/share/icons/hicolor/48x48/apps/${1#applications/icons/}" ;;
  applications/*.desktop) echo "$HOME/.local/share/applications/${1#applications/}" ;;
  install/apps/files/*) echo "$HOME/.local/bin/${1#install/apps/files/}" ;;
  default/gnupg/*) echo "$HOME/.gnupg/${1#default/gnupg/}" ;;
  default/.bashrc | default/.bash_profile | default/.gtkrc-2.0) echo "$HOME/${1#default/}" ;;
  esac
}

# Манифест развёрнутого: что именно было положено на машину в последний раз.
#
# Без него расхождение -- одно слово для трёх разных случаев: репозиторий ушёл
# вперёд, пользователь правил живой файл, или изменились обе стороны. Различить
# их можно, только помня исходное состояние. Так же поступают pacman со своими
# .pacnew и dpkg с conffiles.
MANIFEST="${XDG_STATE_HOME:-$HOME/.local/state}/omvoid/deployed.sha256"

# Формат строки -- как у sha256sum: 64 знака суммы, два пробела, путь. Значит
# путь начинается с 67-го символа, и сравнивать надо именно его целиком.
# Подстрокой нельзя: "config/waybar/config" входит в "config/waybar/config-mango",
# и запись про один файл стирала бы запись про другой. Полем тоже нельзя --
# среди файлов есть "applications/icons/Disk Usage.png" с пробелом в имени.
manifest_get() {
  [[ -f $MANIFEST ]] || return 1
  local sum
  sum=$(awk -v r="$1" 'substr($0, 67) == r { print substr($0, 1, 64) }' "$MANIFEST" | tail -1)
  [[ -n $sum ]] || return 1
  printf '%s\n' "$sum"
}

manifest_set() {
  local rel="$1" file="$2" sum tmp
  [[ -f $file ]] || return 0
  sum=$(sha256sum "$file" | cut -d' ' -f1)
  mkdir -p "$(dirname "$MANIFEST")"
  tmp=$(mktemp)
  {
    [[ -f $MANIFEST ]] && awk -v r="$rel" 'substr($0, 67) != r' "$MANIFEST"
    printf '%s  %s\n' "$sum" "$rel"
  } >"$tmp" 2>/dev/null || true
  mv "$tmp" "$MANIFEST"
}

# Старая форма вызова принимала путь относительно ~/.config. Оставлена: ей
# пользуются и руки, и написанная раньше документация.
normalize() {
  case "$1" in
  config/* | default/* | applications/* | install/* | themes/*) echo "$1" ;;
  *) echo "config/$1" ;;
  esac
}

# Записать текущее состояние машины как исходное. Без аргументов -- по всем
# файлам, которые вообще разворачиваются.
#
# Снимается на чистой машине: сразу после установки, когда репозиторий и
# система заведомо совпадают. Различение работает вперёд по времени -- правка,
# сделанная до этого момента, вобралась бы в отсчёт и перестала бы считаться
# правкой. Поэтому машину, которая давно жила своей жизнью, сначала приводят в
# соответствие с репозиторием вручную, а уже потом снимают отсчёт.
if [[ ${1:-} == "--record" ]]; then
  shift
  if (($# == 0)); then
    mapfile -t to_record < <(
      cd "$OMVOID_PATH"
      find config -type f -printf '%p\n'
      find applications -maxdepth 1 -name '*.desktop' -printf '%p\n'
      find applications/icons -type f -printf '%p\n' 2>/dev/null
      find install/apps/files -type f -printf '%p\n' 2>/dev/null
      for f in default/.bashrc default/.bash_profile default/.gtkrc-2.0; do
        [[ -f $f ]] && printf '%s\n' "$f"
      done
      find default/gnupg -type f -printf '%p\n' 2>/dev/null
    )
  else
    to_record=("$@")
  fi
  recorded=0
  skipped=0
  for argument in "${to_record[@]}"; do
    rel=$(normalize "$argument")
    live=$(deployed_target "$rel")
    [[ -n $live && -f $live ]] || continue

    # Записываем, только если репозиторий и машина сейчас совпадают.
    #
    # Вся дальнейшая логика держится на том, что запись означает "вот что было
    # развёрнуто". Если файлы уже разошлись, такого момента не было, и запись
    # соврала бы: живой равнялся бы записи, и любое расхождение читалось бы как
    # "репозиторий впереди" -- даже там, где репозиторий ничего не менял.
    # Честнее не знать исходного состояния, чем знать неверное.
    if ! cmp -s "$OMVOID_PATH/$rel" "$live"; then
      skipped=$((skipped + 1))
      continue
    fi

    manifest_set "$rel" "$live"
    recorded=$((recorded + 1))
  done
  echo "записано в манифест: $recorded"
  ((skipped)) && echo "  пропущено (репозиторий и машина уже разошлись): $skipped"
  exit 0
fi

# Служебный режим для omvoid-update: спросить, куда разворачивается файл, и
# ничего не делать. Так таблица путей живёт в одном месте, а не в двух.
if [[ ${1:-} == "--where" ]]; then
  shift
  for argument in "$@"; do
    deployed_target "$(normalize "$argument")"
  done
  exit 0
fi

capture=false
if [[ ${1:-} == "--capture" ]]; then
  capture=true
  shift
fi

if (($# == 0)); then
  cat >&2 <<USAGE
Использование: omvoid-refresh-config [--capture] <путь> [путь...]

  omvoid-refresh-config waybar/config-mango            репозиторий -> система
  omvoid-refresh-config --capture waybar/config-mango  система -> репозиторий

Путь репозиторный либо относительно ~/.config. Разворачиваются:
  config/*                 -> ~/.config/
  applications/*.desktop   -> ~/.local/share/applications/
  applications/icons/*     -> ~/.local/share/icons/hicolor/48x48/apps/
  install/apps/files/*     -> ~/.local/bin/
  default/.bashrc и т.п.   -> \$HOME
USAGE
  exit 1
fi

status=0
for argument in "$@"; do
  config_file=$(normalize "$argument")
  deployed=$(deployed_target "$config_file")

  if [[ -z $deployed ]]; then
    echo "omvoid-refresh-config: $config_file никуда не копируется установкой" >&2
    status=1
    continue
  fi

  if $capture; then
    source_file="$deployed"
    target_file="$OMVOID_PATH/$config_file"
    missing="в системе нет ${deployed/#$HOME/\~}"
    label="$config_file"
  else
    source_file="$OMVOID_PATH/$config_file"
    target_file="$deployed"
    missing="в репозитории нет $config_file"
    label="${deployed/#$HOME/\~}"
  fi

  if [[ ! -f $source_file ]]; then
    echo "omvoid-refresh-config: $missing" >&2
    status=1
    continue
  fi

  # Часть файлов в репозитории -- шаблоны с подстановкой при установке
  # (config/service/mpd/run несёт __USERNAME__). Копировать их как есть нельзя
  # ни в какую сторону, и обе ошибки одинаково тихие:
  #
  #   вперёд -- в живой файл попал бы буквальный __USERNAME__, и сервис не
  #             поднялся бы, потому что подстановку делает установщик;
  #   назад  -- шаблон в репозитории заменился бы готовым файлом с именем
  #             этого пользователя, и на следующей машине он был бы неверным.
  if grep -q '__USERNAME__' "$source_file" 2>/dev/null ||
    { [[ -f $target_file ]] && grep -q '__USERNAME__' "$target_file"; }; then
    echo "omvoid-refresh-config: $config_file -- шаблон с __USERNAME__, пропущен" >&2
    echo "  такие файлы правятся в репозитории вручную, с сохранением подстановки" >&2
    status=1
    continue
  fi

  mkdir -p "$(dirname "$target_file")"

  if [[ ! -f $target_file ]]; then
    cp -f "$source_file" "$target_file"
    # После копии в любую сторону репозиторий и машина совпадают, и это
    # состояние становится исходным для будущих сравнений.
    manifest_set "$config_file" "$deployed"
    echo "создан: $label"
    continue
  fi

  if cmp -s "$source_file" "$target_file"; then
    # Совпадают, но в манифесте могло не быть записи -- например, файл
    # разворачивала установка, а не этот скрипт. Зафиксируем.
    manifest_get "$config_file" >/dev/null || manifest_set "$config_file" "$deployed"
    echo "без изменений: $label"
    continue
  fi

  # Резервная копия делается всегда, когда файлы разошлись: расхождение почти
  # наверняка значит, что живой правили руками, и молча стереть эту правку --
  # худшее, что может сделать этот скрипт.
  if $capture; then
    # В репозитории резервная копия ни к чему -- прежнее содержимое и так
    # лежит в git, а .bak-файл попал бы в дерево и в коммит.
    previous=$(mktemp)
    cp -f "$target_file" "$previous"
    cp -f "$source_file" "$target_file"
    echo "обновлён: $label"
    echo "  что изменилось (- было, + стало):"
    diff -u "$previous" "$target_file" | tail -n +3 | sed 's/^/    /' || true
    rm -f "$previous"
  else
    backup="$target_file.bak.$(date +%s)"
    cp -f "$target_file" "$backup"
    cp -f "$source_file" "$target_file"
    echo "обновлён: $label"
    echo "  копия прежнего: $backup"
    echo "  что изменилось (- было, + стало):"
    diff -u "$backup" "$target_file" | tail -n +3 | sed 's/^/    /' || true
  fi

  manifest_set "$config_file" "$deployed"
done

exit $status

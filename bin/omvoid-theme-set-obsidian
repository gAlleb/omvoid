#!/bin/bash

# Отдаёт цвета текущей палитры всем хранилищам Obsidian.
#
# Кладётся сниппетом, а не темой: тема (GitHub Theme и любая другая) остаётся
# выбранной вместе со своей вёрсткой, сниппет меняет поверх неё только цвета.
# Так же поступает Noctalia -- отсюда и совместимость, если оба включены.
#
# Хранилища берутся из ~/.config/obsidian/obsidian.json, а не задаются жёстко:
# их может быть несколько, и путь к ним меняется.

set -euo pipefail

SOURCE="$HOME/.cache/wal/obsidian.css"
SNIPPET_NAME="omvoid"
VAULTS_FILE="$HOME/.config/obsidian/obsidian.json"

if [[ ! -f $SOURCE ]]; then
  echo "omvoid-theme-set-obsidian: нет $SOURCE -- pywal ещё не разворачивал шаблон" >&2
  exit 1
fi

[[ -f $VAULTS_FILE ]] || exit 0

count=0
while read -r vault; do
  [[ -d $vault/.obsidian ]] || continue

  mkdir -p "$vault/.obsidian/snippets"
  cp -f "$SOURCE" "$vault/.obsidian/snippets/$SNIPPET_NAME.css"

  # Сниппет мало положить -- его надо ещё включить, иначе Obsidian его
  # проигнорирует.
  #
  # Но appearance.json одновременно держит открытым сам Obsidian и переписывает
  # его из своей памяти. Запись отсюда при каждой смене темы однажды уже стёрла
  # пользователю пять включённых сниппетов: наше чтение-правка-запись разошлось
  # с его записью. Поэтому трогаем файл ровно один раз -- когда нашего сниппета
  # в списке ещё нет. Дальше меняется только сам CSS, а его Obsidian
  # перечитывает на лету и ни с кем за файл не спорит.
  appearance="$vault/.obsidian/appearance.json"
  [[ -f $appearance ]] || echo '{}' >"$appearance"

  if ! jq -e --arg s "$SNIPPET_NAME" \
    '(.enabledCssSnippets // []) | index($s)' "$appearance" >/dev/null 2>&1; then
    tmp=$(mktemp)
    if jq --arg s "$SNIPPET_NAME" \
      '.enabledCssSnippets = ((.enabledCssSnippets // []) + [$s])' \
      "$appearance" >"$tmp"; then
      mv "$tmp" "$appearance"
      echo "сниппет $SNIPPET_NAME включён в $vault"
    else
      rm -f "$tmp"
      echo "omvoid-theme-set-obsidian: не смог включить сниппет в $vault" >&2
    fi
  fi

  count=$((count + 1))
done < <(jq -r '.vaults | values[].path' "$VAULTS_FILE" 2>/dev/null)

echo "цвета Obsidian обновлены (хранилищ: $count)"

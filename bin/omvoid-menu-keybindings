#!/bin/bash

# Показывает кейбинды mango списком с поиском. Читает конфиг напрямую -- он и
# есть источник истины, в отличие от Hyprland, где приходится опрашивать
# hyprctl и резолвить XKB-коды.
#
# Тема меню переопределяется: OMVOID_MENU_THEME=menu-style-clipboard omvoid-menu-keybindings

set -euo pipefail

CONFIG="$HOME/.config/mango/conf/keybindings.conf"
[[ -f $CONFIG ]] || CONFIG="${OMVOID_PATH:-$HOME/.local/share/omvoid}/config/mango/conf/keybindings.conf"

if [[ ! -f $CONFIG ]]; then
  echo "omvoid-menu-keybindings: не найден keybindings.conf" >&2
  exit 1
fi

THEME="${OMVOID_MENU_THEME:-keybindings}"

# Строки пишутся и как "bind=MOD,key,action", и как "bind = MOD, key, action",
# поэтому сначала приводим к одному виду, а уже потом режем по запятым.
list() {
  # Описание бинда пишется строкой ВЫШЕ него и помечается "#:". Хвостовой
  # комментарий на самой строке использовать нельзя: mango его не отрезает, а
  # отдаёт команде -- "nautilus  # file manager" открывал три окна Nautilus,
  # по окну на слово, и жаловался, что не нашёл ни "#", ни "file", ни "manager".
  awk '
    /^[[:space:]]*#:/ {
      desc = $0
      sub(/^[[:space:]]*#:[[:space:]]*/, "", desc)
      next
    }

    /^[[:space:]]*bind[[:space:]]*=/ {
      line = $0
      sub(/^[[:space:]]*bind[[:space:]]*=?[[:space:]]*/, "", line)
      sub(/[[:space:]]*#.*$/, "", line)

      n = split(line, f, ",")
      for (i = 1; i <= n; i++) gsub(/^[ \t]+|[ \t]+$/, "", f[i])

      mod = f[1]
      key = f[2]
      if (key == "") { desc = ""; next }

      action = f[3]
      args = ""
      for (i = 4; i <= n; i++) {
        if (f[i] == "") continue
        args = (args == "" ? f[i] : args " " f[i])
      }

      combo = (mod == "" ? key : mod " + " key)
      gsub(/\+/, " + ", combo)
      gsub(/  +/, " ", combo)

      text = action
      if (args != "") text = text " " args
      if (desc != "") text = desc

      printf "%-28s %s\n", combo, text
      desc = ""
      next
    }

    # Что угодно ещё обрывает связь: описание действует только на бинд сразу
    # под ним, иначе заголовок раздела прилип бы к первому биндy после него.
    { desc = "" }
  ' "$CONFIG"
}

count=$(list | wc -l)

list | rofi -dmenu -i \
  -p "кейбинды ($count)" \
  -theme "$HOME/.config/rofi/${THEME}.rasi" >/dev/null || true

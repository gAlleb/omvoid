#!/bin/bash

# Picks a random wallpaper and applies it. Runs once during installation, so the
# desktop comes up already themed instead of grey.
#
# Sourced by install/desktop/theme.sh, which means two rules:
#   - never call exit, it would take the whole installer down
#   - never call exec, it would replace the installer's shell
# Everything therefore lives in a function that returns.
#
# At this point nothing is running yet — no bar, no notification daemon. That is
# fine: omvoid-theme-apply checks what exists before poking it, so the same code
# path works during install and afterwards.

omvoid_init_wallpaper() {
  local wallpaper_dir="$HOME/.config/wallpaper"
  local cache_dir="$HOME/.cache/omvoid_wallpaper"

  [[ -d $wallpaper_dir ]] || { echo "omvoid-init-wallpaper: no $wallpaper_dir" >&2; return 1; }

  local -a pics
  mapfile -t pics < <(find -L "$wallpaper_dir" -type f \
    \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' \) | sort)

  ((${#pics[@]})) || { echo "omvoid-init-wallpaper: no wallpapers found" >&2; return 1; }

  # Warm the thumbnail cache so the first ALT+W on a fresh machine is not slow.
  omvoid-wallpaper-thumbnails

  local pick="${pics[RANDOM % ${#pics[@]}]}"
  omvoid-theme-apply --image "$pick" --dark
}

omvoid_init_wallpaper

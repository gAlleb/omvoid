#!/bin/bash

# Hands the current palette to GTK3 and GTK4/libadwaita applications.
#
# Nautilus and the rest of libadwaita ignore GTK themes; the only thing they
# read is @define-color overrides in gtk.css. So the colours are written to a
# file beside it and pulled in with an @import.
#
# The line goes last: Noctalia puts an @import of its own into the same files,
# and in CSS the one declared last wins.
#
# None of this depends on a particular GTK theme -- gtk.css is a user override
# GTK reads whatever theme is set. WhiteSur only enters because its installer
# makes gtk.css a symlink into its own 290 KB stylesheet, so that is the file
# actually being appended to.

set -euo pipefail

SOURCE="$HOME/.cache/wal/colors-gtk.css"
IMPORT='@import url("omvoid.css"); /* omvoid: colours from pywal */'

if [[ ! -f $SOURCE ]]; then
  echo "omvoid-theme-set-gtk: no $SOURCE — pywal has not rendered the template yet" >&2
  exit 1
fi

# Appends the @import at the end of the file, dropping our own previous line
# first so repeated runs do not pile up duplicates.
ensure_import() {
  local css="$1"
  [[ -f $css ]] || return 0

  local before after tmp
  before=$(wc -c <"$css")

  # In the same directory on purpose: mv is only atomic within one filesystem.
  tmp=$(mktemp "$(dirname "$css")/.omvoid-gtk.XXXXXX")

  # Drop our previous line and any blank line it left behind, or every run
  # would add one and the file would slowly grow a tail of empty lines.
  # Matched on the import target, not on the comment: the comment wording has
  # changed once already, and the old line then survived as a duplicate.
  grep -vF 'url("omvoid.css")' "$css" | sed -e :a -e '/^\n*$/{$d;N;ba' -e '}' >"$tmp" || true
  printf '\n%s\n' "$IMPORT" >>"$tmp"
  after=$(wc -c <"$tmp")

  if ((before < 4096)); then
    echo "omvoid-theme-set-gtk: ${css/#$HOME/\~} is only $before bytes — looks rewritten by another tool" >&2
  fi

  # The result may only grow, or shrink by the length of our own previous line.
  # Anything beyond that means the input was not what we thought it was.
  if ((after + 200 < before)); then
    echo "omvoid-theme-set-gtk: ${css/#$HOME/\~} would shrink from $before to $after bytes, refusing" >&2
    echo "  another tool has probably rewritten it; check its GTK integration" >&2
    rm -f "$tmp"
    return 1
  fi

  # Replaced in one step, never emptied first.
  #
  # This used to be `cat "$tmp" >"$css"`, and the redirection truncates the file
  # before writing a single byte. Noctalia's own GTK template
  # (/usr/share/noctalia/assets/templates/gtk/apply.sh) reads this very file
  # with content=$(cat …) and writes it back with its import appended, and both
  # of us are triggered by the same event -- a wallpaper change. A read landing
  # inside that window saw an empty file and faithfully wrote back nothing but
  # imports. That is how 290 KB of WhiteSur turned into a hundred bytes.
  #
  # mv is safe for the symlink: the caller resolved it with readlink -f, so what
  # is being replaced is the real file, and the link still points at its path.
  chmod --reference="$css" "$tmp" 2>/dev/null || chmod 644 "$tmp"
  mv -f "$tmp" "$css"
}

for version in 3.0 4.0; do
  dir="$HOME/.config/gtk-$version"
  [[ -d $dir ]] || continue

  cp -f "$SOURCE" "$dir/omvoid.css"

  # gtk.css and gtk-dark.css are symlinks under WhiteSur, pointing at
  # gtk-Light.css / gtk-Dark.css. Edit what they point at, or the write misses.
  for entry in gtk.css gtk-dark.css; do
    if [[ -e $dir/$entry ]]; then
      ensure_import "$(readlink -f "$dir/$entry")"
    elif [[ $entry == gtk.css ]]; then
      # Nothing to append to. A theme usually ships this file, but without one
      # it simply does not exist -- and then nothing would import the colours
      # at all, silently. gtk-dark.css is not created: GTK does not require it,
      # it is a theme convention.
      printf '%s\n' "$IMPORT" >"$dir/$entry"
    fi
  done
done

echo "GTK colours updated (gtk-3.0, gtk-4.0)"

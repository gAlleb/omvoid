#!/bin/bash

# Moves the parts of a working machine that cannot live in the repository:
# the mail stack mutt-wizard builds by hand, and the keys everything else
# rests on.
#
#   omvoid-migrate-secrets export              write ~/omvoid-secrets-<host>-<date>.tar.gz
#   omvoid-migrate-secrets export -n           list what would go in, write nothing
#   omvoid-migrate-secrets import <archive>    unpack it on the new machine
#
# One script with both halves on purpose: the list of what is carried has to be
# the same on both ends, and two files would drift the first time one of them
# is edited.
#
# What is in the archive: GPG secret keys. SSH private keys. The whole password
# store. Anyone holding it holds the accounts. It is written with mode 600 into
# $HOME. If it has to travel by anything less private than a cable between two
# of your own machines, encrypt it: gpg -c <archive>.

set -euo pipefail

# Every file mode inside the staging directory starts private; the copies get
# their real modes from cp -a, and what the script creates itself stays 600.
umask 077

# The staging directory holds decrypted keys for the length of one run, so it is
# removed on every exit, including a failed one. Declared here rather than in the
# functions: an EXIT trap fires after the function is gone, and a local variable
# with it -- which under set -u ends the script complaining about "stage" instead
# of cleaning up.
stage=""
cleanup() {
  [[ -n $stage ]] && rm -rf "$stage"
  return 0
}
trap cleanup EXIT

ARCHIVE="$HOME/omvoid-secrets-$(hostname)-$(date +%Y%m%d).tar.gz"

die() {
  echo "omvoid-migrate-secrets: $*" >&2
  exit 1
}

note() { printf '      %s\n' "$*"; }
step() { printf '\n\033[1m%s\033[0m\n' "$*"; }

# Everything that is copied verbatim, path by path. Directories keep their
# contents. A missing entry is skipped with a word, not an error: not every
# machine has every account, and voidrepo.pem lives only on the one that signs
# packages.
PATHS=(
  .notmuch-config
  .mbsyncrc
  .config/msmtp
  .config/mutt
  .config/imapnotify
  .password-store
  .ssh
  voidrepo.pem
  voidrepo.pem.pub
)

usage() {
  sed -n '3,20p' "$0" | sed 's/^# \?//'
  exit "${1:-0}"
}

# --- export ------------------------------------------------------------------

do_export() {
  local dry_run=false out="$ARCHIVE"
  local OPTIND opt
  while getopts "nh" opt; do
    case "$opt" in
    n) dry_run=true ;;
    h) usage ;;
    *) exit 1 ;;
    esac
  done

  stage=$(mktemp -d)
  mkdir -p "$stage/home" "$stage/service" "$stage/gpg"

  step "Files"
  local p
  for p in "${PATHS[@]}"; do
    if [[ -e $HOME/$p ]]; then
      note "$p"
      $dry_run && continue
      mkdir -p "$stage/home/$(dirname "$p")"
      cp -a "$HOME/$p" "$stage/home/$p"
    else
      note "$p — нет, пропускаю"
    fi
  done

  step "imapnotify services"
  # Only the run scripts. supervise/ is runit's live state -- a directory of
  # fifos and pids that means nothing on another machine, and copying it makes
  # the new supervisor think the service is already being watched.
  local svc name
  for svc in "$HOME"/.config/service/imapnotify*/; do
    [[ -f ${svc}run ]] || continue
    name=$(basename "${svc%/}")
    note "$name/run"
    $dry_run && continue
    mkdir -p "$stage/service/$name"
    cp -a "${svc}run" "$stage/service/$name/run"
  done

  step "GPG"
  # Exported rather than copied: ~/.gnupg carries sockets and a trustdb tied to
  # the gpg version that made it, and those travel badly. The three files below
  # are the whole of what matters and gpg reads them back on any version.
  #
  # The secret key export asks the agent for the passphrase, so a pinentry
  # window appears here -- this is the one moment the export is not unattended.
  note "secret keys, public keys, ownertrust"
  if ! $dry_run; then
    gpg --export-secret-keys --armor >"$stage/gpg/secret-keys.asc" ||
      die "could not export the secret keys"
    [[ -s $stage/gpg/secret-keys.asc ]] ||
      die "the secret key export came back empty — nothing was written"
    gpg --export --armor >"$stage/gpg/public-keys.asc"
    gpg --export-ownertrust >"$stage/gpg/ownertrust.txt"
  fi

  if $dry_run; then
    echo
    note "это был -n: ничего не записано"
    return 0
  fi

  step "Archive"
  tar -czf "$out" -C "$stage" home service gpg
  chmod 600 "$out"

  echo
  note "готово: $out ($(du -h "$out" | cut -f1))"
  note "архив НЕ зашифрован — в нём закрытые ключи и весь password-store"
  note "если повезёт не только кабелю:  gpg -c $out"
}

# --- import ------------------------------------------------------------------

do_import() {
  local archive="${1:-}"
  [[ -n $archive ]] || die "name the archive: omvoid-migrate-secrets import <file>"
  [[ -f $archive ]] || die "no such file: $archive"

  stage=$(mktemp -d)

  step "Unpacking"
  if [[ $archive == *.gpg ]]; then
    gpg --decrypt "$archive" | tar -xzf - -C "$stage"
  else
    tar -xzf "$archive" -C "$stage"
  fi
  [[ -d $stage/home ]] || die "this does not look like an archive of ours"

  step "Files"
  # Anything already there is moved aside rather than merged or overwritten:
  # a half-merged ~/.ssh is worse than either version of it, and mv keeps the
  # old one recoverable.
  # The same list the export walked, not a find over the archive: one list,
  # read twice, cannot disagree with itself.
  local p target backup
  for p in "${PATHS[@]}"; do
    [[ -e $stage/home/$p ]] || continue
    target="$HOME/$p"
    if [[ -e $target ]]; then
      backup="$target.before-import-$(date +%H%M%S)"
      mv "$target" "$backup"
      note "$p — было, отложено в $(basename "$backup")"
    else
      note "$p"
    fi
    mkdir -p "$(dirname "$target")"
    cp -a "$stage/home/$p" "$target"
  done

  step "Permissions"
  # Set here rather than trusted from the archive. msmtp refuses to read a
  # config other people can see, ssh refuses a private key the same way, and a
  # tar unpacked with a different umask is exactly how those modes get lost.
  [[ -d $HOME/.ssh ]] && {
    chmod 700 "$HOME/.ssh"
    find "$HOME/.ssh" -type f ! -name '*.pub' ! -name 'known_hosts*' -exec chmod 600 {} +
    find "$HOME/.ssh" -type f \( -name '*.pub' -o -name 'known_hosts*' \) -exec chmod 644 {} +
    note "~/.ssh 700, закрытые ключи 600"
  }
  [[ -d $HOME/.password-store ]] && {
    chmod 700 "$HOME/.password-store"
    note "~/.password-store 700"
  }
  [[ -f $HOME/.config/msmtp/config ]] && {
    chmod 600 "$HOME/.config/msmtp/config"
    note "msmtp config 600"
  }
  [[ -f $HOME/.mbsyncrc ]] && chmod 600 "$HOME/.mbsyncrc"
  [[ -f $HOME/.notmuch-config ]] && chmod 600 "$HOME/.notmuch-config"
  [[ -f $HOME/voidrepo.pem ]] && {
    chmod 600 "$HOME/voidrepo.pem"
    note "voidrepo.pem 600"
  }

  step "imapnotify services"
  local svc name
  if [[ -d $stage/service ]]; then
    for svc in "$stage"/service/*/; do
      [[ -f ${svc}run ]] || continue
      name=$(basename "${svc%/}")
      mkdir -p "$HOME/.config/service/$name"
      cp -a "${svc}run" "$HOME/.config/service/$name/run"
      chmod 755 "$HOME/.config/service/$name/run"
      note "$name"
    done
  fi

  step "GPG"
  mkdir -p "$HOME/.gnupg"
  chmod 700 "$HOME/.gnupg"
  if [[ -f $stage/gpg/public-keys.asc ]]; then
    gpg --import "$stage/gpg/public-keys.asc" 2>&1 | sed 's/^/      /'
  fi
  if [[ -f $stage/gpg/secret-keys.asc ]]; then
    gpg --import "$stage/gpg/secret-keys.asc" 2>&1 | sed 's/^/      /'
  fi
  if [[ -f $stage/gpg/ownertrust.txt ]]; then
    # After the keys, never before: ownertrust is a judgement about keys, and
    # gpg has to have them in hand to act on it.
    gpg --import-ownertrust "$stage/gpg/ownertrust.txt" 2>&1 | sed 's/^/      /'
    # Recomputes validity from the trust just imported. gpg gets there on its
    # own eventually; without it the first thing to use a key -- pass, most
    # likely -- meets a key of unknown validity and refuses.
    gpg --check-trustdb 2>&1 | sed 's/^/      /' || true
  fi

  # Everything below exists because of one evening of it not working: pass
  # failed with "public key decryption failed: No secret key" on every account,
  # and what fixed it by hand was killing the agent, correcting the modes under
  # ~/.gnupg and importing the secret keys a second time. Any of the three can
  # cause exactly that message, so all three are handled here rather than left
  # to be rediscovered.

  # 1. Modes. gpg-agent refuses to read a private key it considers exposed, and
  # reports the key as absent rather than as unreadable -- which is the whole
  # reason that message sends people looking for a missing import.
  find "$HOME/.gnupg" -type d -exec chmod 700 {} +
  find "$HOME/.gnupg" -type f -exec chmod 600 {} +
  note "~/.gnupg: каталоги 700, файлы 600"

  # 2. The agent. It was running before the import with a different set of
  # private keys, and it is the agent, not gpg, that answers "no secret key".
  # Killed rather than reloaded: gpgconf starts it again on the next request.
  gpgconf --kill gpg-agent 2>/dev/null || true
  note "gpg-agent перезапущен"

  # The one pairing that has to hold for the mail stack to work at all:
  # ~/.password-store/.gpg-id names the key pass encrypts to, and that key has
  # to have arrived with its secret half. Checked rather than assumed -- the
  # failure otherwise surfaces later, as pass asking for a key nobody has.
  if [[ -f $HOME/.password-store/.gpg-id ]]; then
    local gpg_id
    gpg_id=$(<"$HOME/.password-store/.gpg-id")
    if gpg --list-secret-keys "$gpg_id" >/dev/null 2>&1; then
      note "pass: ключ \"$gpg_id\" на месте, закрытая часть есть"
    else
      note "ВНИМАНИЕ: pass шифрует на \"$gpg_id\", а закрытого ключа под него нет"
      note "  проверь: gpg --list-secret-keys"
    fi
  fi

  # 3. The end-to-end proof. Everything above can look right and still fail at
  # the first mailsync, because what mbsync actually runs is PassCmd -- gpg
  # decrypting a file from the store. So one entry is decrypted here, for its
  # exit code only: the plaintext goes to /dev/null and is never held in a
  # variable, and the passphrase prompt that appears is the same one the mail
  # stack would have raised an hour later, on its own, with no explanation.
  # The exit code is not the signal here. gpg returns 0 for a file that is not
  # OpenPGP at all -- it decides the input is literal data and copies it
  # through -- so a passing exit code would prove nothing about decryption.
  # DECRYPTION_OKAY on the status channel is emitted only when a key actually
  # opened the file, and the status channel is a separate file, so no plaintext
  # goes anywhere near it.
  local entry err status
  entry=$(find "$HOME/.password-store" -name '*.gpg' -type f 2>/dev/null | head -1)
  if [[ -n $entry ]]; then
    err=$(mktemp)
    status=$(mktemp)
    # Said before the dialog appears, not after. An unannounced pinentry in the
    # middle of a script reads as something having gone wrong.
    note "сейчас всплывёт pinentry — это проверка расшифровки, введи пароль ключа"
    gpg --status-file "$status" --quiet --decrypt "$entry" >/dev/null 2>"$err" || true
    if grep -q '^\[GNUPG:\] DECRYPTION_OKAY' "$status"; then
      note "проверка расшифровки: прошла — pass будет работать"
    elif grep -qi 'cancel' "$err"; then
      # Distinguished on purpose: a cancelled prompt proves nothing either way,
      # and calling it a failure would send someone debugging a working setup.
      note "проверку отменили — ничего не сломано, но и не проверено"
      note "  проверить позже:  pass <любая запись>"
    else
      note "проверка расшифровки НЕ прошла:"
      sed 's/^/        /' "$err"
      note "  внимание: \"No secret key\" здесь может значить и то, что ключ есть,"
      note "  но агент его не отдал — смотри права ~/.gnupg и живой gpg-agent"
    fi
    rm -f "$err" "$status"
  fi

  echo
  note "перенесено. Осталось:"
  note "  runsvdir подхватит службы сам — он уже смотрит в ~/.config/service"
  note "  проверить почту:  mailsync"
  note "  архив после проверки удалить: shred -u <архив>"
}

# --- which half ---------------------------------------------------------------

case "${1:-}" in
export)
  shift
  do_export "$@"
  ;;
import)
  shift
  do_import "$@"
  ;;
-h | --help | "")
  usage
  ;;
*)
  die "unknown command: $1 (export or import)"
  ;;
esac

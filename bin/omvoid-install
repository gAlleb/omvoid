#!/bin/bash

# The OMVOID installer.
#
# Asks everything up front, then installs without stopping.
#
# What it does is deliberately ordinary: partition, unpack packages from the
# mirror on this medium, and then run omvoid's own install.sh inside the new
# system. That last part is the point. install.sh is what configures a machine
# installed the long way, so using it here means there is one description of an
# omvoid system rather than two that drift apart.
#
# No network is needed. Every package, including its dependencies, is on the
# medium; omvoid-pkg-mirror put it there when the image was built.
#
# Why not the stock void-installer: it cannot set up an encrypted disk at all --
# its only mention of LUKS is a line that skips such partitions. It stays one
# keypress away for anything unusual.
#
# The encryption recipe is fixed, chosen rather than offered:
#
#   LUKS1, not LUKS2   GRUB reads LUKS2 only partially: of the key derivation
#                      functions it supports PBKDF2, not the argon2 cryptsetup
#                      now defaults to. GRUB unlocks the disk here.
#   no LVM             one filesystem in the container. Volumes buy nothing
#                      when there is one of them.
#   key in /boot       without it the passphrase is asked twice, by GRUB and
#                      again by the initramfs. The key lives inside the
#                      encrypted root, unreachable from outside.

set -euo pipefail

TARGET="/mnt"
CRYPT_NAME="void"
MIRROR="${OMVOID_MIRROR:-/var/cache/omvoid/mirror}"
LOGO="/usr/local/share/omvoid/logo.txt"
LOG="/var/log/omvoid-install.log"
ANSWERS="${OMVOID_ANSWERS:-/tmp/omvoid-install.conf}"

# Everything a machine needs before anything of ours.
BASE_PACKAGES="base-system grub-x86_64-efi cryptsetup lvm2 xtools"

die() {
  echo >&2
  echo "omvoid-install: $*" >&2
  echo "  log: $LOG" >&2
  exit 1
}

banner() {
  clear 2>/dev/null || true
  [[ -f $LOGO ]] && cat "$LOGO"
  echo
}

STEP_TOTAL=8
STEP_NOW=0
# Each step is timed, and the numbers are printed at the end. Twelve minutes
# against Omarchy's hundred seconds on the same machine is not something to
# reason about from the armchair -- the install can say where they went.
STEP_STARTED=0
STEP_TIMINGS=/tmp/omvoid-install.timings
: >"$STEP_TIMINGS"

step() {
  ((STEP_STARTED)) &&
    printf '%6d  %s\n' "$((SECONDS - STEP_STARTED))" "$STEP_NAME" >>"$STEP_TIMINGS"
  STEP_STARTED=$SECONDS
  STEP_NAME="$*"
  STEP_NOW=$((STEP_NOW + 1))
  printf '\n\033[1m[%d/%d] %s\033[0m\n' "$STEP_NOW" "$STEP_TOTAL" "$*"
}
ask_step() { printf '\n\033[1m%s\033[0m\n' "$*"; }
note() { printf '      %s\n' "$*"; }

# --- refuse to run anywhere it could destroy something real ------------------

[[ $EUID -eq 0 ]] || die "run as root"

# The live medium mounts itself here. On an installed system it does not exist,
# and this script would then be pointed at the disk it is running from.
[[ -d /run/initramfs/live ]] ||
  die "this only runs from the OMVOID live image — it formats a disk"

# Everything is written down as it happens. A failed install with nothing left
# behind can only be guessed at.
mkdir -p "$(dirname "$LOG")"
exec > >(tee -a "$LOG") 2>&1

# Every prompt is drawn straight on the terminal, never through the log.
#
# Everything here is teed to a file, which makes stdout and stderr pipes. gum
# renders its interface to stderr, and to a pipe it renders nothing at all --
# the question appears as a heading with no question under it, waiting for an
# answer nobody can see. install/config/identification.sh already knew this;
# adding the log undid it.
ask() {
  local prompt="$1" default="${2:-}" reply
  if command -v gum >/dev/null; then
    gum input --prompt "$prompt " --value "$default" 2>/dev/tty
  else
    read -r -p "$prompt [$default] " reply </dev/tty >/dev/tty
    printf '%s' "${reply:-$default}"
  fi
}

# Asked twice and never echoed. Kept in a variable only -- deliberately not
# written to the answers file: that file exists so an install can be repeated
# unattended, and a password left in it would sit in plain text on the medium.
ask_secret() {
  local prompt="$1" first second
  while :; do
    if command -v gum >/dev/null; then
      first=$(gum input --password --prompt "$prompt " 2>/dev/tty)
      second=$(gum input --password --prompt "repeat: " 2>/dev/tty)
    else
      read -rs -p "$prompt " first </dev/tty >/dev/tty; echo >/dev/tty
      read -rs -p "repeat: " second </dev/tty >/dev/tty; echo >/dev/tty
    fi
    [[ -z $first ]] && { printf '  empty, try again\n' >/dev/tty; continue; }
    [[ $first == "$second" ]] && break
    printf '  they do not match, try again\n' >/dev/tty
  done
  printf '%s' "$first"
}

confirm() {
  if command -v gum >/dev/null; then
    gum confirm "$1" 2>/dev/tty
  else
    local reply
    read -r -p "$1 [y/N] " reply </dev/tty >/dev/tty
    [[ ${reply,,} == y* ]]
  fi
}

choose() {
  if command -v gum >/dev/null; then
    gum choose --header "$1" 2>/dev/tty
  else
    local options=() n=1 reply
    mapfile -t options
    echo "$1" >/dev/tty
    for o in "${options[@]}"; do echo "  $((n++)). $o" >/dev/tty; done
    read -r -p "number: " reply </dev/tty >/dev/tty
    printf '%s' "${options[$((reply - 1))]}"
  fi
}

# --- simple or advanced ------------------------------------------------------

banner

if ! confirm "Install OMVOID with the guided installer? (No opens void-installer)"; then
  exec void-installer
fi

# --- the questions, all of them, before anything is written ------------------
#
# Written to a file as they are answered, and read back if that file already
# exists. That makes an unattended install possible: put the file on the medium
# and nothing is asked at all.

if [[ -f $ANSWERS ]]; then
  # shellcheck disable=SC1090
  . "$ANSWERS"
  # The plan is one line in the file and a list here. Converted only on this
  # path: on the other one MOUNTS is already an array, and "${MOUNTS:-}" would
  # quietly collapse it to its first element.
  read -r -a MOUNTS <<<"${MOUNTS:-}"
  banner
  note "using answers from $ANSWERS"
else
  banner
  ask_step "Disk"
  mapfile -t disks < <(lsblk -dnp -o NAME,SIZE,MODEL -e 7,11 | sed 's/  */ /g')
  ((${#disks[@]})) || die "no disks found"
  disk_line=$(printf '%s\n' "${disks[@]}" |
    choose "Which disk should OMVOID be installed on?")
  DISK=$(awk '{print $1}' <<<"$disk_line")

  # Two ways to prepare it. The guided one owns the whole disk, which is what a
  # machine dedicated to omvoid wants. The other exists for a disk that already
  # has a system on it: partition it by hand, then say which partition is which,
  # and -- the point of the whole thing -- keep the EFI partition that is already
  # there instead of formatting it and taking the other system's bootloader with
  # it.
  layout_line=$(printf '%s\n' \
    "erase $DISK and let the installer partition it" \
    "partition it myself, and choose where things go" |
    choose "How should $DISK be prepared?")
  case "$layout_line" in
  erase*) LAYOUT=whole ;;
  *) LAYOUT=advanced ;;
  esac

  if [[ $LAYOUT == advanced ]]; then
    note "cfdisk opens now. Make the partitions you want, write, and quit."
    note "An EFI partition is type 'EFI System'. Keep the existing one if there is one."
    confirm "Open cfdisk on $DISK?" || die "nothing was changed"
    cfdisk "$DISK" </dev/tty >/dev/tty 2>&1
    partx -u "$DISK" 2>/dev/null || partprobe "$DISK" 2>/dev/null || true
    sleep 1

    mapfile -t parts < <(lsblk -pnl -o NAME,SIZE,FSTYPE,PARTTYPENAME "$DISK" |
      awk 'NR>1 {$1=$1; print}')
    ((${#parts[@]})) || die "no partitions on $DISK"

    # Asked per partition, not per role. You made these partitions; the installer
    # walks through them and asks what each one is. Anything left as "leave alone"
    # is not touched -- which is the whole point on a disk that already carries
    # another system.
    MOUNTS=()
    for part_line in "${parts[@]}"; do
      part=$(awk '{print $1}' <<<"$part_line")
      role=$( {
        printf 'leave alone\n/\n/home\n/boot/efi\nswap\nsomewhere else\n'
      } | choose "$part_line")

      case "$role" in
      "leave alone") continue ;;
      "somewhere else")
        mp=$(ask "Mount $part where? (absolute path)" "")
        [[ $mp == /* ]] || die "not an absolute path: $mp"
        ;;
      *) mp="$role" ;;
      esac

      # Formatting is a separate question for every one of them, and the default
      # differs: a root is always made fresh, an EFI partition and a /home
      # usually exist to be kept, and swap holds nothing worth keeping.
      case "$mp" in
      /)
        fmt=yes
        ROOT_PART="$part"
        ;;
      swap)
        fmt=yes
        SWAP_PART="$part"
        ;;
      /boot/efi)
        EFI_PART="$part"
        if confirm "Format $part? Say no to keep what is on it (another system's bootloader)."; then
          fmt=yes
        else
          fmt=no
        fi
        ;;
      *)
        if confirm "Format $part? Say no to keep the files that are on it."; then
          fmt=yes
        else
          fmt=no
        fi
        ;;
      esac

      MOUNTS+=("$part=$mp=$fmt")
    done

    [[ -n ${ROOT_PART:-} ]] || die "no partition was given to /"
    [[ -n ${EFI_PART:-} ]] || die "no EFI system partition was chosen"
    FORMAT_EFI=$(printf '%s\n' "${MOUNTS[@]}" | awk -F= '$2=="/boot/efi"{print $3}')


  else
    ROOT_PART=""
    EFI_PART=""
    SWAP_PART=""
    MOUNTS=()
    FORMAT_EFI=yes
  fi

  ask_step "Encryption"
  if confirm "Encrypt the disk? The passphrase is asked at every boot."; then
    ENCRYPT=yes
  else
    ENCRYPT=no
  fi

  ask_step "System"
  HOSTNAME=$(ask "Hostname:" "void")
  TIMEZONE=$(ask "Timezone:" "Europe/Moscow")
  KEYMAP=$(ask "Console keymap:" "us")
  LOCALE=$(ask "Locale (this becomes LANG):" "en_US.UTF-8")
  # Generated as well as the one above. Someone who reads and writes in two
  # languages needs both present, and only one of them can be LANG.
  EXTRA_LOCALES=$(ask "Other locales to generate, space separated:" "")

  ask_step "User"
  USERNAME=$(ask "Username:" "")
  FULLNAME=$(ask "Full name:" "")

  ask_step "Git"
  GIT_NAME=$(ask "git user.name:" "$FULLNAME")
  GIT_EMAIL=$(ask "git user.email:" "")

  # Asked here, not left to install/config/swap.sh: that step runs inside the
  # chroot, where there is nobody to answer and where "swapon --show" reports the
  # live system rather than the one being installed.
  #
  # And asked only when there is no swap partition. The question used to come
  # after the partitions were assigned and overwrote that decision, so a disk with
  # a swap partition was offered a swap file as well.
  if [[ -n ${SWAP_PART:-} ]]; then
    SWAP_MB=0
    note "swap partition $SWAP_PART — no swap file"
  else
    ask_step "Swap"
    swap_gib=$(ask "Swap file, GiB (0 for none):" "4")
    SWAP_MB=$((${swap_gib:-0} * 1024))
  fi

  ask_step "Weather"
  # The waybar forecast and the tmux status line are set from this. Asked here
  # because install.sh asks for it too, and nothing should be asked twice.
  CITY=$(ask "City for the weather report:" "")

  cat >"$ANSWERS" <<EOF
DISK="$DISK"
LAYOUT="$LAYOUT"
ROOT_PART="$ROOT_PART"
EFI_PART="$EFI_PART"
FORMAT_EFI="$FORMAT_EFI"
ENCRYPT="$ENCRYPT"
HOSTNAME="$HOSTNAME"
TIMEZONE="$TIMEZONE"
KEYMAP="$KEYMAP"
LOCALE="$LOCALE"
EXTRA_LOCALES="$EXTRA_LOCALES"
USERNAME="$USERNAME"
FULLNAME="$FULLNAME"
GIT_NAME="$GIT_NAME"
GIT_EMAIL="$GIT_EMAIL"
CITY="$CITY"
SWAP_MB="$SWAP_MB"
SWAP_PART="${SWAP_PART:-}"
MOUNTS="${MOUNTS[*]}"
EOF
fi

# Outside the block above, so a repeated install asks for these and only these:
# everything else comes from the answers file, and passwords are never in it.
#
# Asked here rather than half an hour later, when the account is created. The
# installer used to stop in the middle -- a few questions, a long package
# install, then two more questions -- and there was no reason for it beyond the
# order the steps happened to be written in.
ask_step "Passwords"
USER_PASSWORD=$(ask_secret "Password for ${USERNAME:-the user}:")
ROOT_PASSWORD=$(ask_secret "Password for root:")

# An answers file written before this existed names no layout.
LAYOUT="${LAYOUT:-whole}"
SWAP_MB="${SWAP_MB:-4096}"
SWAP_PART="${SWAP_PART:-}"
FORMAT_EFI="${FORMAT_EFI:-yes}"

[[ -n ${USERNAME:-} ]] || die "a username is required"
[[ -b ${DISK:-} ]] || die "not a block device: ${DISK:-<none>}"
[[ -d $MIRROR ]] || die "no package mirror at $MIRROR — this medium is incomplete"

# NVMe and loop devices number their partitions p1, p2; sd* do not.
if [[ $DISK == *[0-9] ]]; then PART_PREFIX="${DISK}p"; else PART_PREFIX="$DISK"; fi

# --- the last chance to stop -------------------------------------------------

if [[ $LAYOUT == advanced ]]; then
  ask_step "About to install onto $ROOT_PART"
else
  ask_step "About to erase $DISK"
fi
lsblk "$DISK"
echo
if [[ $LAYOUT == advanced ]]; then
  note "/           $ROOT_PART  (formatted)"
  note "EFI         $EFI_PART  ($([[ $FORMAT_EFI == yes ]] && echo formatted || echo "kept as it is"))"
  note "everything else on $DISK is left alone"
fi
note "encryption: $ENCRYPT"
note "hostname:   $HOSTNAME"
note "user:       $USERNAME"
echo
if [[ $LAYOUT == advanced ]]; then
  confirm "$ROOT_PART will be formatted. Continue?" || die "nothing was changed"
else
  confirm "Everything on $DISK will be destroyed. Continue?" || die "nothing was changed"
fi

[[ $ENCRYPT == yes ]] && STEP_TOTAL=9

# --- partitions --------------------------------------------------------------
#
# Two of them. The EFI partition stays unencrypted because the firmware has to
# read it; everything else goes inside the container.

if [[ $LAYOUT == whole ]]; then
  step "Partitioning $DISK"
  wipefs -a "$DISK" >/dev/null
  sfdisk "$DISK" >/dev/null <<EOF
label: gpt
size=512M, type=uefi, name="EFI"
type=linux, name="void"
EOF
  partx -u "$DISK" 2>/dev/null || partprobe "$DISK" 2>/dev/null || true
  sleep 1

  EFI_PART="${PART_PREFIX}1"
  ROOT_PART="${PART_PREFIX}2"
else
  step "Using the partitions you chose"
fi
[[ -b $EFI_PART && -b $ROOT_PART ]] ||
  die "not both partitions are there: ${ROOT_PART:-<none>} and ${EFI_PART:-<none>}"

if [[ $ENCRYPT == yes ]]; then
  step "Creating the encrypted container"
  note "You will be asked for the passphrase, then for it again to unlock."
  # Straight on the terminal: everything here is teed to a log, and a passphrase
  # prompt that goes through a pipe is a prompt nobody sees.
  cryptsetup luksFormat --type luks1 "$ROOT_PART" </dev/tty >/dev/tty 2>&1
  cryptsetup luksOpen "$ROOT_PART" "$CRYPT_NAME" </dev/tty >/dev/tty 2>&1
  ROOT_DEV="/dev/mapper/$CRYPT_NAME"
else
  ROOT_DEV="$ROOT_PART"
fi

step "Filesystems"
mkfs.ext4 -F -L root "$ROOT_DEV" >/dev/null
mount "$ROOT_DEV" "$TARGET"

if ((${#MOUNTS[@]})); then
  # Everything else that was assigned, shallowest path first: /home has to land
  # on top of the root that is already mounted, not underneath it.
  while read -r _depth entry; do
    part=${entry%%=*}
    rest=${entry#*=}
    mp=${rest%%=*}
    fmt=${rest##*=}

    [[ $mp == / ]] && continue

    if [[ $mp == swap ]]; then
      mkswap "$part" >/dev/null
      # On, so xgenfstab records it later; off again before the disk is released.
      swapon "$part"
      continue
    fi

    case "$fmt:$mp" in
    yes:/boot/efi) mkfs.vfat -F32 -n EFI "$part" >/dev/null ;;
    yes:*) mkfs.ext4 -F "$part" >/dev/null ;;
    *) note "keeping $part as it is" ;;
    esac

    mkdir -p "$TARGET$mp"
    mount "$part" "$TARGET$mp" || die "could not mount $part on $mp"
  done < <(
    for m in "${MOUNTS[@]}"; do
      mp=${m#*=}
      mp=${mp%%=*}
      printf '%s %s\n' "$(tr -cd / <<<"$mp" | wc -c)" "$m"
    done | sort -n
  )
else
  # The guided layout: one EFI partition, always made fresh.
  mkfs.vfat -F32 -n EFI "$EFI_PART" >/dev/null
  mkdir -p "$TARGET/boot/efi"
  mount "$EFI_PART" "$TARGET/boot/efi"
fi

# --- the system --------------------------------------------------------------
#
# Installed, not copied. Everything comes from the mirror on this medium, so
# this works with the network unplugged and always produces the same versions
# the image was built with.

step "Installing packages"

# xbps refuses unsigned packages unless it knows the keys. The live medium
# already trusts everything we ship, so its keys go across first.
mkdir -p "$TARGET/var/db/xbps/keys"
cp -f /var/db/xbps/keys/*.plist "$TARGET/var/db/xbps/keys/" 2>/dev/null || true

# The mirror is made visible inside the target as a repository of its own.
#
# Not only for this install: omvoid's install.sh runs in here afterwards, and
# several of its steps call "xbps-install -S", which means syncing repositories.
# With a local path to sync from, those work offline and instantly. Without it,
# six steps would reach for the network on a machine that may not have one, and
# the first of them would end the install.
#
# Removed again at the end -- the mirror lives on the medium, not on the disk.
mkdir -p "$TARGET/var/cache/omvoid/mirror" "$TARGET/etc/xbps.d"

# Declared before the first mount, not after: a failure in between would
# otherwise leave the medium mounted inside the target with nothing to undo it.
cleanup() {
  # Before the mounts: a swap partition turned on for xgenfstab's benefit keeps
  # the disk busy otherwise.
  [[ -n ${SWAP_PART:-} ]] && swapoff "$SWAP_PART" 2>/dev/null
  for d in sys proc dev; do umount -R -f "$TARGET/$d" 2>/dev/null || true; done
  umount -f "$TARGET/var/cache/omvoid/mirror" 2>/dev/null || true
}
trap cleanup EXIT

mount --bind "$MIRROR" "$TARGET/var/cache/omvoid/mirror"
echo "repository=/var/cache/omvoid/mirror" >"$TARGET/etc/xbps.d/00-omvoid-mirror.conf"

# Only the base here. Everything else is installed by install.sh, step by step,
# from this same mirror -- because the steps are what describe the system, and
# they are the path an ordinary install takes too. Preinstalling the lot from the
# medium was tried and measured: it moves the work rather than removing it and
# buys about a minute, at the price of a second notion of what the system
# contains and of the medium's own tools ending up on the disk.

XBPS_ARCH=x86_64 xbps-install --repository="$MIRROR" --rootdir "$TARGET" \
  --yes --sync $BASE_PACKAGES ||
  die "installing packages failed"

# --- identity ----------------------------------------------------------------

step "System settings"
echo "$HOSTNAME" >"$TARGET/etc/hostname"
ln -sf "/usr/share/zoneinfo/$TIMEZONE" "$TARGET/etc/localtime"
echo "LANG=$LOCALE" >"$TARGET/etc/locale.conf"

# Every locale that should exist on the machine, the LANG one included.
#
# Uncommented in place where the file already lists it -- Void ships them all,
# commented out -- and appended only when it does not. Appending blindly leaves
# a duplicate every time this runs.
enable_locale() {
  local name="$1" file="$TARGET/etc/default/libc-locales"
  [[ -n $name ]] || return 0
  if grep -qE "^#\s*${name} " "$file" 2>/dev/null; then
    sed -i "s|^#\s*\(${name} .*\)|\1|" "$file"
  elif ! grep -qE "^${name} " "$file" 2>/dev/null; then
    echo "$name UTF-8" >>"$file"
  fi
  note "locale: $name"
}

enable_locale "$LOCALE"
for extra in ${EXTRA_LOCALES:-}; do enable_locale "$extra"; done
sed -i "s/^KEYMAP=.*/KEYMAP=$KEYMAP/" "$TARGET/etc/rc.conf" 2>/dev/null || true

for d in dev proc sys; do mount --rbind "/$d" "$TARGET/$d" --make-rslave; done

# The new system needs a resolver only if something reaches for the network;
# nothing here does, but a step of omvoid's might.
cp -f /etc/resolv.conf "$TARGET/etc/resolv.conf" 2>/dev/null || true

in_target() { chroot "$TARGET" /bin/bash -c "$1"; }

in_target "xbps-reconfigure -f glibc-locales" >/dev/null 2>&1 || true

# dbus generates this at boot, but install.sh runs before any boot and anything
# autolaunching a session bus needs it to exist first.
[[ -s $TARGET/etc/machine-id ]] ||
  in_target "dbus-uuidgen --ensure=/etc/machine-id" 2>/dev/null || true

step "Account"
in_target "useradd -m -G wheel,audio,video,input,network,storage,users -c '$FULLNAME' '$USERNAME'"
# In /etc/sudoers itself, where a hand-installed Void keeps it -- not as a file
# in sudoers.d.
#
# "@includedir /etc/sudoers.d" is the last line of /etc/sudoers, so everything in
# that directory is read after it, and sudoers gives the win to the last matching
# rule. A %wheel line sitting in sudoers.d therefore cancels every NOPASSWD file
# whose name sorts before "wheel" -- install/development/mihomo.sh writes
# "omvoid-mihomo", and passwordless control of that service quietly stopped
# working on machines installed from the image, while it kept working on machines
# installed by hand. Same repository, different behaviour, no error anywhere.
in_target "sed -i 's/^# *%wheel ALL=(ALL:ALL) ALL\$/%wheel ALL=(ALL:ALL) ALL/' /etc/sudoers"
if ! in_target "grep -q '^%wheel ALL=(ALL:ALL) ALL' /etc/sudoers && visudo -c -q" 2>/dev/null; then
  # The stock line was not where it was expected. Better a working machine than a
  # tidy one -- but named to sort first, so later NOPASSWD rules still win.
  note "could not uncomment %wheel in /etc/sudoers — using /etc/sudoers.d/00-wheel"
  echo '%wheel ALL=(ALL:ALL) ALL' >"$TARGET/etc/sudoers.d/00-wheel"
  chmod 440 "$TARGET/etc/sudoers.d/00-wheel"
fi

# Hashed here, written with "chpasswd -e".
#
# Plain "chpasswd" goes through PAM on Void, and inside a chroot PAM quietly does
# nothing at all: it returns 0, prints not a word, and /etc/shadow keeps the "!"
# it was created with. An install then finishes reporting success and hands over
# a machine nobody can log into -- which is exactly what happened. With -e the
# value is already encrypted, so chpasswd writes the file itself.
#
# Both passwords reach openssl on standard input and the hashes reach chpasswd
# the same way: neither ever appears on a command line for ps to show.
user_hash=$(printf '%s' "$USER_PASSWORD" | openssl passwd -6 -stdin) ||
  die "could not hash the password"
root_hash=$(printf '%s' "$ROOT_PASSWORD" | openssl passwd -6 -stdin) ||
  die "could not hash the root password"

printf '%s:%s\n%s:%s\n' "$USERNAME" "$user_hash" root "$root_hash" |
  chroot "$TARGET" chpasswd -e || die "setting the passwords failed"

# Checked, not assumed. The whole reason this went unnoticed is that the command
# reported success while doing nothing.
in_target "grep -q '^$USERNAME:\\\$6\\\$' /etc/shadow" ||
  die "the password for $USERNAME was not written to /etc/shadow"
in_target "grep -q '^root:\\\$6\\\$' /etc/shadow" ||
  die "the root password was not written to /etc/shadow"
note "passwords set for $USERNAME and root"

# --- omvoid itself -----------------------------------------------------------
#
# A checkout in the user's home, because that is what omvoid is: not a package,
# but a repository that stays on the machine and keeps owning its configs. With
# its history, or omvoid-update would have nothing to pull into.

step "Configuring the system"
omvoid_repo="$TARGET/home/$USERNAME/.local/share/omvoid"
mkdir -p "$(dirname "$omvoid_repo")"
cp -a /usr/local/share/omvoid/repo "$omvoid_repo"

# tmux plugins are baked onto the medium, but config.sh looks for them at the
# live path -- which does not exist inside the chroot. Put them where it looks;
# it copies them into the user's home and the staging copy goes away below.
if [[ -d /usr/local/share/omvoid/tmux-plugins ]]; then
  mkdir -p "$TARGET/usr/local/share/omvoid"
  cp -a /usr/local/share/omvoid/tmux-plugins "$TARGET/usr/local/share/omvoid/"
fi

# The answers already given, so install.sh asks nothing.
mkdir -p "$TARGET/home/$USERNAME/.local/state/omvoid"
cat >"$TARGET/home/$USERNAME/.local/state/omvoid/install-answers" <<EOF
OMVOID_GIT_NAME="$GIT_NAME"
OMVOID_GIT_EMAIL="$GIT_EMAIL"
OMVOID_CITY="$CITY"
OMVOID_SWAP_MB="$SWAP_MB"
EOF

# Ownership last, after everything written as root.
#
# Done any earlier it misses whatever is created afterwards, and the first thing
# install.sh does is redirect its output into ~/.local/state/omvoid -- into a
# directory it cannot write. With set -e that ends the install on its first
# line, with no log to say why and not a single step run.
in_target "chown -R '$USERNAME:$USERNAME' /home/$USERNAME/.local"

# install.sh runs as the user and uses sudo for the system half. There is no
# password to give it here, so sudo is opened for the duration and closed again
# immediately afterwards -- leaving it open would ship a machine anyone can take
# root on.
#
# The name has to sort AFTER "wheel". sudoers.d is read in lexical order and the
# last matching rule wins, so 00-omvoid-install was read first and then undone by
# %wheel's ordinary rule -- install.sh died on its own "sudo -v" with "a terminal
# is required to read the password", inside a chroot where there is nobody to
# type one.
echo "$USERNAME ALL=(ALL) NOPASSWD: ALL" >"$TARGET/etc/sudoers.d/zz-omvoid-install"
chmod 440 "$TARGET/etc/sudoers.d/zz-omvoid-install"

# fstab before install.sh, not after.
#
# Everything is mounted by now, so the generated file is already right -- and
# install/config/swap.sh appends its swap file line to it. Generated afterwards,
# as it was, the regeneration threw that line away: the file existed, nothing
# referred to it, and the installed machine came up with no swap at all.
xgenfstab "$TARGET" >"$TARGET/etc/fstab" 2>/dev/null ||
  in_target "xgenfstab / > /etc/fstab"

note "running omvoid's own install.sh inside the new system"
in_target "su - '$USERNAME' -c 'OMVOID_IN_CHROOT=1 bash ~/.local/share/omvoid/install.sh'" ||
  note "install.sh reported problems — see $LOG"

rm -f "$TARGET/etc/sudoers.d/zz-omvoid-install"
rm -rf "$TARGET/usr/local/share/omvoid"

# --- boot --------------------------------------------------------------------

step "Bootloader"
if [[ $ENCRYPT == yes ]]; then
  # The UUID of the container, not of the filesystem inside it.
  luks_uuid=$(blkid -o value -s UUID "$ROOT_PART")

  # A key file so the passphrase is typed once. It lives inside the encrypted
  # root, so it is only readable once the disk is already open.
  dd bs=1 count=64 if=/dev/urandom of="$TARGET/boot/volume.key" status=none
  # Asks for the existing passphrase, so it needs the terminal too.
  cryptsetup luksAddKey "$ROOT_PART" "$TARGET/boot/volume.key" </dev/tty >/dev/tty 2>&1
  chmod 000 "$TARGET/boot/volume.key"
  chmod -R g-rwx,o-rwx "$TARGET/boot"

  echo "$CRYPT_NAME  $ROOT_PART  /boot/volume.key  luks" >"$TARGET/etc/crypttab"
  mkdir -p "$TARGET/etc/dracut.conf.d"
  echo 'install_items+=" /boot/volume.key /etc/crypttab "' \
    >"$TARGET/etc/dracut.conf.d/10-crypt.conf"

  sed -i 's/^#\?GRUB_ENABLE_CRYPTODISK=.*/GRUB_ENABLE_CRYPTODISK=y/' "$TARGET/etc/default/grub"
  grep -q '^GRUB_ENABLE_CRYPTODISK=y' "$TARGET/etc/default/grub" ||
    echo 'GRUB_ENABLE_CRYPTODISK=y' >>"$TARGET/etc/default/grub"

  sed -i "s|^GRUB_CMDLINE_LINUX_DEFAULT=\"|GRUB_CMDLINE_LINUX_DEFAULT=\"rd.luks.uuid=$luks_uuid |" \
    "$TARGET/etc/default/grub"
fi

# Intel machines get intel_iommu=off.
#
# On this hardware the console fills with DMAR faults from the first seconds --
# far enough that a login prompt cannot be used at all. It happens on Void's own
# images too, so it is the machine rather than anything omvoid does. The cost is
# that DMA remapping is off: it matters for passing devices through to virtual
# machines, and for little else here.
#
# Checked against the CPU, not the graphics: it is the chipset's IOMMU.
# The second test keeps a repeated install from writing it twice -- the sed below
# inserts rather than replaces.
if grep -q GenuineIntel /proc/cpuinfo &&
  ! grep -q 'intel_iommu=' "$TARGET/etc/default/grub"; then
  sed -i 's|^GRUB_CMDLINE_LINUX_DEFAULT="|GRUB_CMDLINE_LINUX_DEFAULT="intel_iommu=off |' \
    "$TARGET/etc/default/grub"
  grep -q 'intel_iommu=off' "$TARGET/etc/default/grub" ||
    echo 'GRUB_CMDLINE_LINUX_DEFAULT="intel_iommu=off"' >>"$TARGET/etc/default/grub"
  note "Intel CPU — intel_iommu=off added to the kernel command line"
fi

mountpoint -q /sys/firmware/efi/efivars ||
  mount -t efivarfs none /sys/firmware/efi/efivars 2>/dev/null || true

# os-prober is installed but GRUB does not call it unless told to, and without it
# a system sharing this disk simply disappears from the boot menu -- the machine
# looks as though the install ate it. Harmless when there is nothing to find.
grep -q '^GRUB_DISABLE_OS_PROBER=false' "$TARGET/etc/default/grub" ||
  echo 'GRUB_DISABLE_OS_PROBER=false' >>"$TARGET/etc/default/grub"

# --bootloader-id keeps this out of the way of whatever else boots from the same
# EFI partition: each system gets its own directory under EFI/.
in_target "grub-install --target=x86_64-efi --efi-directory=/boot/efi --bootloader-id=OMVOID" ||
  die "grub-install failed"

# And again as the removable fallback, EFI/BOOT/BOOTX64.EFI.
#
# The first install writes EFI/OMVOID and an entry in the firmware's NVRAM, and
# the machine boots by that entry alone. Lose the NVRAM -- a flat coin cell, a
# "clear NVRAM" in the firmware menu, the disk moved to another machine -- and
# there is nothing left to start: the ESP holds a bootloader no firmware looks
# for by default. This is the path every firmware falls back to.
#
# Only when the EFI partition is ours. There is one such path per partition and
# the last writer takes it -- systemd-boot claims it too, and on many machines it
# is what boots Windows. On a partition we made, nobody else has put anything
# there; on one that already existed, someone may have, and overwriting it points
# their fallback at our GRUB.
if [[ $FORMAT_EFI == yes ]]; then
  in_target "grub-install --target=x86_64-efi --efi-directory=/boot/efi --removable" ||
    note "could not install the removable fallback — the disk boots by NVRAM only"
fi

# Builds the initramfs, with the crypt key and modules when encrypted. Skipping
# this is how an encrypted install ends up unable to open its own disk.
#
# It reconfigures every installed package, which on a full system is a few
# minutes. Shown as it goes: silence here is indistinguishable from a hang.
# "-a", not "-fa".
#
# Without -f only packages that are *not* configured are processed -- and ours
# are configured already: xbps ran their scripts while unpacking them into the
# target, which the log shows package by package ("configuring ... installed
# successfully"). Packages are left unconfigured only with -U, which we do not
# pass. So -fa was a second full pass over some twelve hundred packages, running
# every one of their install scripts again: font caches, icon caches, glib
# schemas, man-db, the initramfs. pacman has no such pass at all, and that is a
# large part of why the same machine installs Omarchy in a hundred seconds and
# this in twelve minutes.
#
# The kernel is still reconfigured by force, because that is what rebuilds the
# initramfs, and an encrypted install that skips it cannot open its own disk.
note "configuring what is left and building the initramfs"
in_target "xbps-reconfigure -a" 2>&1 | while read -r line; do
  printf '\r      %-70.70s' "$line"
done

# By name, whatever kernel this turned out to be. If it cannot be found, fall
# back to reconfiguring everything: a slow install beats one that will not boot.
kernel_pkg=$(chroot "$TARGET" xbps-query -l 2>/dev/null |
  awk '{print $2}' | grep -oE '^linux[0-9]+\.[0-9]+' | head -1 || true)
if [[ -n $kernel_pkg ]]; then
  in_target "xbps-reconfigure -f $kernel_pkg" >/dev/null 2>&1 ||
    die "could not rebuild the initramfs for $kernel_pkg"
else
  note "kernel package not identified — reconfiguring everything instead"
  in_target "xbps-reconfigure -fa" >/dev/null 2>&1 || true
fi
printf '\r      %-70s\n' "done"

# Explicitly, because nothing else does it now.
#
# grub-install writes the bootloader but not its configuration; the menu came
# from the grub package's own script, which "xbps-reconfigure -fa" used to run
# for us. With -a it does not, so this has to be said out loud -- and this is
# also where os-prober runs and finds the neighbours.
in_target "grub-mkconfig -o /boot/grub/grub.cfg" >/dev/null 2>&1 ||
  die "could not generate the boot menu"
in_target "test -s /boot/grub/grub.cfg" ||
  die "/boot/grub/grub.cfg is missing — the machine would not boot"

# --- done --------------------------------------------------------------------

step "Done"

# The last step closed, then everything, slowest first.
printf '%6d  %s\n' "$((SECONDS - STEP_STARTED))" "$STEP_NAME" >>"$STEP_TIMINGS"
echo
echo "seconds per step, slowest first:"
sort -rn "$STEP_TIMINGS"
printf '%6d  total\n' "$SECONDS"
echo

# The temporary repository goes away with the medium it points at. Left behind,
# the installed machine would carry a repository entry for a directory that is
# empty, and every xbps command would complain about it.
rm -f "$TARGET/etc/xbps.d/00-omvoid-mirror.conf"
rm -f "$TARGET/etc/resolv.conf"
rmdir "$TARGET/var/cache/omvoid/mirror" "$TARGET/var/cache/omvoid" 2>/dev/null || true

cleanup
umount -R "$TARGET" 2>/dev/null || true

banner
cat <<EOF

  OMVOID is installed on $DISK.

    user:      $USERNAME
    hostname:  $HOSTNAME
$([[ $ENCRYPT == yes ]] && echo "    disk:      encrypted, the passphrase is asked once, by GRUB")

  Take the installation medium out before the machine starts again,
  or it will boot the installer instead of the system.

EOF

if confirm "Reboot now?"; then
  echo
  note "Rebooting. Remove the medium."
  sleep 2
  reboot
else
  echo
  note "Reboot when ready:  reboot"
  echo
fi

#!/bin/bash

# Boots an OMVOID ISO in qemu, against a scratch disk.
#
#   omvoid-iso-test                 boot the newest built ISO, install onto the disk
#   omvoid-iso-test -b              boot the disk alone, to see what was installed
#   omvoid-iso-test -n              start from an empty disk again
#   omvoid-iso-test -i <file.iso>   a particular image
#
# UEFI is used when the firmware is available, because that is what the real
# machines boot -- and an encrypted install depends on it: the EFI partition
# stays unencrypted so the firmware can read it, and GRUB unlocks the rest.
# Without OVMF the guest falls back to BIOS, which still proves the image boots
# and installs, but tests a different boot path than the one we ship.
#
#   sudo xbps-install -y edk2-ovmf

set -euo pipefail

ISO_DIR="$HOME/.cache/omvoid/iso"
DISK="$ISO_DIR/test-disk.qcow2"
# Overridable: 24G is enough for one system, and not for testing an install
# beside another one.
#
#   OMVOID_TEST_DISK_SIZE=40G omvoid-iso-test -n
DISK_SIZE="${OMVOID_TEST_DISK_SIZE:-24G}"
MEMORY="4G"
CPUS="2"
# The guest's video card. "gl" is virtio with virgl: the guest gets a render
# node (/dev/dri/renderD128) and mango draws through the host's GPU, as it would
# on hardware -- the desktop is usable, and this is what someone trying omvoid
# in a VM will see. "std" is plain Bochs VGA with no 3D: mango then refuses to
# start at all (black screen after the SDDM login). It is still enough to test
# the installer when the host has no working OpenGL, and it is the card the
# installer was first tested on.
#
#   OMVOID_TEST_VGA=std omvoid-iso-test -b
VGA="${OMVOID_TEST_VGA:-gl}"

iso=""
disk_only=false
fresh=false

while getopts "i:bnh" opt; do
  case "$opt" in
  i) iso="$OPTARG" ;;
  b) disk_only=true ;;
  n) fresh=true ;;
  h)
    sed -n '3,9p' "$0" | sed 's/^# \?//'
    exit 0
    ;;
  *) exit 1 ;;
  esac
done

command -v qemu-system-x86_64 >/dev/null || {
  echo "omvoid-iso-test: qemu-system-x86_64 not installed" >&2
  exit 1
}

if ! $disk_only; then
  [[ -n $iso ]] || iso=$(ls -t "$ISO_DIR"/*.iso 2>/dev/null | head -1)
  [[ -n $iso && -f $iso ]] || {
    echo "omvoid-iso-test: no ISO found in $ISO_DIR — build one with omvoid-iso-build" >&2
    exit 1
  }
fi

$fresh && rm -f "$DISK"
if [[ ! -f $DISK ]]; then
  echo "==> new scratch disk, $DISK_SIZE"
  qemu-img create -f qcow2 "$DISK" "$DISK_SIZE" >/dev/null
fi

# The monitor is on telnet rather than a unix socket so it can be driven with
# bash's /dev/tcp alone, without socat. It is what makes "screendump" available:
# a guest that stops at a text console can be read without asking a person to
# take a photograph of their screen.
MONITOR_PORT="${OMVOID_QEMU_MONITOR_PORT:-55555}"

args=(
  -enable-kvm
  -m "$MEMORY" -smp "$CPUS"
  -drive "file=$DISK,format=qcow2,if=virtio"
  -net nic -net user
  # A tablet instead of the default PS/2 mouse: it reports absolute positions,
  # so the guest's pointer sits where the host's is instead of lagging and
  # drifting away from it.
  -device qemu-xhci -device usb-tablet
  -monitor "telnet:127.0.0.1:$MONITOR_PORT,server,nowait"
)

# virtio-vga was dropped once because, with a forced resolution, qemu drew its
# mode with the wrong row stride and the whole screen came out sheared along a
# diagonal. Nothing forces a resolution now; if the shear comes back, it is
# OMVOID_TEST_VGA=std until it is understood.
case "$VGA" in
gl) args+=(-device virtio-vga-gl -display gtk,gl=on,zoom-to-fit=off) ;;
std) args+=(-vga std -display gtk,zoom-to-fit=off) ;;
*)
  echo "omvoid-iso-test: OMVOID_TEST_VGA is gl or std, not '$VGA'" >&2
  exit 1
  ;;
esac
echo "==> video: $VGA"

# The firmware is a pair: read-only code, and a writable copy of the variable
# store per machine -- otherwise the guest cannot remember its own boot entry,
# and an installed system would never come up again.
# OVMF_CODE.fd first, deliberately. The single-file OVMF.fd carries code and
# variables together, and mounted read-only it cannot remember anything -- an
# installed guest would lose its boot entry and never come up again.
firmware_code=$(ls /usr/share/{edk2/x64,ovmf,OVMF,edk2-ovmf}/OVMF_CODE.fd 2>/dev/null | head -1 || true)
[[ -n $firmware_code ]] || firmware_code=$(ls /usr/share/{edk2/x64,ovmf,OVMF,edk2-ovmf}/OVMF.fd 2>/dev/null | head -1 || true)
firmware_vars=$(ls /usr/share/{edk2/x64,ovmf,OVMF,edk2-ovmf}/OVMF_VARS.fd 2>/dev/null | head -1 || true)

if [[ -n $firmware_code ]]; then
  echo "==> UEFI ($firmware_code)"
  args+=(-drive "if=pflash,format=raw,readonly=on,file=$firmware_code")
  if [[ -n $firmware_vars ]]; then
    local_vars="$ISO_DIR/ovmf-vars.fd"
    [[ -f $local_vars ]] || cp "$firmware_vars" "$local_vars"
    args+=(-drive "if=pflash,format=raw,file=$local_vars")
  fi
else
  echo "==> BIOS — OVMF not installed, so the UEFI path is not what is being tested"
  echo "    sudo xbps-install -y edk2-ovmf"
fi

if $disk_only; then
  echo "==> booting the installed disk"
  args+=(-boot c)
else
  echo "==> booting $(basename "$iso")"
  args+=(-cdrom "$iso" -boot d)
fi

exec qemu-system-x86_64 "${args[@]}"

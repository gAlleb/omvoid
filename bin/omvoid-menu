#!/bin/bash

# Rofi navigation over the existing omvoid commands. Actions remain usable alone.
set -uo pipefail

OMVOID_PATH="${OMVOID_PATH:-$HOME/.local/share/omvoid}"
SELF="$OMVOID_PATH/bin/omvoid-menu"
export PATH="$OMVOID_PATH/bin:$PATH"

# These are menu adapters, not replacements for the existing CLI helpers.
if [[ ${1:-} == --install-tool ]]; then
  shift
  package=${1:?Package required}
  omvoid-mise-install "$@" || exit $?
  MISE_MINIMUM_RELEASE_AGE=0 mise use -g "$package"
  exit $?
fi

if [[ ${1:-} == --run ]]; then
  shift
  "$@"
  result=$?
  if ((result == 0)); then
    printf '\nDone.\n'
  else
    printf '\nCommand failed (exit code %s). See details above.\n' "$result"
  fi
  read -r -p 'Press Enter to close…' _ || true
  exit "$result"
fi

case ${1:-} in
  -h|--help)
    echo 'Usage: omvoid-menu [install|appearance|update|help|manage|tools]'
    exit 0 ;;
  ''|install|appearance|update|help|manage|tools) section=${1:-root} ;;
  *) echo "Unknown section: $1" >&2; exit 2 ;;
esac

command -v rofi >/dev/null || { echo 'This menu requires rofi.' >&2; exit 1; }
theme="$OMVOID_PATH/default/rofi/omvoid-menu.rasi"

dialog() {
  rofi -dmenu -i -no-custom -format i -theme "$theme" "$@"
}

pick() {
  local title=$1 index
  shift
  index=$(printf '%s\n' "$@" | dialog -p "$title" -mesg 'Enter — select · Esc — back') || return 1
  [[ $index =~ ^[0-9]+$ ]] && ((index < $#)) || return 1
  printf '%s' "$index"
}

error() { rofi -e "$*" -theme "$theme"; }

terminal() {
  # The system ships Alacritty; its launcher supports the TUI.float window rule.
  TERMINAL=alacritty omvoid-launch-tui "$SELF" --run "$@" || {
    error 'Could not run the action in a terminal.'
    return 1
  }
  exit 0
}

appimages() {
  local choice catalogue id label kind state index selected confirm
  local -a ids=() labels=() missing_ids=() missing_labels=() rows=() chosen=() names=()
  while true; do
    ids=() labels=() missing_ids=() missing_labels=() rows=() chosen=() names=()
    choice=$(pick 'Install → AppImage' 'Select applications…' 'Install all missing…' '← Back') || return
    [[ $choice == 2 ]] && return
    catalogue=$(omvoid-fetch-appimages --list) || { error 'Could not read the AppImage catalogue.'; return; }
    while IFS=$'\t' read -r id label kind state; do
      [[ -n $id ]] || continue
      [[ $kind == build ]] && label+=' — builds from source'
      ids+=("$id")
      labels+=("$label")
      if [[ $state == installed ]]; then
        rows+=("$label — installed")
      else
        rows+=("$label")
        missing_ids+=("$id")
        missing_labels+=("$label")
      fi
    done <<<"$catalogue"
    ((${#ids[@]})) || { error 'The AppImage catalogue is empty.'; return; }

    if [[ $choice == 1 ]]; then
      chosen=("${missing_ids[@]}")
      names=("${missing_labels[@]}")
    else
      selected=$(printf '%s\n' "${rows[@]}" | dialog -p 'AppImage' -multi-select \
        -kb-accept-custom 'Control+Return' -kb-accept-alt 'Shift+Return' \
        -mesg 'Shift+Enter — mark multiple · Enter — continue · Esc — back') || continue
      while IFS= read -r index; do
        [[ $index =~ ^[0-9]+$ ]] && ((index < ${#ids[@]})) || continue
        chosen+=("${ids[index]}")
        names+=("${labels[index]}")
      done <<<"$selected"
    fi
    ((${#chosen[@]})) || { error 'No applications to install.'; return; }
    confirm=$(printf '%s\n' 'Install' '← Back' | dialog -p 'Install applications?' \
      -mesg "$(printf '%s\n' "${names[@]}")") || continue
    [[ $confirm == 0 ]] && terminal omvoid-fetch-appimages "${chosen[@]}"
  done
}

select_setting() {
  local title=$1 list_command=$2 apply_command=$3 output index
  local -a values=()
  output=$("$list_command") || { error "Could not retrieve the list: $title"; return; }
  [[ -n $output ]] || { error "The list is empty: $title"; return; }
  mapfile -t values <<<"$output"
  index=$(pick "$title" "${values[@]}" '← Back') || return
  ((index < ${#values[@]})) || return
  terminal "$apply_command" "${values[index]}"
}

tools_catalogue() {
  # Read literal declarations only; never source the system installation step.
  local verb package command binary extra
  while read -r verb package command binary extra; do
    [[ $verb == omvoid-mise-install && -n $package && -z $extra ]] || continue
    [[ $package =~ ^[a-zA-Z0-9_@:+./-]+$ ]] || continue
    if [[ -z $command ]]; then
      command=${package##*:}
      command=${command##*/}
      command=${command%%@*}
    fi
    printf '%s\t%s\t%s\n' "$command" "$package" "${binary:-$command}"
  done < "$OMVOID_PATH/install/development/mise.sh"
}

install_tools() {
  local command package binary index action
  local -a commands=() packages=() binaries=() rows=()
  while IFS=$'\t' read -r command package binary; do
    commands+=("$command") packages+=("$package") binaries+=("$binary")
    rows+=("$command — $package")
  done < <(tools_catalogue)
  ((${#rows[@]})) || { error 'No tools found in the catalogue.'; return; }
  index=$(pick 'Tools and agents' "${rows[@]}" '← Back') || return
  ((index < ${#rows[@]})) || return
  action=$(pick "${commands[index]}" 'Install now' '← Back') || return
  case $action in
    0) terminal "$SELF" --install-tool "${packages[index]}" "${commands[index]}" "${binaries[index]}" ;;
  esac
}

remove_tool() {
  local file index action
  local -a commands=()
  for file in "${OMVOID_STUB_DIR:-$HOME/.local/bin}"/*; do
    [[ -f $file ]] || continue
    command grep -q '^# omvoid-mise-stub ' "$file" && commands+=("${file##*/}")
  done
  ((${#commands[@]})) || { error 'No commands added by omvoid-mise-install.'; return; }
  index=$(pick 'Remove tool' "${commands[@]}" '← Back') || return
  ((index < ${#commands[@]})) || return
  action=$(pick "Remove ${commands[index]}?" '← Back' 'Remove command only' 'Remove command and downloaded tool') || return
  case $action in
    1) terminal omvoid-mise-uninstall "${commands[index]}" ;;
    2) terminal omvoid-mise-uninstall --purge "${commands[index]}" ;;
  esac
}

confirm_action() {
  local title=$1 index
  shift
  index=$(pick "$title" '← Back' 'Continue') || return
  [[ $index == 1 ]] && terminal "$@"
}

while true; do
  case $section in
    root)
      choice=$(pick 'OMVOID' 'Applications' 'Appearance' 'Updates' 'Help' 'Controls' 'Tools') || exit 0
      case $choice in
        0) section=install ;; 1) section=appearance ;; 2) section=update ;; 3) section=help ;;
        4) section=manage ;; 5) section=tools ;;
      esac ;;
    install)
      choice=$(pick 'OMVOID → Applications' 'Install AppImage…' 'Add web application…' 'Add TUI shortcut…' 'Tools and agents…' 'Hermes…' 'Remove…' '← Back') || { section=root; continue; }
      case $choice in
        0) appimages ;;
        1) terminal omvoid-webapp-install ;;
        2) terminal omvoid-tui-install ;;
        3) install_tools ;;
        4) section=hermes ;;
        5) section=remove ;;
        6) section=root ;;
      esac ;;
    hermes)
      choice=$(pick 'Applications → Hermes' 'Install CLI from PyPI' 'Official installer — CLI and Desktop' 'Remove CLI from PyPI…' 'Remove official installation…' '← Back') || { section=install; continue; }
      case $choice in
        0) terminal omvoid-install-hermes-cli --now ;;
        1) terminal omvoid-install-hermes ;;
        2) confirm_action 'Remove Hermes CLI from PyPI?' omvoid-install-hermes-cli --remove ;;
        3) confirm_action 'Remove Hermes? The installer will ask separately about your data.' omvoid-install-hermes --remove ;;
        4) section=install ;;
      esac ;;
    remove)
      choice=$(pick 'Applications → Remove' 'Web application…' 'TUI shortcuts…' 'mise tool…' '← Back') || { section=install; continue; }
      case $choice in
        0) terminal omvoid-webapp-remove ;;
        1) terminal omvoid-tui-remove ;;
        2) remove_tool ;;
        3) section=install ;;
      esac ;;
    appearance)
      choice=$(pick 'OMVOID → Appearance' 'Theme…' 'Wallpaper…' 'Light / dark mode…' 'Font…' 'Next theme' 'Next wallpaper in current theme' 'Current theme' 'Current font' '← Back') || { section=root; continue; }
      case $choice in
        0) select_setting 'Theme' omvoid-theme-list omvoid-theme-set ;;
        1) "$HOME/.config/rofi/wallpaper/wallpaper-wayland.sh" || error 'Could not select a wallpaper.' ;;
        2) "$HOME/.config/rofi/wallpaper/wallpaper-switch-theme-wayland.sh" || error 'Could not change the mode.' ;;
        3) select_setting 'Font' omvoid-font-list omvoid-font-set ;;
        4) terminal omvoid-theme-next ;;
        5) terminal omvoid-theme-bg-next ;;
        6) terminal omvoid-theme-current ;;
        7) terminal omvoid-font-current ;;
        8) section=root ;;
      esac ;;
    update)
      choice=$(pick 'OMVOID → Updates' 'Update system and omvoid…' 'Update mise tools…' 'Refresh application shortcuts' 'Pending migrations' 'Refresh agent skill links' 'Refresh agent usage data' '← Back') || { section=root; continue; }
      case $choice in
        0) terminal omvoid-update ;;
        1) terminal omvoid-update-mise ;;
        2) terminal omvoid-refresh-applications ;;
        3) terminal omvoid-migrate --pending ;;
        4) terminal omvoid-link-skills ;;
        5) terminal omvoid-agent-usage-update ;;
        6) section=root ;;
      esac ;;
    help)
      choice=$(pick 'OMVOID → Help' 'Keybindings' 'Manual' 'mise tools — list and status' '← Back') || { section=root; continue; }
      case $choice in
        0) omvoid-menu-keybindings ;;
        1) terminal less "$OMVOID_PATH/doc/MANUAL.md" ;;
        2) terminal omvoid-mise-list ;;
        3) section=root ;;
      esac ;;
    manage)
      choice=$(pick 'OMVOID → Controls' 'Audio output device…' 'Select and launch agent…' 'Reload Waybar configuration' 'Reload mango configuration' 'Edit mango configuration' 'Mihomo…' '← Back') || { section=root; continue; }
      case $choice in
        0) omvoid-audioswitcher ;;
        1) exec omvoid-launch-agent --set ;;
        2) terminal omvoid-reload-waybar ;;
        3) terminal mmsg dispatch reload_config ;;
        4) exec omvoid-launch-editor "$HOME/.config/mango/config.conf" ;;
        5) terminal omvoid-cmd-mihomo ;;
        6) section=root ;;
      esac ;;
    tools)
      choice=$(pick 'OMVOID → Tools' 'Connect via SSH…' 'Radio…' 'Screen recording…' '← Back') || { section=root; continue; }
      case $choice in
        0) exec omvoid-cmd-ssh-launcher ;;
        1) exec omvoid-cmd-radio ;;
        2) section=record ;;
        3) section=root ;;
      esac ;;
    record)
      if pgrep -x wf-recorder >/dev/null || pgrep -x wl-screenrec >/dev/null; then
        choice=$(pick 'Screen recording' 'Stop recording' '← Back') || { section=tools; continue; }
        case $choice in
          0) exec omvoid-cmd-screenrecord ;;
          1) section=tools ;;
        esac
      else
        choice=$(pick 'Screen recording' 'Region without audio…' 'Region with audio…' 'Screen without audio' 'Screen with audio' '← Back') || { section=tools; continue; }
        case $choice in
          0) exec omvoid-cmd-screenrecord region ;;
          1) exec omvoid-cmd-screenrecord region audio ;;
          2) exec omvoid-cmd-screenrecord output ;;
          3) exec omvoid-cmd-screenrecord output audio ;;
          4) section=tools ;;
        esac
      fi ;;
  esac
done

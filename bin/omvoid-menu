#!/bin/bash

# Rofi navigation over the existing omvoid commands. Actions remain usable alone.
set -uo pipefail

OMVOID_PATH="${OMVOID_PATH:-$HOME/.local/share/omvoid}"
SELF="$OMVOID_PATH/bin/omvoid-menu"
export PATH="$OMVOID_PATH/bin:$PATH"

# These are menu adapters, not replacements for the existing CLI helpers.
if [[ ${1:-} == --install-tool ]]; then
  shift
  package=${1:?Package required}
  omvoid-mise-install "$@" || exit $?
  MISE_MINIMUM_RELEASE_AGE=0 mise use -g "$package"
  exit $?
fi

if [[ ${1:-} == --run ]]; then
  shift
  "$@"
  result=$?
  if ((result == 0)); then
    printf '\nГотово.\n'
  else
    printf '\nКоманда завершилась с ошибкой (код %s). Подробности выше.\n' "$result"
  fi
  read -r -p 'Enter — закрыть окно…' _ || true
  exit "$result"
fi

case ${1:-} in
  -h|--help)
    echo 'Usage: omvoid-menu [install|appearance|update|help|manage|tools]'
    exit 0 ;;
  ''|install|appearance|update|help|manage|tools) section=${1:-root} ;;
  *) echo "Неизвестный раздел: $1" >&2; exit 2 ;;
esac

command -v rofi >/dev/null || { echo 'Для меню нужен rofi.' >&2; exit 1; }
theme="$OMVOID_PATH/default/rofi/omvoid-menu.rasi"

dialog() {
  rofi -dmenu -i -no-custom -format i -theme "$theme" "$@"
}

pick() {
  local title=$1 index
  shift
  index=$(printf '%s\n' "$@" | dialog -p "$title" -mesg 'Enter — выбрать · Esc — назад') || return 1
  [[ $index =~ ^[0-9]+$ ]] && ((index < $#)) || return 1
  printf '%s' "$index"
}

error() { rofi -e "$*" -theme "$theme"; }

terminal() {
  # The system ships Alacritty; its launcher supports the TUI.float window rule.
  TERMINAL=alacritty omvoid-launch-tui "$SELF" --run "$@" || {
    error 'Не удалось выполнить действие в терминале.'
    return 1
  }
  exit 0
}

appimages() {
  local choice catalogue id label kind state index selected confirm
  local -a ids=() labels=() missing_ids=() missing_labels=() rows=() chosen=() names=()
  while true; do
    ids=() labels=() missing_ids=() missing_labels=() rows=() chosen=() names=()
    choice=$(pick 'Установить → AppImage' 'Выбрать приложения…' 'Установить все недостающие…' '← Назад') || return
    [[ $choice == 2 ]] && return
    catalogue=$(omvoid-fetch-appimages --list) || { error 'Не удалось прочитать каталог AppImage.'; return; }
    while IFS=$'\t' read -r id label kind state; do
      [[ -n $id ]] || continue
      [[ $kind == build ]] && label+=' — сборка из исходников'
      ids+=("$id")
      labels+=("$label")
      if [[ $state == installed ]]; then
        rows+=("$label — установлено")
      else
        rows+=("$label")
        missing_ids+=("$id")
        missing_labels+=("$label")
      fi
    done <<<"$catalogue"
    ((${#ids[@]})) || { error 'Каталог AppImage пуст.'; return; }

    if [[ $choice == 1 ]]; then
      chosen=("${missing_ids[@]}")
      names=("${missing_labels[@]}")
    else
      selected=$(printf '%s\n' "${rows[@]}" | dialog -p 'AppImage' -multi-select \
        -kb-accept-custom 'Control+Return' -kb-accept-alt 'Shift+Return' \
        -mesg 'Shift+Enter — отметить несколько · Enter — продолжить · Esc — назад') || continue
      while IFS= read -r index; do
        [[ $index =~ ^[0-9]+$ ]] && ((index < ${#ids[@]})) || continue
        chosen+=("${ids[index]}")
        names+=("${labels[index]}")
      done <<<"$selected"
    fi
    ((${#chosen[@]})) || { error 'Нет приложений для установки.'; return; }
    confirm=$(printf '%s\n' 'Установить' '← Назад' | dialog -p 'Установить приложения?' \
      -mesg "$(printf '%s\n' "${names[@]}")") || continue
    [[ $confirm == 0 ]] && terminal omvoid-fetch-appimages "${chosen[@]}"
  done
}

select_setting() {
  local title=$1 list_command=$2 apply_command=$3 output index
  local -a values=()
  output=$("$list_command") || { error "Не удалось получить список: $title"; return; }
  [[ -n $output ]] || { error "Список пуст: $title"; return; }
  mapfile -t values <<<"$output"
  index=$(pick "$title" "${values[@]}" '← Назад') || return
  ((index < ${#values[@]})) || return
  terminal "$apply_command" "${values[index]}"
}

tools_catalogue() {
  # Read literal declarations only; never source the system installation step.
  local verb package command binary extra
  while read -r verb package command binary extra; do
    [[ $verb == omvoid-mise-install && -n $package && -z $extra ]] || continue
    [[ $package =~ ^[a-zA-Z0-9_@:+./-]+$ ]] || continue
    if [[ -z $command ]]; then
      command=${package##*:}
      command=${command##*/}
      command=${command%%@*}
    fi
    printf '%s\t%s\t%s\n' "$command" "$package" "${binary:-$command}"
  done < "$OMVOID_PATH/install/development/mise.sh"
}

install_tools() {
  local command package binary index action
  local -a commands=() packages=() binaries=() rows=()
  while IFS=$'\t' read -r command package binary; do
    commands+=("$command") packages+=("$package") binaries+=("$binary")
    rows+=("$command — $package")
  done < <(tools_catalogue)
  ((${#rows[@]})) || { error 'Не найден список инструментов.'; return; }
  index=$(pick 'Инструменты и агенты' "${rows[@]}" '← Назад') || return
  ((index < ${#rows[@]})) || return
  action=$(pick "${commands[index]}" 'Установить сейчас' '← Назад') || return
  case $action in
    0) terminal "$SELF" --install-tool "${packages[index]}" "${commands[index]}" "${binaries[index]}" ;;
  esac
}

remove_tool() {
  local file index action
  local -a commands=()
  for file in "${OMVOID_STUB_DIR:-$HOME/.local/bin}"/*; do
    [[ -f $file ]] || continue
    command grep -q '^# omvoid-mise-stub ' "$file" && commands+=("${file##*/}")
  done
  ((${#commands[@]})) || { error 'Нет команд, добавленных через omvoid-mise-install.'; return; }
  index=$(pick 'Удалить инструмент' "${commands[@]}" '← Назад') || return
  ((index < ${#commands[@]})) || return
  action=$(pick "Удалить ${commands[index]}?" '← Назад' 'Удалить только команду' 'Удалить команду и скачанный инструмент') || return
  case $action in
    1) terminal omvoid-mise-uninstall "${commands[index]}" ;;
    2) terminal omvoid-mise-uninstall --purge "${commands[index]}" ;;
  esac
}

confirm_action() {
  local title=$1 index
  shift
  index=$(pick "$title" '← Назад' 'Продолжить') || return
  [[ $index == 1 ]] && terminal "$@"
}

while true; do
  case $section in
    root)
      choice=$(pick 'OMVOID' 'Приложения' 'Оформление' 'Обновление' 'Справка' 'Управление' 'Инструменты') || exit 0
      case $choice in
        0) section=install ;; 1) section=appearance ;; 2) section=update ;; 3) section=help ;;
        4) section=manage ;; 5) section=tools ;;
      esac ;;
    install)
      choice=$(pick 'OMVOID → Приложения' 'Установить AppImage…' 'Добавить веб-приложение…' 'Добавить ярлык TUI…' 'Инструменты и агенты…' 'Hermes…' 'Удалить…' '← Назад') || { section=root; continue; }
      case $choice in
        0) appimages ;;
        1) terminal omvoid-webapp-install ;;
        2) terminal omvoid-tui-install ;;
        3) install_tools ;;
        4) section=hermes ;;
        5) section=remove ;;
        6) section=root ;;
      esac ;;
    hermes)
      choice=$(pick 'Приложения → Hermes' 'Установить CLI из PyPI' 'Официальный установщик — CLI и Desktop' 'Удалить CLI из PyPI…' 'Удалить официальную установку…' '← Назад') || { section=install; continue; }
      case $choice in
        0) terminal omvoid-install-hermes-cli --now ;;
        1) terminal omvoid-install-hermes ;;
        2) confirm_action 'Удалить Hermes CLI из PyPI?' omvoid-install-hermes-cli --remove ;;
        3) confirm_action 'Удалить Hermes? О данных установщик спросит отдельно.' omvoid-install-hermes --remove ;;
        4) section=install ;;
      esac ;;
    remove)
      choice=$(pick 'Приложения → Удалить' 'Веб-приложение…' 'Ярлыки TUI…' 'Инструмент mise…' '← Назад') || { section=install; continue; }
      case $choice in
        0) terminal omvoid-webapp-remove ;;
        1) terminal omvoid-tui-remove ;;
        2) remove_tool ;;
        3) section=install ;;
      esac ;;
    appearance)
      choice=$(pick 'OMVOID → Оформление' 'Тема…' 'Обои…' 'Светлый / тёмный режим…' 'Шрифт…' 'Следующая тема' 'Следующие обои текущей темы' 'Текущая тема' 'Текущий шрифт' '← Назад') || { section=root; continue; }
      case $choice in
        0) select_setting 'Тема' omvoid-theme-list omvoid-theme-set ;;
        1) "$HOME/.config/rofi/wallpaper/wallpaper-wayland.sh" || error 'Не удалось выбрать обои.' ;;
        2) "$HOME/.config/rofi/wallpaper/wallpaper-switch-theme-wayland.sh" || error 'Не удалось изменить режим.' ;;
        3) select_setting 'Шрифт' omvoid-font-list omvoid-font-set ;;
        4) terminal omvoid-theme-next ;;
        5) terminal omvoid-theme-bg-next ;;
        6) terminal omvoid-theme-current ;;
        7) terminal omvoid-font-current ;;
        8) section=root ;;
      esac ;;
    update)
      choice=$(pick 'OMVOID → Обновление' 'Обновить систему и omvoid…' 'Обновить инструменты mise…' 'Обновить ярлыки приложений' 'Ожидающие миграции' 'Обновить ссылки на скиллы агентов' 'Обновить данные расхода агентов' '← Назад') || { section=root; continue; }
      case $choice in
        0) terminal omvoid-update ;;
        1) terminal omvoid-update-mise ;;
        2) terminal omvoid-refresh-applications ;;
        3) terminal omvoid-migrate --pending ;;
        4) terminal omvoid-link-skills ;;
        5) terminal omvoid-agent-usage-update ;;
        6) section=root ;;
      esac ;;
    help)
      choice=$(pick 'OMVOID → Справка' 'Горячие клавиши' 'Руководство' 'Инструменты mise — список и состояние' '← Назад') || { section=root; continue; }
      case $choice in
        0) omvoid-menu-keybindings ;;
        1) terminal less "$OMVOID_PATH/doc/MANUAL.md" ;;
        2) terminal omvoid-mise-list ;;
        3) section=root ;;
      esac ;;
    manage)
      choice=$(pick 'OMVOID → Управление' 'Устройство вывода звука…' 'Выбрать и запустить агента…' 'Перечитать конфигурацию Waybar' 'Перечитать конфигурацию mango' 'Открыть конфигурацию mango' 'Mihomo…' '← Назад') || { section=root; continue; }
      case $choice in
        0) omvoid-audioswitcher ;;
        1) exec omvoid-launch-agent --set ;;
        2) terminal omvoid-reload-waybar ;;
        3) terminal mmsg dispatch reload_config ;;
        4) exec omvoid-launch-editor "$HOME/.config/mango/config.conf" ;;
        5) terminal omvoid-cmd-mihomo ;;
        6) section=root ;;
      esac ;;
    tools)
      choice=$(pick 'OMVOID → Инструменты' 'Подключиться по SSH…' 'Радио…' 'Запись экрана…' '← Назад') || { section=root; continue; }
      case $choice in
        0) exec omvoid-cmd-ssh-launcher ;;
        1) exec omvoid-cmd-radio ;;
        2) section=record ;;
        3) section=root ;;
      esac ;;
    record)
      if pgrep -x wf-recorder >/dev/null || pgrep -x wl-screenrec >/dev/null; then
        choice=$(pick 'Запись экрана' 'Остановить запись' '← Назад') || { section=tools; continue; }
        case $choice in
          0) exec omvoid-cmd-screenrecord ;;
          1) section=tools ;;
        esac
      else
        choice=$(pick 'Запись экрана' 'Область без звука…' 'Область со звуком…' 'Экран без звука' 'Экран со звуком' '← Назад') || { section=tools; continue; }
        case $choice in
          0) exec omvoid-cmd-screenrecord region ;;
          1) exec omvoid-cmd-screenrecord region audio ;;
          2) exec omvoid-cmd-screenrecord output ;;
          3) exec omvoid-cmd-screenrecord output audio ;;
          4) section=tools ;;
        esac
      fi ;;
  esac
done

#!/bin/bash

# Switch to a curated theme by name.
#
#   omvoid-theme-set rain-world
#   omvoid-theme-set "Rain World"      as omvoid-theme-list prints them
#
# The palette comes from the theme's colors.json; everything that has to be
# reloaded afterwards is omvoid-theme-apply's job.

set -uo pipefail

THEMES_DIR="$HOME/.config/omvoid/themes"
CURRENT_THEME_DIR="$HOME/.config/omvoid/current/theme"

# A rofi menu passes CNCLD when the user dismisses it. The old condition meant
# to catch that but tested it against an empty argument, which can never equal
# it — so cancelling produced a "theme does not exist" error instead of silence.
[[ ${1:-} == "CNCLD" ]] && exit 0

if [[ -z ${1:-} ]]; then
  echo "Usage: omvoid-theme-set <theme-name>" >&2
  exit 1
fi

# omvoid-theme-list prints display names ("Rain World"), and a rofi entry may
# carry pango markup. Normalise back to the directory name.
THEME_NAME=$(echo "$1" | sed -E 's/<[^>]+>//g' | tr '[:upper:]' '[:lower:]' | tr ' ' '-')
THEME_PATH="$THEMES_DIR/$THEME_NAME"

if [[ ! -d $THEME_PATH ]]; then
  echo "Theme '$THEME_NAME' does not exist in $THEMES_DIR" >&2
  exit 2
fi

ln -nsf "$THEME_PATH" "$CURRENT_THEME_DIR"

# No argument: mode and icon theme are read from the theme itself.
omvoid-theme-gnome-set

omvoid-theme-apply --theme "$CURRENT_THEME_DIR/colors.json" || exit $?

# The background is picked separately: a theme ships several, and this steps
# through them rather than always taking the first.
omvoid-theme-bg-next

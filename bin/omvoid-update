#!/bin/bash

# Обновляет omvoid и систему целиком.
#
# Нужен потому, что просто git pull ничего не меняет: config/ попадает в
# ~/.config копированием, а повторный install.sh конфиги не перекопирует --
# у шага config/config.sh стоит маркер. До этого скрипта обновление второй
# машины делалось руками и по памяти.
#
#   omvoid-update      спрашивает перед заменой изменённых конфигов
#   omvoid-update -y   ничего не спрашивает

set -euo pipefail

OMVOID_PATH="${OMVOID_PATH:-$HOME/.local/share/omvoid}"
assume_yes=false
[[ ${1:-} == "-y" ]] && assume_yes=true

step() { echo -e "\n\e[32m==> $1\e[0m"; }

confirm() {
  $assume_yes && return 0
  # Без терминала спрашивать некого и нечем: gum там падает, а read сразу видит
  # конец ввода. Молча отвечаем "нет" -- ничего не менять безопаснее.
  if [[ ! -t 0 ]]; then
    echo "нет терминала для вопроса -- пропускаю" >&2
    return 1
  fi
  if command -v gum >/dev/null; then
    gum confirm "$1"
  else
    read -rp "$1 [y/N] " answer
    [[ $answer == [yY]* ]]
  fi
}

cd "$OMVOID_PATH"

# --- репозиторий -------------------------------------------------------------
step "Репозиторий"
if [[ -n $(git status --porcelain) ]]; then
  # Незакоммиченные правки -- обычное состояние машины, на которой этот
  # дистрибутив и разрабатывается. Затирать их через pull нельзя.
  dirty=$(git status --short)
  echo "есть незакоммиченные изменения ($(wc -l <<<"$dirty") шт.), git pull пропускаю:"
  head -8 <<<"$dirty" | sed 's/^/  /'
  (($(wc -l <<<"$dirty") > 8)) && echo "  ... и ещё $(($(wc -l <<<"$dirty") - 8))"
else
  git pull --ff-only
fi

# --- системные пакеты --------------------------------------------------------
step "Системные пакеты"
# Полное обновление системы -- не то, что стоит делать за человека молча,
# особенно на чужой машине: оно может занять полчаса и притащить новое ядро.
# Под -y идём без вопроса: это и есть смысл неинтерактивного режима.
if confirm "Обновить системные пакеты (xbps-install -Su)?"; then
  # xbps обновляется первым: устаревший менеджер иначе падает посреди синхронизации.
  sudo xbps-install -Suy xbps
  sudo xbps-install -Suy
else
  echo "пропущено"
fi

# --- конфиги -----------------------------------------------------------------
step "Конфиги"

# Единственное место, где объявлено, чего синхронизация не касается. Всё
# остальное разбирается само по записи о развёрнутом: если файл переписала
# программа или человек, а репозиторий его не трогал, это видно как правка
# пользователя, и в список он не попадает.
#
# Раньше здесь перечислялись девятнадцать путей -- файлы, которые правит
# omvoid-font-set, состояние crystal-dock и lazy.nvim, autostart.conf,
# rclone.conf. Все они опознаются автоматически, а перечисление ещё и прятало
# бы настоящие изменения этих файлов в репозитории.
#
# Путь передаётся относительно репозитория, как везде в этом обходе.
is_runtime_owned() {
  # Шаблоны с подстановкой при установке: копировать их как есть нельзя ни в
  # какую сторону, кто бы их ни менял. По содержимому, а не по списку -- тогда
  # новый шаблон покрыт сам собой.
  grep -q '__USERNAME__' "$OMVOID_PATH/$1" 2>/dev/null && return 0

  # Машинное по замыслу, а не потому, что кто-то переписывает. Геометрия и
  # масштаб принадлежат конкретному ноутбуку; ошибка здесь означала бы чужое
  # разрешение на чужом экране, и полагаться на вывод не стоит.
  case "$1" in
  config/mango/conf/monitors.conf | config/hypr/config/monitors.conf) return 0 ;;
  esac

  return 1
}

mapfile -t candidates < <(
  cd "$OMVOID_PATH"
  find config -type f -printf '%p\n'
  find applications -maxdepth 1 -name '*.desktop' -printf '%p\n'
  find applications/icons -type f -printf '%p\n' 2>/dev/null
  find install/apps/files -type f -printf '%p\n' 2>/dev/null
  for f in default/.bashrc default/.bash_profile default/.gtkrc-2.0; do
    [[ -f $f ]] && printf '%s\n' "$f"
  done
  find default/gnupg -type f -printf '%p\n' 2>/dev/null
)

# Манифест: что было развёрнуто в прошлый раз. Читаем один раз в память --
# спрашивать по файлу означало бы триста запусков подпроцесса.
# Формат строки как у sha256sum: 64 знака, два пробела, путь с 67-го символа.
declare -A recorded=()
MANIFEST="${XDG_STATE_HOME:-$HOME/.local/state}/omvoid/deployed.sha256"

if [[ -f $MANIFEST ]]; then
  while IFS= read -r line; do
    [[ ${#line} -gt 66 ]] || continue
    recorded["${line:66}"]="${line:0:64}"
  done <"$MANIFEST"
fi

declare -A why=()
diverged=()
for rel in "${candidates[@]}"; do
  target=$(omvoid-refresh-config --where "$rel")
  [[ -n $target ]] || continue

  # Отсутствие файла проверяется ДО исключений. Исключение означает "не
  # перезаписывать то, чем владеет система", а не "никогда не устанавливать":
  # на машине, где файла ещё нет, владеть нечем. Иначе новый rofi/*.rasi или
  # mako/config не приехали бы никогда, потому что подпадают под правило про
  # файлы, которые правит omvoid-font-set.
  if [[ ! -f $target ]]; then
    why[$rel]="нет на машине"
    diverged+=("$rel")
    continue
  fi

  is_runtime_owned "$rel" && continue

  cmp -s "$OMVOID_PATH/$rel" "$target" && continue

  # Файлы разошлись. Что именно произошло, показывает сравнение с исходным
  # состоянием из манифеста -- ровно три случая, и вести себя в них надо
  # по-разному.
  live_sum=$(sha256sum "$target" | cut -d' ' -f1)
  repo_sum=$(sha256sum "$OMVOID_PATH/$rel" | cut -d' ' -f1)
  base=${recorded[$rel]:-}

  if [[ -z $base ]]; then
    why[$rel]="исходное неизвестно"
  elif [[ $live_sum == "$base" ]]; then
    why[$rel]="репозиторий впереди"
  elif [[ $repo_sum == "$base" ]]; then
    # Живой файл правил пользователь, а репозиторий с тех пор не менялся.
    # Это его настройка, а не расхождение, которое надо чинить: не показываем.
    continue
  else
    why[$rel]="изменились обе стороны"
  fi
  diverged+=("$rel")
done

if ((${#diverged[@]} == 0)); then
  echo "все конфиги совпадают с репозиторием"
elif $assume_yes; then
  # Под -y ничего не заменяем, только показываем. Это режим для cron и для
  # второй машины "не глядя", а расхождение чаще всего означает ручную правку
  # живого файла -- стереть её без спроса хуже, чем не обновить конфиг.
  # Замена всегда остаётся осознанным выбором пофайлово.
  echo "расходятся с репозиторием (${#diverged[@]}), под -y не трогаю:"
  for rel in "${diverged[@]}"; do printf '  %-52s %s\n' "$rel" "${why[$rel]}"; done
  echo "заменить выборочно: omvoid-update без -y, либо omvoid-refresh-config <путь>"
else
  echo "расходятся с репозиторием (${#diverged[@]}):"
  for rel in "${diverged[@]}"; do printf '  %-52s %s\n' "$rel" "${why[$rel]}"; done
  # Выбор пофайлово, а не "заменить всё": часть расхождений -- это ручная
  # правка живого файла, которую заменять как раз не надо.
  # gum рисует список только в терминале. Под cron, по ssh без tty или в
  # конвейере он падает, поэтому запасной путь -- обычный список и один вопрос.
  if command -v gum >/dev/null && [[ -t 0 && -t 1 ]]; then
    mapfile -t chosen < <(gum choose --no-limit --height 20 \
      --header "Пробел -- отметить, Enter -- обновить отмеченные" \
      "${diverged[@]}" || true)
  else
    printf '  %s\n' "${diverged[@]}"
    chosen=()
    confirm "Заменить все версиями из репозитория?" && chosen=("${diverged[@]}")
  fi

  if ((${#chosen[@]})); then
    # Отказ по отдельному файлу не повод обрывать всё обновление: под set -e
    # ненулевой код здесь остановил бы и миграции, и обновление инструментов.
    omvoid-refresh-config "${chosen[@]}" ||
      echo "часть файлов пропущена, причина выше" >&2
  else
    echo "ничего не выбрано, пропускаю"
  fi
fi

# --- миграции ----------------------------------------------------------------
# После конфигов: миграция может рассчитывать на файл, который только что приехал.
step "Миграции"
omvoid-migrate

# --- инструменты -------------------------------------------------------------
if command -v mise >/dev/null; then
  step "Инструменты mise"
  omvoid-update-mise
fi

step "Скиллы для агентов"
omvoid-link-skills

# --- перечитать конфиги ------------------------------------------------------
step "Перечитываем"
command -v mmsg >/dev/null && mmsg dispatch reload_config || true
pgrep -x waybar >/dev/null && omvoid-reload-waybar || true

# --- личные хуки -------------------------------------------------------------
omvoid-hook post-update

echo -e "\n\e[32mГотово.\e[0m"

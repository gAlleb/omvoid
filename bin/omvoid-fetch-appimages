#!/bin/bash

# Fetch AppImages and hand them to Gear Lever. The catalogue also feeds the menu.
# No arguments installs all missing apps; names select a subset; -n previews.
# --list prints tab-separated id, display name, source kind and installed status.

set -u

DOWNLOADS=$HOME/Downloads
BUILDDIR=$HOME/.cache/omvoid/appimages
APPIMAGETOOL=https://github.com/AppImage/appimagetool/releases/download/continuous/appimagetool-x86_64.AppImage

dry=false
[[ ${1:-} == -n ]] && { dry=true; shift; }

catalogue() {
  # IDs also match the beginning of the names reported by Gear Lever.
  cat <<'APPS'
obsidian|github|obsidianmd/obsidian-releases|Obsidian-[0-9.]+\.AppImage$|Obsidian
claude|github|aaddrick/claude-desktop-debian|amd64\.AppImage$|Claude Desktop
onlyoffice|github|ONLYOFFICE/DesktopEditors|DesktopEditors-x86_64\.AppImage$|ONLYOFFICE
vk|url|https://upload.object2.vk-apps.com/vk-me-desktop-dev-5837a06d-5f28-484a-ac22-045903cb1b1a/latest/vk-messenger.AppImage||VK Messenger
chatgpt|build|https://github.com/ilysenko/codex-desktop-linux||ChatGPT Community
APPS
}

say() { echo "  $*" >&2; }
bad() { echo "  не вышло: $*" >&2; failed=1; }

# Search recent assets: Obsidian's latest release may contain only Android builds.
github_url() {
  curl -sfL "https://api.github.com/repos/$1/releases?per_page=10" |
    jq -r --arg p "$2" '[.[].assets[] | select(.name | test($p))][0].browser_download_url // empty'
}

# Conditional downloads also handle direct URLs without a version in the name.
download() {
  local url=$1 file=$DOWNLOADS/${1##*/} newer_than=()

  [[ -n $url ]] || { bad "нет подходящего файла в релизах"; return 1; }
  say "${file##*/}"
  $dry && return 1
  [[ -f $file ]] && newer_than=(-z "$file")

  if curl -fL --progress-bar "${newer_than[@]}" -o "$file" "$url"; then
    chmod +x "$file"
    echo "$file"
  else
    bad "$url"
    return 1
  fi
}

# This community application requires a local build rather than a release download.
build() {
  local dir=$BUILDDIR/${1##*/} file

  say "сборка из исходников, это надолго"
  $dry && return 1

  if [[ -d $dir ]]; then
    git -C "$dir" pull --ff-only -q || { bad "git pull"; return 1; }
  else
    mkdir -p "$BUILDDIR"
    git clone -q --depth 1 "$1" "$dir" || { bad "git clone"; return 1; }
  fi

  command -v appimagetool >/dev/null || install_appimagetool || return 1
  (cd "$dir" && make build-app && make appimage) >&2 || { bad "make"; return 1; }

  file=$(ls -t "$dir"/dist/*.AppImage 2>/dev/null | head -1)
  [[ -n $file ]] || { bad "сборка прошла, а .AppImage не появился"; return 1; }

  cp -f "$file" "$DOWNLOADS/" && chmod +x "$DOWNLOADS/${file##*/}"
  echo "$DOWNLOADS/${file##*/}"
}

# Check execution as well as presence: appimagetool itself needs AppImage support.
install_appimagetool() {
  say "нет appimagetool, беру официальную сборку"
  mkdir -p "$HOME/.local/bin"
  curl -fL --progress-bar -o "$HOME/.local/bin/appimagetool" "$APPIMAGETOOL" ||
    { bad "не скачался appimagetool"; return 1; }
  chmod +x "$HOME/.local/bin/appimagetool"
  "$HOME/.local/bin/appimagetool" --version >/dev/null 2>&1 ||
    { bad "appimagetool не запускается"; return 1; }
}

# Existing integrations are preserved. Replacing one is a separate manual action:
# gearlever --integrate <file> --replace -y
installed() {
  command -v gearlever >/dev/null || return 1
  gearlever --list-installed 2>/dev/null | grep -qi "^$1"
}

if [[ ${1:-} == --list ]]; then
  while IFS='|' read -r name kind source pattern label; do
    state=missing
    installed "$name" && state=installed
    printf '%s\t%s\t%s\t%s\n' "$name" "$label" "$kind" "$state"
  done < <(catalogue)
  exit 0
fi

if [[ ${1:-} == --help || ${1:-} == -h ]]; then
  echo 'Usage: omvoid-fetch-appimages [-n] [app ...] | --list'
  exit 0
fi

# Reject typos before starting any downloads.
for requested in "$@"; do
  if ! catalogue | cut -d'|' -f1 | command grep -Fxq -- "$requested"; then
    say "неизвестное приложение: $requested (список: --list)"
    exit 2
  fi
done

$dry || mkdir -p "$DOWNLOADS" || exit 1
failed=0
while IFS='|' read -r name kind source pattern label; do
  [[ -z $name ]] && continue
  (($#)) && [[ " $* " != *" $name "* ]] && continue

  printf '\n%s\n' "$name" >&2

  # Gear Lever moves files out of Downloads, so check integrations first.
  if installed "$name"; then
    say "уже в Gear Lever, пропускаю"
    continue
  fi

  case $kind in
  github) file=$(download "$(github_url "$source" "$pattern")") || { $dry || failed=1; continue; } ;;
  url) file=$(download "$source") || { $dry || failed=1; continue; } ;;
  build) file=$(build "$source") || { $dry || failed=1; continue; } ;;
  esac
  [[ -n ${file:-} ]] || continue

  if command -v gearlever >/dev/null && gearlever --integrate "$file" -y >/dev/null 2>&1; then
    say "подключён в Gear Lever, переехал в ~/AppImages"
  else
    say "лежит в ${DOWNLOADS/#$HOME/\~}"
    bad "не подключён в Gear Lever"
  fi
done < <(catalogue)

exit $failed

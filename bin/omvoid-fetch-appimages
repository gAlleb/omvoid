#!/bin/bash

# Приносит в ~/Downloads AppImage'и, которых нет в репозиториях Void, и отдаёт
# их Gear Lever. Писано для свежей машины: поставил систему, запустил, забыл.
#
#   omvoid-fetch-appimages            все
#   omvoid-fetch-appimages obsidian   только названные
#   omvoid-fetch-appimages -n         сказать, что сделал бы, и выйти
#
# Новое приложение -- строка в таблице внизу:
#
#   github  владелец/репозиторий  шаблон имени файла в релизе
#   url     прямая ссылка
#   build   репозиторий, который надо собрать
#
# Имя в первой колонке -- и то, чем приложение называют в командной строке, и то,
# по чему его ищут в Gear Lever. Поэтому codex-desktop-linux записан как chatgpt:
# приложение зовёт себя ChatGPT Community, так его знает и Gear Lever.

set -u

DOWNLOADS=$HOME/Downloads
BUILDDIR=$HOME/.cache/omvoid/appimages
APPIMAGETOOL=https://github.com/AppImage/appimagetool/releases/download/continuous/appimagetool-x86_64.AppImage

dry=false
[[ ${1:-} == -n ]] && { dry=true; shift; }

say() { echo "  $*" >&2; }
bad() { echo "  не вышло: $*" >&2; failed=1; }

# Ссылка на самый свежий AppImage. Не releases/latest: у Obsidian последним
# релизом регулярно оказывается сборка под Android, где AppImage нет вовсе.
github_url() {
  curl -sfL "https://api.github.com/repos/$1/releases?per_page=10" |
    jq -r --arg p "$2" '[.[].assets[] | select(.name | test($p))][0].browser_download_url // empty'
}

# Качает в ~/Downloads и печатает путь. Имя файла несёт версию, поэтому
# существующий файл -- это она и есть; у прямых ссылок версии в имени нет, и там
# решает curl -z: заберёт, только если на сервере новее.
download() {
  local url=$1 file=$DOWNLOADS/${1##*/} newer_than=()

  [[ -n $url ]] || { bad "нет подходящего файла в релизах"; return 1; }
  say "${file##*/}"
  $dry && return 1
  [[ -f $file ]] && newer_than=(-z "$file")

  if curl -fL --progress-bar "${newer_than[@]}" -o "$file" "$url"; then
    chmod +x "$file"
    echo "$file"
  else
    bad "$url"
    return 1
  fi
}

# Codex готового AppImage не публикует, его собирают. Путь взят из README
# проекта -- для дистрибутивов, под которые они не делают родного пакета.
build() {
  local dir=$BUILDDIR/${1##*/} file

  say "сборка из исходников, это надолго"
  $dry && return 1

  if [[ -d $dir ]]; then
    git -C "$dir" pull --ff-only -q || { bad "git pull"; return 1; }
  else
    mkdir -p "$BUILDDIR"
    git clone -q --depth 1 "$1" "$dir" || { bad "git clone"; return 1; }
  fi

  command -v appimagetool >/dev/null || install_appimagetool || return 1
  (cd "$dir" && make build-app && make appimage) >&2 || { bad "make"; return 1; }

  file=$(ls -t "$dir"/dist/*.AppImage 2>/dev/null | head -1)
  [[ -n $file ]] || { bad "сборка прошла, а .AppImage не появился"; return 1; }

  cp -f "$file" "$DOWNLOADS/" && chmod +x "$DOWNLOADS/${file##*/}"
  echo "$DOWNLOADS/${file##*/}"
}

# Он и сам AppImage, и ему нужен fuse2 -- на omvoid тот есть, его тянет за собой
# ntfs-3g. Поэтому проверяем запуском, а не наличием файла.
install_appimagetool() {
  say "нет appimagetool, беру официальную сборку"
  mkdir -p "$HOME/.local/bin"
  curl -fL --progress-bar -o "$HOME/.local/bin/appimagetool" "$APPIMAGETOOL" ||
    { bad "не скачался appimagetool"; return 1; }
  chmod +x "$HOME/.local/bin/appimagetool"
  "$HOME/.local/bin/appimagetool" --version >/dev/null 2>&1 ||
    { bad "appimagetool не запускается"; return 1; }
}

# Новую версию поверх уже подключённой этот скрипт не ставит. gearlever --update
# умеет это только для приложений со своим апдейтером, а у большинства написано
# UpdatesNotAvailable; замена же руками -- дело на один раз и делается осознанно:
#
#   omvoid-fetch-appimages -n <имя>     посмотреть, какая версия сейчас на сайте
#   gearlever --integrate <файл> --replace -y
installed() {
  command -v gearlever >/dev/null || return 1
  gearlever --list-installed 2>/dev/null | grep -qi "^$1"
}

failed=0
while read -r name kind source pattern; do
  [[ -z $name ]] && continue
  (($#)) && [[ " $* " != *" $name "* ]] && continue

  printf '\n%s\n' "$name" >&2

  # Проверяется до скачивания, и это главное: Gear Lever уносит образ в
  # ~/AppImages, так что в Downloads его нет и "файл уже скачан" не сработает --
  # скрипт качал бы сотню мегабайт заново на каждом запуске.
  if installed "$name"; then
    say "уже в Gear Lever, пропускаю"
    continue
  fi

  case $kind in
  github) file=$(download "$(github_url "$source" "$pattern")") ;;
  url) file=$(download "$source") ;;
  build) file=$(build "$source") ;;
  esac
  [[ -n ${file:-} ]] || continue

  if command -v gearlever >/dev/null && gearlever --integrate "$file" -y >/dev/null 2>&1; then
    say "подключён в Gear Lever, переехал в ~/AppImages"
  else
    say "лежит в ${DOWNLOADS/#$HOME/\~}"
  fi
done <<'APPS'
obsidian   github obsidianmd/obsidian-releases    Obsidian-[0-9.]+\.AppImage$
claude     github aaddrick/claude-desktop-debian  amd64\.AppImage$
onlyoffice github ONLYOFFICE/DesktopEditors       DesktopEditors-x86_64\.AppImage$
vk         url    https://upload.object2.vk-apps.com/vk-me-desktop-dev-5837a06d-5f28-484a-ac22-045903cb1b1a/latest/vk-messenger.AppImage
chatgpt    build  https://github.com/ilysenko/codex-desktop-linux
APPS

exit $failed
